#!/bin/sh
#
# Pre-push gate (ToDo #36 residual) — runs the payroll integration gate suite plus the
# fast unit/composition tests before every push, so the kind of silent rot that left
# PayrollGateTests red for several phases can't slip through again.
#
# Scoped deliberately to the suites known-green and relevant here (PayrollGateTests +
# ResetBoundaryTests + PayrollModuleCompositionTests) rather than the whole project, so
# an unrelated suite with un-provisioned DB state can't block your pushes. Broaden the
# filter below if/when you want a wider gate.
#
# Requires the local dev DB (allworkhris_dev) to be running for the integration tests.
# Bypass for a WIP push or when the DB is down:   git push --no-verify
# Disable entirely:                               git config --unset core.hooksPath

set -e
ROOT="$(git rev-parse --show-toplevel)"
FILTER="FullyQualifiedName~PayrollGateTests|FullyQualifiedName~ResetBoundaryTests|FullyQualifiedName~PayrollModuleCompositionTests"

echo "[pre-push] Running payroll gate + unit tests ..."
if ! dotnet test "$ROOT/tests/AllWorkHRIS.Host.Tests" --filter "$FILTER" --nologo --verbosity quiet; then
  echo ""
  echo "[pre-push] Tests FAILED — push aborted."
  echo "           Fix them, or bypass with:  git push --no-verify"
  echo "           A failure here often means the dev DB drifted from the schema/seeds/fixtures"
  echo "           (apply pending migrations + re-run payroll_gate_test_fixture.sql — see ToDo #36/#37)."
  exit 1
fi

echo "[pre-push] Tests passed."
exit 0
