@using AllWorkHRIS.Core.Temporal
@using AllWorkHRIS.Module.Benefits.Repositories
@using Syncfusion.Blazor.Grids
@inject IBenefitElectionRepository BenefitElectionRepo
@inject ITemporalContext           TemporalContext

@if (_loading)
{
    <p class="loading-text">Loading…</p>
}
else if (_elections.Count == 0)
{
    <p class="placeholder-text">No active elections for this employee.</p>
}
else
{
    <SfGrid TValue="BenefitDeductionElection" DataSource="@_elections" AllowSorting="true" CssClass="e-gridhover">
        <GridColumns>
            <GridColumn HeaderText="Code" Width="130">
                <Template>@{ var e = (BenefitDeductionElection)context; }<samp>@e.DeductionCode</samp></Template>
            </GridColumn>
            <GridColumn HeaderText="Treatment" Width="130">
                <Template>@{ var e = (BenefitDeductionElection)context; }<span class="badge @(e.TaxTreatment == "PRE_TAX" ? "badge-blue" : "badge-orange")">@e.TaxTreatment</span></Template>
            </GridColumn>
            <GridColumn HeaderText="Emp Election" Width="130">
                <Template>@{ var e = (BenefitDeductionElection)context; }@EmpAmountDisplay(e)</Template>
            </GridColumn>
            <GridColumn HeaderText="ER Amount" Width="120">
                <Template>@{ var e = (BenefitDeductionElection)context; }@ErAmountDisplay(e)</Template>
            </GridColumn>
            <GridColumn HeaderText="Effective Start" Width="140">
                <Template>@{ var e = (BenefitDeductionElection)context; }@e.EffectiveStartDate.ToString("yyyy-MM-dd")</Template>
            </GridColumn>
            <GridColumn HeaderText="Effective End" Width="130">
                <Template>@{ var e = (BenefitDeductionElection)context; }@(e.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? "—")</Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="110">
                <Template>@{ var e = (BenefitDeductionElection)context; }<span class="badge badge-green">@e.Status</span></Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    [Parameter] public Guid EmploymentId { get; set; }

    private bool _loading = true;
    private List<BenefitDeductionElection> _elections = [];

    private static string EmpAmountDisplay(BenefitDeductionElection e) => e.CalculationMode switch
    {
        "COVERAGE_BASED"                    => e.CoverageTier ?? "—",
        _ when e.ContributionPct.HasValue   => $"{e.ContributionPct * 100:0.##}%",
        _                                   => e.EmployeeAmount.ToString("N2")
    };

    private static string ErAmountDisplay(BenefitDeductionElection e) =>
        e.EmployerContributionPct.HasValue
            ? $"{e.EmployerContributionPct * 100:0.##}%"
            : e.EmployerContributionAmount?.ToString("N2") ?? "—";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            var asOf = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
            _elections = (await BenefitElectionRepo.GetActiveByEmploymentIdAsync(EmploymentId, asOf)).ToList();
        }
        catch { }
        finally { _loading = false; }
    }
}
