    private static List<LookupEntry> DefaultFrequencies() =>
    [
        new LookupEntry { Id = 1, Code = "WEEKLY",       Label = "Weekly"       },
        new LookupEntry { Id = 2, Code = "BIWEEKLY",     Label = "Biweekly"     },
        new LookupEntry { Id = 3, Code = "SEMI_MONTHLY", Label = "Semi-Monthly" },
        new LookupEntry { Id = 4, Code = "MONTHLY",      Label = "Monthly"      },
        new LookupEntry { Id = 5, Code = "QUARTERLY",    Label = "Quarterly"    },
        new LookupEntry { Id = 6, Code = "ANNUAL",       Label = "Annual"       },
    ];

    // The OT config in force as-of the operative date, resolved from the dated rows (not the scalar
    // cache, which only re-syncs on save and goes stale once a scheduled change's effective date
    // passes). Falls back to the scalar cache if the dated history isn't loaded.
    private DatedOtConfigRow CurrentOtConfig()
    {
        var today = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
        var row = _otConfigHistory
            .Where(r => r.EffectiveDate <= today && (r.EndDate is null || r.EndDate >= today))
            .OrderByDescending(r => r.EffectiveDate)
            .FirstOrDefault();
        return row ?? new DatedOtConfigRow
        {
            EffectiveDate          = _context!.EffectiveStartDate,
            OtWeeklyThresholdHours = _context.OtWeeklyThresholdHours,
            WorkweekStartDay       = _context.WorkweekStartDay,
            OtReviewThresholdHours = _context.OtReviewThresholdHours
        };
    }

    // ADR-026 (D1): the FLSA workweek anchor IS the pay-period start day-of-week — it is derived from
    // the context's Effective Start Date, not configured independently. System.DayOfWeek (Sun=0..Sat=6)
    // matches the app's workweek_start_day convention. Displayed read-only; standalone anchor editing
    // is disabled until the calendar re-cut + transition machinery (ADR-026 D2–D4) is built.
    private int DerivedWorkweekStartDay => _context is null ? 1 : (int)_context.EffectiveStartDate.DayOfWeek;

    private void BeginEditSettings()
    {
        if (_context is null) return;
        // Prefill from the value in force NOW (resolved from the dated rows), so reopening Edit after
        // a scheduled change has taken effect shows the correct current value, not the stale cache.
        var cur                = CurrentOtConfig();
        _editOtThreshold       = cur.OtWeeklyThresholdHours;
        _editOtReviewThreshold = cur.OtReviewThresholdHours;
        // ADR-026: the anchor is NOT editable here — it is derived from the pay-period start day and
        // saved as-is, so an OT-config edit can never drift the workweek off the period boundary.
        _editWorkweekStartDay  = DerivedWorkweekStartDay;
        // Default the effective date forward-looking: the next workweek start on/after today, so a
        // routine edit takes effect at a clean week boundary (D7). The user can pick earlier for a
        // retroactive correction.
        var today              = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
        var ws                 = OvertimeSplitCalculator.GetWeekStart(today, _editWorkweekStartDay);
        _editEffectiveDate     = ws == today ? ws : ws.AddDays(7);
        _lastSavedEffectiveDate = null;   // drop any prior save confirmation while editing
        _settingsError        = null;
        _showEditSettings     = true;
    }

    private void CancelEditSettings()
    {
        _showEditSettings = false;
        _settingsError    = null;
    }

    private async Task SaveSettingsAsync()
    {
        if (_context is null) return;
        if (_editOtThreshold <= 0 || _editOtThreshold > 40)
        {
            _settingsError = "OT threshold must be between 0.01 and 40.00 hours.";
            return;
        }

        _submitting    = true;
        _settingsError = null;
        try
        {
            // Phase 12.13.3: write an effective-dated row (the repo snaps to a workweek boundary).
            var operativeToday = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
            _lastSavedEffectiveDate = await ContextRepo.SaveDatedOtConfigAsync(
                ContextId, _editOtThreshold, _editWorkweekStartDay, _editOtReviewThreshold,
                _editEffectiveDate, operativeToday, _currentUserId);

            // Reload the context (currently-effective cache) + the dated-row history inset.
            _context          = await ContextRepo.GetByIdAsync(ContextId);
            await LoadOtConfigHistoryAsync();
            _otConfigTimelineExpanded = true;   // reveal the timeline so the saved change is visible
            _showEditSettings = false;
        }
        catch (Exception ex) { _settingsError = ex.Message; }
        finally { _submitting = false; }
    }

    private static string WorkweekDayLabel(int day) => day switch
    {
        0 => "Sunday",
        1 => "Monday",
        2 => "Tuesday",
        3 => "Wednesday",
        4 => "Thursday",
        5 => "Friday",
        6 => "Saturday",
        _ => day.ToString()
    };

    private void BeginEditRunDate(PayrollPeriod p)
    {
        _editRunDatePeriodId = p.PeriodId;
        _editRunDateValue    = p.CalculationDate;
        _editRunDateError    = null;
    }

    private void CancelEditRunDate()
    {
        _editRunDatePeriodId = null;
        _editRunDateValue    = null;
        _editRunDateError    = null;
    }

    private async Task SaveRunDateAsync(Guid periodId)
    {
        _editRunDateSaving = true;
        _editRunDateError  = null;
        try
        {
            await ContextRepo.UpdatePeriodRunDateAsync(periodId, _editRunDateValue, _currentUserId);
            await LoadPeriodsAsync();
            CancelEditRunDate();
        }
        catch (Exception ex) { _editRunDateError = ex.Message; }
        finally { _editRunDateSaving = false; }
    }

