@page "/payroll/calendar/{ContextId:guid}"
@layout PayrollShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PayrollAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IPayrollContextRepository   ContextRepo
@inject IPayrollProfileRepository   ProfileRepo
@inject IAuditService               AuditService
@inject ILookupCache                LookupCache
@inject ITemporalContext            TemporalContext
@inject AuthenticationStateProvider AuthState
@inject NavigationManager           Nav
@inject IHrisSessionState           SessionState
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using AllWorkHRIS.Core.Domain.Time

<PageTitle>Pay Calendar Detail — AllWork HRIS</PageTitle>

<div class="page-container">

    @if (_loading)
    {
        <p class="loading-state">Loading…</p>
    }
    else if (_context is null)
    {
        <div class="alert-error" style="margin-bottom:1rem;">Context not found.</div>
        <a href="/payroll/calendar" class="btn-link">← Pay Calendars</a>
    }
    else
    {
        <div class="page-header">
            <div>
                <a href="/payroll/calendar" class="btn-link" style="font-size:var(--font-size-sm)">← Pay Calendars</a>
                <h2 class="page-title" style="margin-top:var(--space-1)">@_context.PayrollContextName</h2>
            </div>
            <div style="display:flex;align-items:center;gap:var(--space-3)">
                <span class="badge @StatusClass(_context.ContextStatus)" style="font-size:var(--font-size-base)">
                    @_context.ContextStatus
                </span>
                @if (!_showDeleteConfirm && !_showGenerateForm && !_showClearConfirm)
                {
                    <button class="btn-secondary"
                            style="border:1px solid #DC2626;color:#DC2626;border-radius:var(--radius-md);padding:var(--space-2) var(--space-4);font-size:var(--font-size-sm)"
                            @onclick="ShowDeleteConfirmAsync">
                        Delete Context
                    </button>
                }
            </div>
        </div>

        @* ── Delete context confirmation ─────────────────────────── *@
        @if (_showDeleteConfirm)
        {
            <div class="panel-card" style="margin-bottom:1.5rem;border:1px solid #FECACA;">
                <h3 class="panel-title" style="color:var(--color-danger)">Delete Context?</h3>
                <p style="font-size:var(--font-size-sm);color:#374151;margin:0 0 var(--space-3)">
                    This will permanently delete <strong>@_context.PayrollContextName</strong>, all of its
                    calendar periods, and all payroll enrollments for this context. This cannot be undone.
                    Contexts with payroll runs cannot be deleted.
                </p>
                @if (_deleteEnrolledCount > 0)
                {
                    <p style="font-size:var(--font-size-sm);color:var(--color-danger);font-weight:600;margin:0 0 var(--space-3)">
                        ⚠ @_deleteEnrolledCount enrolled @(_deleteEnrolledCount == 1 ? "employee" : "employees") will be removed from payroll.
                    </p>
                }
                @if (_deleteError is not null)
                {
                    <div class="alert-error" style="margin-bottom:var(--space-3)">@_deleteError</div>
                }
                <div class="form-actions">
                    <button class="btn-primary"
                            style="background:var(--color-danger)"
                            @onclick="DeleteContextAsync"
                            disabled="@_submitting">
                        @(_submitting ? "Deleting…" : "Yes, delete this context")
                    </button>
                    <button class="btn-secondary" @onclick="() => { _showDeleteConfirm = false; _deleteError = null; _deleteEnrolledCount = 0; }">Cancel</button>
                </div>
            </div>
        }

        @* Context metadata *@
        <div class="panel-card" style="margin-bottom:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-3)">
                <div class="detail-grid" style="flex:1">
                    <div class="detail-field">
                        <span class="detail-label">Code</span>
                        <span class="detail-value" style="font-family:monospace">@_context.PayrollContextCode</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Pay Frequency</span>
                        <span class="detail-value">@FrequencyLabel(_context.PayFrequencyId)</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Effective From</span>
                        <span class="detail-value">@_context.EffectiveStartDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Effective To</span>
                        <span class="detail-value">@(_context.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Periods on Record</span>
                        <span class="detail-value">@_allPeriods.Count</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Open Periods</span>
                        <span class="detail-value">@_allPeriods.Count(p => p.CalendarStatus == "OPEN")</span>
                    </div>
                    @if (!_isSalary)
                    {
                        @* Show the value in force as-of the operative date (resolved from the dated
                           rows), not the scalar cache — which is only re-synced on save and goes stale
                           once a scheduled change's effective date passes (Phase 12.13.3). *@
                        var _curOt = CurrentOtConfig();
                        <div class="detail-field">
                            <span class="detail-label">OT Threshold</span>
                            <span class="detail-value">@_curOt.OtWeeklyThresholdHours.ToString("0.##") hrs / week</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">OT Review Trigger</span>
                            <span class="detail-value">@(_curOt.OtReviewThresholdHours.HasValue ? _curOt.OtReviewThresholdHours.Value.ToString("0.##") + " hrs" : "—")</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Workweek Start</span>
                            <span class="detail-value">@WorkweekDayLabel(DerivedWorkweekStartDay)</span>
                        </div>
                    }
                </div>
                @if (!_isSalary && !_showEditSettings && !_showDeleteConfirm && !_showGenerateForm && !_showClearConfirm)
                {
                    <button class="btn-secondary" style="margin-left:var(--space-4);white-space:nowrap"
                            @onclick="BeginEditSettings">
                        Edit Settings
                    </button>
                }
            </div>

            @* ── Inline settings edit form ─────────────────────────── *@
            @if (_showEditSettings)
            {
                <div style="border-top:1px solid #e5e7eb;padding-top:var(--space-4);margin-top:var(--space-2)">
                    <h4 style="margin:0 0 var(--space-3);font-size:var(--font-size-base);font-weight:var(--font-weight-medium)">
                        Edit Operational Settings
                    </h4>
                    <div class="form-grid form-grid-3" style="margin-bottom:var(--space-4)">
                        <div class="form-field">
                            <label class="form-label">OT Weekly Threshold (hrs)</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_editOtThreshold"
                                             Min="0.01m" Max="40m" Step="0.5m" Format="0.##" />
                            <span style="font-size:var(--font-size-sm);color:#6B7280">
                                FLSA standard is 40.00. Override only if this pay group has a lower company-configured threshold.
                            </span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">OT Review Threshold (hrs)</label>
                            <SfNumericTextBox TValue="decimal?" @bind-Value="_editOtReviewThreshold"
                                             Min="0m" Max="168m" Step="0.5m" Format="0.##" Placeholder="blank = never flag OT" />
                            <span style="font-size:var(--font-size-sm);color:#6B7280">
                                Approve-by-exception trigger: hold an employee's overtime for manual review when their period OT reaches this. Blank = routine OT auto-approves.
                            </span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Workweek Start Day</label>
                            <div style="padding:6px 0;font-weight:var(--font-weight-medium)">@WorkweekDayLabel(DerivedWorkweekStartDay)</div>
                            <span style="font-size:var(--font-size-sm);color:#6B7280">
                                FLSA workweek anchor — <strong>locked to the pay-period start day</strong> (ADR-026). Changing the
                                workweek requires re-cutting the pay calendar, so it's not an in-place edit; create a new context with
                                the intended start day instead.
                            </span>
                        </div>
                        <div class="form-field">
                            <label class="form-label">Effective From</label>
                            <SfDatePicker TValue="DateOnly" @bind-Value="_editEffectiveDate"
                                          Format="yyyy-MM-dd" Width="100%" />
                            <span style="font-size:var(--font-size-sm);color:#6B7280">
                                When this change takes effect. A change activates on a workweek boundary (D7);
                                pick an earlier date only to correct an already-run week.
                            </span>
                        </div>
                    </div>
                    @{
                        var _snap    = SnappedEffectiveDate;
                        var _todayOp = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
                    }
                    <div style="font-size:var(--font-size-sm);margin-bottom:var(--space-3);padding:var(--space-2) var(--space-3);border-radius:4px;background:#F9FAFB;border:1px solid #E5E7EB;color:#374151">
                        @if (_snap != _editEffectiveDate)
                        {
                            <text>Snaps forward to the workweek start <strong>@_snap.ToString("yyyy-MM-dd")</strong> (@WorkweekDayLabel(_editWorkweekStartDay)). </text>
                        }
                        @if (_snap > _todayOp)
                        {
                            <text>📅 <strong>Scheduled</strong> — takes effect @_snap.ToString("yyyy-MM-dd"); current settings stay in force until then.</text>
                        }
                        else
                        {
                            <text>✅ <strong>Effective now</strong> — applies from the current workweek (@_snap.ToString("yyyy-MM-dd")).</text>
                        }
                    </div>
                    @if (_settingsError is not null)
                    {
                        <div class="alert-error" style="margin-bottom:var(--space-3)">@_settingsError</div>
                    }
                    <div class="form-actions">
                        <button class="btn-primary" @onclick="SaveSettingsAsync" disabled="@_submitting">
                            @(_submitting ? "Saving…" : "Save Settings")
                        </button>
                        <button class="btn-secondary" @onclick="CancelEditSettings">Cancel</button>
                    </div>
                </div>
            }

            @if (_lastSavedEffectiveDate is { } _savedEff && !_showEditSettings)
            {
                <div style="margin-top:var(--space-3);font-size:var(--font-size-sm);color:#047857">
                    ✅ Saved — change effective <strong>@_savedEff.ToString("yyyy-MM-dd")</strong>.
                </div>
            }

            @* ── Effective-dated OT-config history / scheduled changes ─────────── *@
            @if (!_isSalary && _otConfigHistory.Count > 0)
            {
                var _todayHist  = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
                var _schedCount = _otConfigHistory.Count(r => r.EffectiveDate > _todayHist);
                <div style="margin-top:var(--space-4)">
                    <button type="button" @onclick="() => _otConfigTimelineExpanded = !_otConfigTimelineExpanded"
                            style="background:none;border:none;padding:0;cursor:pointer;display:flex;align-items:center;gap:8px;text-align:left;color:inherit">
                        <span style="color:#9CA3AF;font-size:12px;width:10px">@(_otConfigTimelineExpanded ? "▾" : "▸")</span>
                        <span style="font-size:var(--font-size-sm);font-weight:var(--font-weight-medium);color:#374151">Overtime configuration timeline</span>
                        @if (!_otConfigTimelineExpanded)
                        {
                            <span style="font-size:var(--font-size-sm);color:#6B7280">
                                — @_otConfigHistory.Count entr@(_otConfigHistory.Count == 1 ? "y" : "ies")@(_schedCount > 0 ? $" · {_schedCount} scheduled" : "")
                            </span>
                        }
                    </button>
                    @if (_otConfigTimelineExpanded)
                    {
                    <div style="width:62.5%;min-width:520px;border:1px solid #E3E8EF;border-radius:4px;background:#fff;overflow:hidden;margin-top:var(--space-2)">
                        <table style="width:100%;border-collapse:collapse;font-size:var(--font-size-sm)">
                            <thead>
                                <tr style="background:#F9FAFB;color:#6B7280;text-align:left">
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Effective</th>
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Until</th>
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">OT Threshold</th>
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Review Trigger</th>
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Workweek Start</th>
                                    <th style="padding:6px 12px;font-weight:var(--font-weight-medium)"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _otConfigHistory)
                                {
                                    var _isCurrent = r.EffectiveDate <= _todayHist && (r.EndDate is null || r.EndDate >= _todayHist);
                                    var _isFuture  = r.EffectiveDate > _todayHist;
                                    <tr style="border-top:1px solid #EEF1F5">
                                        <td style="padding:6px 12px">
                                            @* The backfilled baseline carries a far-past sentinel for gapless
                                               coverage; show the context's own effective-from date instead. *@
                                            @if (r.EffectiveDate.Year <= 1)
                                            {
                                                <text>@_context!.EffectiveStartDate.ToString("yyyy-MM-dd") <span style="color:#9CA3AF;font-size:11px">(initial)</span></text>
                                            }
                                            else
                                            {
                                                @r.EffectiveDate.ToString("yyyy-MM-dd")
                                            }
                                        </td>
                                        <td style="padding:6px 12px">@(r.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td style="padding:6px 12px">@r.OtWeeklyThresholdHours.ToString("0.##") hrs</td>
                                        <td style="padding:6px 12px">@(r.OtReviewThresholdHours.HasValue ? r.OtReviewThresholdHours.Value.ToString("0.##") + " hrs" : "—")</td>
                                        <td style="padding:6px 12px">@WorkweekDayLabel(r.WorkweekStartDay)</td>
                                        <td style="padding:6px 12px">
                                            @if (_isCurrent)
                                            {
                                                <span style="font-size:11px;padding:1px 8px;border-radius:10px;background:#ECFDF5;color:#047857;border:1px solid #A7F3D0">Current</span>
                                            }
                                            else if (_isFuture)
                                            {
                                                <span style="font-size:11px;padding:1px 8px;border-radius:10px;background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE">Scheduled</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                </div>
            }

            @* ── Phase 12.13.4b — OT-eligible category set (advanced) ───────────── *@
            @if (!_isSalary)
            {
                var _curEligible = CurrentEligibleCategoryIds();
                var _todayElig   = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
                <div style="margin-top:var(--space-5);border-top:1px solid #e5e7eb;padding-top:var(--space-4)">
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:var(--space-3)">
                        <button type="button" @onclick="() => _eligibleExpanded = !_eligibleExpanded"
                                style="background:none;border:none;padding:0;cursor:pointer;display:flex;align-items:center;gap:8px;text-align:left;color:inherit">
                            <span style="color:#9CA3AF;font-size:12px;width:10px">@(_eligibleExpanded ? "▾" : "▸")</span>
                            <span style="font-size:var(--font-size-base);font-weight:var(--font-weight-medium)">
                                Overtime-eligible categories
                                <span style="font-weight:400;color:#9CA3AF;font-size:var(--font-size-sm)">· advanced</span>
                            </span>
                            @if (!_eligibleExpanded)
                            {
                                <span style="font-size:var(--font-size-sm);color:#6B7280">
                                    — @(_curEligible.Count == 0 ? "worked time only" : string.Join(", ", _otCategories.Where(c => _curEligible.Contains(c.Id)).Select(c => c.Label)))
                                </span>
                            }
                        </button>
                        @if (_eligibleExpanded && !_showEditEligible && !_showEditSettings && !_showGenerateForm && !_showDeleteConfirm && !_showClearConfirm)
                        {
                            <button class="btn-secondary" style="white-space:nowrap" @onclick="BeginEditEligible">Edit</button>
                        }
                    </div>

                    @if (_eligibleExpanded)
                    {
                    <div style="font-size:var(--font-size-sm);color:#6B7280;max-width:640px;margin-top:var(--space-2)">
                        Which time categories count toward the FLSA overtime threshold. Default is worked time
                        (Regular/Overtime); a union/CBA policy may add others (e.g. Holiday). Paid leave is always
                        paid — this only changes whether a category counts toward OT.
                    </div>

                    <div style="margin-top:var(--space-2);font-size:var(--font-size-sm)">
                        @if (_curEligible.Count == 0)
                        {
                            <span style="color:#6B7280">Default — <strong>worked time only</strong> (Regular / Overtime).</span>
                        }
                        else
                        {
                            @foreach (var c in _otCategories.Where(c => _curEligible.Contains(c.Id)))
                            {
                                <span style="display:inline-block;font-size:12px;padding:2px 8px;margin:0 4px 4px 0;border-radius:10px;background:#F3F4F6;border:1px solid #E5E7EB">@c.Label</span>
                            }
                        }
                    </div>

                    @if (_showEditEligible)
                    {
                        <div style="border-top:1px dashed #e5e7eb;padding-top:var(--space-3);margin-top:var(--space-3)">
                            <div style="display:flex;flex-wrap:wrap;gap:8px 20px;margin-bottom:var(--space-3)">
                                @foreach (var c in _otCategories)
                                {
                                    <label style="display:flex;align-items:center;gap:6px;font-size:var(--font-size-sm)">
                                        <input type="checkbox" checked="@_editEligibleSelected.Contains(c.Id)"
                                               @onchange="e => ToggleEligibleCategory(c.Id, (bool)e.Value!)" />
                                        @c.Label
                                        @if (c.IsWorkedTime) { <span style="color:#9CA3AF;font-size:11px">(default)</span> }
                                    </label>
                                }
                            </div>
                            <div class="form-field" style="max-width:240px;margin-bottom:var(--space-3)">
                                <label class="form-label">Effective From</label>
                                <SfDatePicker TValue="DateOnly" @bind-Value="_editEligibleEffectiveDate" Format="yyyy-MM-dd" Width="100%" />
                            </div>
                            @{
                                var _snapE = SnappedEligibleEffectiveDate;
                            }
                            <div style="font-size:var(--font-size-sm);margin-bottom:var(--space-3);padding:var(--space-2) var(--space-3);border-radius:4px;background:#F9FAFB;border:1px solid #E5E7EB;color:#374151">
                                @if (_snapE != _editEligibleEffectiveDate)
                                {
                                    <text>Snaps forward to the workweek start <strong>@_snapE.ToString("yyyy-MM-dd")</strong>. </text>
                                }
                                @if (_editEligibleSelected.Count == 0)
                                {
                                    <text>⚠️ No categories selected — reverts to the default (worked time only) from @_snapE.ToString("yyyy-MM-dd").</text>
                                }
                                else if (_snapE > _todayElig)
                                {
                                    <text>📅 <strong>Scheduled</strong> — @_editEligibleSelected.Count categories effective @_snapE.ToString("yyyy-MM-dd"); current set stays in force until then.</text>
                                }
                                else
                                {
                                    <text>✅ <strong>Effective now</strong> — applies from the current workweek (@_snapE.ToString("yyyy-MM-dd")).</text>
                                }
                            </div>
                            @if (_eligibleError is not null)
                            {
                                <div class="alert-error" style="margin-bottom:var(--space-3)">@_eligibleError</div>
                            }
                            <div class="form-actions">
                                <button class="btn-primary" @onclick="SaveEligibleSetAsync" disabled="@_submitting">
                                    @(_submitting ? "Saving…" : "Save Categories")
                                </button>
                                <button class="btn-secondary" @onclick="CancelEditEligible">Cancel</button>
                            </div>
                        </div>
                    }

                    @if (_lastSavedEligibleEffectiveDate is { } _savedE && !_showEditEligible)
                    {
                        <div style="margin-top:var(--space-2);font-size:var(--font-size-sm);color:#047857">
                            ✅ Saved — effective <strong>@_savedE.ToString("yyyy-MM-dd")</strong>.
                        </div>
                    }

                    @if (_otEligibleHistory.Count > 0)
                    {
                        <div style="margin-top:var(--space-3)">
                            <div style="font-size:var(--font-size-sm);font-weight:var(--font-weight-medium);color:#374151;margin-bottom:var(--space-2)">
                                Eligibility timeline
                            </div>
                            <div style="width:62.5%;min-width:520px;border:1px solid #E3E8EF;border-radius:4px;background:#fff;overflow:hidden">
                                <table style="width:100%;border-collapse:collapse;font-size:var(--font-size-sm)">
                                    <thead>
                                        <tr style="background:#F9FAFB;color:#6B7280;text-align:left">
                                            <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Effective</th>
                                            <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Until</th>
                                            <th style="padding:6px 12px;font-weight:var(--font-weight-medium)">Categories</th>
                                            <th style="padding:6px 12px;font-weight:var(--font-weight-medium)"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var gen in _otEligibleHistory
                                            .GroupBy(r => (r.EffectiveDate, r.EndDate))
                                            .OrderByDescending(g => g.Key.EffectiveDate))
                                        {
                                            var _isCur = gen.Key.EffectiveDate <= _todayElig && (gen.Key.EndDate is null || gen.Key.EndDate >= _todayElig);
                                            var _isFut = gen.Key.EffectiveDate > _todayElig;
                                            <tr style="border-top:1px solid #EEF1F5">
                                                <td style="padding:6px 12px">
                                                    @if (gen.Key.EffectiveDate.Year <= 1)
                                                    {
                                                        <text>@_context!.EffectiveStartDate.ToString("yyyy-MM-dd") <span style="color:#9CA3AF;font-size:11px">(initial)</span></text>
                                                    }
                                                    else { @gen.Key.EffectiveDate.ToString("yyyy-MM-dd") }
                                                </td>
                                                <td style="padding:6px 12px">@(gen.Key.EndDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                                <td style="padding:6px 12px">@string.Join(", ", gen.Select(x => x.CategoryLabel))</td>
                                                <td style="padding:6px 12px">
                                                    @if (_isCur)
                                                    {
                                                        <span style="font-size:11px;padding:1px 8px;border-radius:10px;background:#ECFDF5;color:#047857;border:1px solid #A7F3D0">Current</span>
                                                    }
                                                    else if (_isFut)
                                                    {
                                                        <span style="font-size:11px;padding:1px 8px;border-radius:10px;background:#EFF6FF;color:#1D4ED8;border:1px solid #BFDBFE">Scheduled</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    }
                </div>
            }
        </div>

        @* Year selector + Generate button *@
        <div class="filter-row" style="margin-bottom:var(--space-4)">
            <label class="filter-label">Year</label>
            <SfDropDownList TValue="int" TItem="YearOption" DataSource="@_yearOptions" @bind-Value="_selectedYear" Width="120px">
                <DropDownListFieldSettings Value="Value" Text="Label" />
                <DropDownListEvents TValue="int" TItem="YearOption" ValueChange="OnYearChangedAsync" />
            </SfDropDownList>
            <label class="filter-label" style="margin-left:var(--space-4)">Status</label>
            <SfDropDownList TValue="string" TItem="FilterOption" DataSource="@_statusOptions" @bind-Value="_periodStatusFilter" Width="140px">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            @if (!_showGenerateForm && !_showClearConfirm)
            {
                <div style="margin-left:auto;display:flex;gap:var(--space-2)">
                    <button class="btn-secondary" @onclick="ToggleGenerateForm">
                        Generate Calendar for @_selectedYear
                    </button>
                    @if (_yearPeriods.Count > 0)
                    {
                        <button class="btn-secondary"
                                style="border:1px solid var(--module-ta);color:var(--module-ta);border-radius:var(--radius-md);padding:var(--space-2) var(--space-4)"
                                @onclick="() => _showClearConfirm = true">
                            Clear @_selectedYear Calendar
                        </button>
                    }
                </div>
            }
        </div>

        @* ── Clear year confirmation ───────────────────────────── *@
        @if (_showClearConfirm)
        {
            <div class="panel-card" style="margin-bottom:1.5rem;border:1px solid #FECACA;">
                <h3 class="panel-title" style="color:var(--color-danger)">Clear @_selectedYear Calendar?</h3>
                <p style="font-size:var(--font-size-sm);color:#374151;margin:0 0 var(--space-3)">
                    This will permanently delete all <strong>@_yearPeriods.Count</strong> period(s) for @_selectedYear
                    that are not referenced by a payroll run. Periods used in existing runs cannot be removed.
                </p>
                @if (_clearResultMessage is not null)
                {
                    <div class="@(_clearHadError ? "alert-error" : "alert-info")" style="margin-bottom:var(--space-3)">
                        @_clearResultMessage
                    </div>
                }
                <div class="form-actions">
                    <button class="btn-primary"
                            style="background:var(--color-danger)"
                            @onclick="ClearYearAsync"
                            disabled="@_submitting">
                        @(_submitting ? "Deleting…" : $"Yes, delete {_selectedYear} periods")
                    </button>
                    <button class="btn-secondary" @onclick="CancelClear">Cancel</button>
                </div>
            </div>
        }

        @* ── Generate Calendar Form ───────────────────────────── *@
        @if (_showGenerateForm)
        {
            var freqCode    = _frequencies.FirstOrDefault(f => f.Id == _context.PayFrequencyId)?.Code ?? "";
            var needsAnchor = freqCode is "WEEKLY" or "BIWEEKLY";
            var needsConvention = freqCode is "MONTHLY" or "SEMI_MONTHLY";
            var extraPeriod = needsAnchor && PayDateComputer.WillHaveExtraPeriod(
                                  _genForm.FirstPeriodStart, _selectedYear, freqCode);

            <div class="panel-card" style="margin-bottom:1.5rem;">
                <h3 class="panel-title">Generate @_selectedYear Calendar</h3>

                @if (_yearPeriods.Count > 0)
                {
                    <div class="alert-info" style="margin-bottom:var(--space-3)">
                        @_yearPeriods.Count period(s) already exist for @_selectedYear.
                        Only missing period numbers will be added.
                    </div>
                }

                @* ── Anchor date (weekly / biweekly only) ── *@
                @if (needsAnchor)
                {
                    <div class="form-grid form-grid-3" style="margin-bottom:var(--space-4)">
                        <div class="form-field">
                            <label class="form-label">First Period Start Date <span style="color:var(--color-danger)">*</span></label>
                            <TdoDatePicker TValue="DateOnly" @bind-Value="_genForm.FirstPeriodStart" Placeholder="MM/DD/YYYY">
                                <DatePickerEvents TValue="DateOnly" ValueChange="@(_ => StateHasChanged())" />
                            </TdoDatePicker>
                            <span style="font-size:var(--font-size-sm);color:#6B7280">Establishes the anchor — all @GetPeriodsPerYear(freqCode) periods derive from this date.</span>
                        </div>
                    </div>
                }

                @* ── Convention display (monthly / semi-monthly only) ── *@
                @if (needsConvention && !string.IsNullOrEmpty(_genForm.Convention))
                {
                    var conventionLabel = freqCode == "MONTHLY"
                        ? (_monthlyConventions.FirstOrDefault(c => c.Code == _genForm.Convention).Label ?? _genForm.Convention)
                        : (_semiMonthlyConventions.FirstOrDefault(c => c.Code == _genForm.Convention).Label ?? _genForm.Convention);
                    <p style="font-size:var(--font-size-sm);color:#374151;margin-bottom:var(--space-4)">
                        Pay date convention: <strong>@conventionLabel</strong>
                        <span style="color:#6B7280"> — set on the payroll context</span>
                    </p>
                    @if (freqCode == "MONTHLY")
                    {
                        var preview = PayDateComputer.Compute(
                            new DateOnly(_selectedYear, 1, DateTime.DaysInMonth(_selectedYear, 1)),
                            "MONTHLY", _genForm.Convention, _genForm.PayDateOffsetDays);
                        <p style="font-size:var(--font-size-sm);color:#374151;margin-bottom:var(--space-4)">
                            Preview — January @_selectedYear pay date: <strong>@preview.ToString("yyyy-MM-dd")</strong>
                            <span style="color:#6B7280"> (@preview.DayOfWeek)</span>
                        </p>
                    }
                }

                @* ── Offset fields ── *@
                <div class="form-grid form-grid-3" style="margin-bottom:var(--space-4)">
                    @if (!needsConvention || freqCode == "SEMI_MONTHLY" && _genForm.Convention == "SM_LAGGED_5")
                    {
                        @if (needsAnchor || !needsConvention)
                        {
                            <div class="form-field">
                                <label class="form-label">Pay Date Offset (days after period end)</label>
                                <SfNumericTextBox TValue="int" @bind-Value="_genForm.PayDateOffsetDays" Min="1" Max="30" />
                            </div>
                        }
                    }
                    @if (!_isSalary)
                    {
                        <div class="form-field">
                            <label class="form-label">Input Cutoff (days before pay date)</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_genForm.CutoffOffsetDays" Min="1" Max="30" />
                        </div>
                    }
                    <div class="form-field">
                        <label class="form-label">Run Lead (banking days before pay date)</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_genForm.CalculationLeadDays" Min="3" Max="30" />
                        <span style="font-size:var(--font-size-sm);color:#6B7280">Transmission is always 2 banking days before pay date.</span>
                    </div>
                </div>

                @* ── Extra period warning ── *@
                @if (extraPeriod)
                {
                    var periodCount = freqCode == "WEEKLY" ? 53 : 27;
                    var standard    = freqCode == "WEEKLY" ? 52 : 26;
                    <div class="alert-warning" style="margin-bottom:var(--space-4)">
                        ⚠ This calendar will contain <strong>@periodCount pay periods</strong> (standard is @standard).
                        The anchor date and year length produce an additional period.
                        Configured policy: <strong>@ExtraPeriodPolicyLabel(_context.ExtraPeriodPolicy)</strong>.
                        Review your per-period salary treatment before proceeding.
                    </div>
                }

                <p style="font-size:var(--font-size-sm);color:#6B7280;margin:0 0 var(--space-3)">
                    Frequency: <strong>@freqCode</strong> —
                    @GetPeriodsPerYear(freqCode) period(s) standard for @_selectedYear.
                    Periods whose end date is in the past are set to <strong>CLOSED</strong>.
                </p>

                @if (_generateError is not null)
                {
                    <div class="alert-error" style="margin-bottom:var(--space-3)">@_generateError</div>
                }
                <div class="form-actions">
                    <button class="btn-primary" @onclick="GenerateCalendarAsync" disabled="@_submitting">
                        @(_submitting ? "Generating…" : "Generate Periods")
                    </button>
                    <button class="btn-secondary" @onclick="ToggleGenerateForm">Cancel</button>
                </div>
            </div>
        }

        @* ── Period table ─────────────────────────────────────── *@
        @if (_periodLoading)
        {
            <p class="loading-state">Loading periods…</p>
        }
        else if (_yearPeriods.Count == 0)
        {
            <p class="empty-state">
                No periods for @_selectedYear.
                Click <strong>Generate Calendar for @_selectedYear</strong> to create them.
            </p>
        }
        else
        {
            var visible = string.IsNullOrEmpty(_periodStatusFilter)
                ? _yearPeriods
                : _yearPeriods.Where(p => p.CalendarStatus == _periodStatusFilter).ToList();

            <SfGrid DataSource="@visible.OrderBy(p => p.PeriodNumber).ToList()" AllowSorting="true" AllowPaging="true" CssClass="e-gridhover">
                <GridPageSettings PageSize="25" />
                <GridColumns>
                    <GridColumn Field="PeriodNumber" HeaderText="Period" Width="90">
                        <Template>@{ var p = (PayrollPeriod)context; }<span style="font-weight:var(--font-weight-medium)">P@(p.PeriodNumber)</span></Template>
                    </GridColumn>
                    <GridColumn Field="PeriodStartDate" HeaderText="Start Date" Width="120">
                        <Template>@{ var p = (PayrollPeriod)context; }@p.PeriodStartDate.ToString("yyyy-MM-dd")</Template>
                    </GridColumn>
                    <GridColumn Field="PeriodEndDate" HeaderText="End Date" Width="120">
                        <Template>@{ var p = (PayrollPeriod)context; }@p.PeriodEndDate.ToString("yyyy-MM-dd")</Template>
                    </GridColumn>
                    @if (!_isSalary)
                    {
                        <GridColumn Field="InputCutoffDate" HeaderText="Cutoff" Width="120">
                            <Template>@{ var p = (PayrollPeriod)context; }@p.InputCutoffDate.ToString("yyyy-MM-dd")</Template>
                        </GridColumn>
                    }
                    <GridColumn HeaderText="Run Date" Width="220">
                        <Template>
                            @{ var p = (PayrollPeriod)context; }
                            @if (_editRunDatePeriodId == p.PeriodId)
                            {
                                <div style="display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap">
                                    <TdoDatePicker TValue="DateOnly?" @bind-Value="_editRunDateValue" />
                                    <button class="btn-primary"
                                            style="padding:2px 10px;font-size:var(--font-size-sm)"
                                            @onclick="() => SaveRunDateAsync(p.PeriodId)"
                                            disabled="@_editRunDateSaving">
                                        @(_editRunDateSaving ? "…" : "Save")
                                    </button>
                                    <button class="btn-secondary"
                                            style="padding:2px 10px;font-size:var(--font-size-sm)"
                                            @onclick="CancelEditRunDate">Cancel</button>
                                </div>
                                @if (_editRunDateError is not null)
                                {
                                    <div class="alert-error" style="margin-top:2px;font-size:var(--font-size-sm)">@_editRunDateError</div>
                                }
                            }
                            else
                            {
                                <span>@(p.CalculationDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                                <button class="btn-link"
                                        style="font-size:var(--font-size-sm);margin-left:var(--space-2)"
                                        @onclick="() => BeginEditRunDate(p)">edit</button>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="PayDate" HeaderText="Pay Date" Width="120">
                        <Template>@{ var p = (PayrollPeriod)context; }@p.PayDate.ToString("yyyy-MM-dd")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="200">
                        <Template>
                            @{ var p = (PayrollPeriod)context; }
                            <span class="badge @PeriodStatusClass(p.CalendarStatus)">@p.CalendarStatus</span>
                            @* ADR-027 D8 / #54 — close a released (LOCKED) period to end its correction window. *@
                            @if (p.CalendarStatus == "LOCKED")
                            {
                                @if (_pendingClosePeriodId == p.PeriodId)
                                {
                                    <button class="btn-link" style="font-size:var(--font-size-sm);margin-left:var(--space-2)"
                                            @onclick="() => ConfirmClosePeriodAsync(p)">confirm close</button>
                                    <button class="btn-link" style="font-size:var(--font-size-sm)"
                                            @onclick="CancelClosePeriod">cancel</button>
                                    @if (_closeHadError && _closeMessage is not null)
                                    {
                                        <div class="text-sm" style="color:var(--color-danger,#dc2626)">@_closeMessage</div>
                                    }
                                }
                                else
                                {
                                    <button class="btn-link" style="font-size:var(--font-size-sm);margin-left:var(--space-2)"
                                            title="End the correction window — no more supplementals/corrections for this period"
                                            @onclick="() => BeginClosePeriod(p)">close</button>
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    }

</div>

@code {
    [Parameter] public Guid ContextId { get; set; }

    private record FilterOption(string Value, string Label);
    private record YearOption(int Value, string Label);
    private record DayOption(int Value, string Label);

    private static readonly List<DayOption> _dayOptions =
    [
        new(0, "Sunday"),
        new(1, "Monday"),
        new(2, "Tuesday"),
        new(3, "Wednesday"),
        new(4, "Thursday"),
        new(5, "Friday"),
        new(6, "Saturday"),
    ];

    private List<YearOption> _yearOptions = [];

    private static readonly List<FilterOption> _statusOptions =
    [
        new("",       "All"),
        new("OPEN",   "Open"),
        new("CLOSED", "Closed"),
        new("LOCKED", "Locked"),
    ];

    private PayrollContext?  _context;
    private List<PayrollPeriod> _allPeriods  = [];
    private List<PayrollPeriod> _yearPeriods = [];
    private List<LookupEntry>   _frequencies = [];
    private List<LookupEntry>   _rateTypes   = [];

    // True when this context's rate type is Salary — OT / hourly-pay fields are hidden.
    private bool _isSalary =>
        _context is not null
        && _rateTypes.FirstOrDefault(r => r.Id == _context.CompensationRateTypeId)?.Code == "SALARY";

    private int     _selectedYear;
    private string  _periodStatusFilter = "";
    private bool    _loading           = true;
    private bool    _periodLoading;
    private bool    _submitting;
    private bool    _showGenerateForm;
    private bool    _showClearConfirm;
    private bool    _showDeleteConfirm;
    private int     _deleteEnrolledCount;
    private string? _generateError;
    private string? _clearResultMessage;
    private bool    _clearHadError;
    private string? _deleteError;
    private Guid    _currentUserId;

    // Inline settings editing
    private bool     _showEditSettings;
    private decimal  _editOtThreshold;
    private decimal? _editOtReviewThreshold;   // Phase 12.7b — null = OT never flagged on hours
    private int      _editWorkweekStartDay;
    private string?  _settingsError;
    private DateOnly  _editEffectiveDate;        // Phase 12.13.3b — requested effective date (picker)
    private DateOnly? _lastSavedEffectiveDate;   // Phase 12.13.3 — snapped effective date of last save
    private IReadOnlyList<DatedOtConfigRow> _otConfigHistory = [];
    private bool _otConfigTimelineExpanded;   // collapsed by default to save screen space

    // D7: the date a change requested for _editEffectiveDate actually takes effect — the first
    // workweek start on/after it (using the anchor being saved). Mirrors the repo's snap so the
    // form can preview it live.
    private DateOnly SnappedEffectiveDate
    {
        get
        {
            var ws = OvertimeSplitCalculator.GetWeekStart(_editEffectiveDate, _editWorkweekStartDay);
            return ws == _editEffectiveDate ? ws : ws.AddDays(7);
        }
    }

    // Phase 12.13.4b — OT-eligible category set editor (advanced)
    private IReadOnlyList<OtCategoryOption>  _otCategories      = [];
    private IReadOnlyList<DatedOtEligibleRow> _otEligibleHistory = [];
    private bool        _eligibleExpanded;   // collapsed by default to save screen space
    private bool        _showEditEligible;
    private HashSet<int> _editEligibleSelected = [];
    private DateOnly    _editEligibleEffectiveDate;
    private string?     _eligibleError;
    private DateOnly?   _lastSavedEligibleEffectiveDate;

    // Snap preview for the eligible-set editor — uses the context's current workweek anchor (the set
    // editor doesn't change the anchor).
    private DateOnly SnappedEligibleEffectiveDate
    {
        get
        {
            var anchor = _context?.WorkweekStartDay ?? 1;
            var ws = OvertimeSplitCalculator.GetWeekStart(_editEligibleEffectiveDate, anchor);
            return ws == _editEligibleEffectiveDate ? ws : ws.AddDays(7);
        }
    }

    // The currently-effective OT-eligible category ids (the generation covering operative today).
    // Empty ⇒ no override (the engine falls back to the is_worked_time default).
    private HashSet<int> CurrentEligibleCategoryIds()
    {
        var today = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
        return _otEligibleHistory
            .Where(r => r.EffectiveDate <= today && (r.EndDate is null || r.EndDate >= today))
            .Select(r => r.TimeCategoryId)
            .ToHashSet();
    }

    // Inline run-date editing
    private Guid?    _editRunDatePeriodId;
    private DateOnly? _editRunDateValue;
    private bool     _editRunDateSaving;
    private string?  _editRunDateError;

    private GenerateForm _genForm = new();

    protected override async Task OnInitializedAsync()
    {
        var currentYear = TemporalContext.GetOperativeDate().Year;
        _selectedYear = currentYear;
        _yearOptions = Enumerable.Range(currentYear - 3, 5)
            .Select(y => new YearOption(y, y.ToString()))
            .OrderByDescending(y => y.Value)
            .ToList();

        var auth = await AuthState.GetAuthenticationStateAsync();
        _currentUserId = Guid.TryParse(auth.User.FindFirst("sub")?.Value, out var g) ? g : Guid.Empty;

        try { _frequencies = LookupCache.GetAll(LookupTables.PayFrequency).OrderBy(f => f.Id).ToList(); }
        catch { _frequencies = DefaultFrequencies(); }

        try { _rateTypes = LookupCache.GetAll(LookupTables.CompensationRateType).OrderBy(r => r.Id).ToList(); }
        catch { _rateTypes = []; }

        _context = await ContextRepo.GetByIdAsync(ContextId);
        if (_context is not null)
        {
            SessionState.Lock();
            await LoadPeriodsAsync();
            await LoadOtConfigHistoryAsync();
            if (!_isSalary)
            {
                _otCategories = await ContextRepo.GetSelectableOtCategoriesAsync();
                await LoadOtEligibleHistoryAsync();
            }
        }

        _loading = false;
    }

    // Phase 12.13.3b: the effective-dated OT-config intervals (newest first) for the history inset.
    private async Task LoadOtConfigHistoryAsync()
        => _otConfigHistory = await ContextRepo.GetDatedOtConfigHistoryAsync(ContextId);

    // Phase 12.13.4b: the effective-dated OT-eligible-set rows (newest interval first).
    private async Task LoadOtEligibleHistoryAsync()
        => _otEligibleHistory = await ContextRepo.GetDatedOtEligibleHistoryAsync(ContextId);

    private void BeginEditEligible()
    {
        if (_context is null) return;
        // Pre-check the currently-effective set; if none configured, default to the is_worked_time
        // members (the resolver's fallback) so "no override" still shows a sensible starting point.
        var current = CurrentEligibleCategoryIds();
        _editEligibleSelected = current.Count > 0
            ? [.. current]
            : [.. _otCategories.Where(c => c.IsWorkedTime).Select(c => c.Id)];

        var today = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
        var ws    = OvertimeSplitCalculator.GetWeekStart(today, _context.WorkweekStartDay);
        _editEligibleEffectiveDate     = ws == today ? ws : ws.AddDays(7);
        _lastSavedEligibleEffectiveDate = null;
        _eligibleError    = null;
        _eligibleExpanded = true;   // editing always opens the section
        _showEditEligible = true;
    }

    private void CancelEditEligible()
    {
        _showEditEligible = false;
        _eligibleError    = null;
    }

    private void ToggleEligibleCategory(int categoryId, bool selected)
    {
        if (selected) _editEligibleSelected.Add(categoryId);
        else          _editEligibleSelected.Remove(categoryId);
    }

    private async Task SaveEligibleSetAsync()
    {
        if (_context is null) return;
        _submitting    = true;
        _eligibleError = null;
        try
        {
            var operativeToday = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
            _lastSavedEligibleEffectiveDate = await ContextRepo.SaveDatedOtEligibleSetAsync(
                ContextId, [.. _editEligibleSelected], _context.WorkweekStartDay,
                _editEligibleEffectiveDate, operativeToday, _currentUserId);

            await LoadOtEligibleHistoryAsync();
            _showEditEligible = false;
        }
        catch (Exception ex) { _eligibleError = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task LoadPeriodsAsync()
    {
        _periodLoading = true;
        var current = await ContextRepo.GetPeriodsByContextAsync(ContextId, _selectedYear);
        _yearPeriods  = current.ToList();

        // Fetch a broader set for the header totals (current + prev year)
        var prev = await ContextRepo.GetPeriodsByContextAsync(ContextId, _selectedYear - 1);
        _allPeriods   = current.Concat(prev).ToList();
        _periodLoading = false;
    }

    private async Task OnYearChangedAsync(ChangeEventArgs<int, YearOption> args)
    {
        _selectedYear     = args.Value;
        _showGenerateForm = false;
        await LoadPeriodsAsync();
    }

    private async Task ClearYearAsync()
    {
        _submitting         = true;
        _clearResultMessage = null;
        try
        {
            var (deleted, skipped) = await ContextRepo.DeletePeriodsForYearAsync(ContextId, _selectedYear);
            await LoadPeriodsAsync();
            _clearHadError = skipped > 0 && deleted == 0;

            _clearResultMessage = (deleted, skipped) switch
            {
                (0, 0)       => "No periods found to delete.",
                (0, var s)   => $"Cannot delete: all {s} period(s) are referenced by existing payroll runs.",
                (var d, 0)   => $"{d} period(s) deleted. Calendar cleared.",
                (var d, var s) => $"{d} period(s) deleted. {s} period(s) skipped — referenced by payroll runs."
            };

            if (deleted > 0)
                _showClearConfirm = false;
        }
        catch (Exception ex)
        {
            _clearResultMessage = ex.Message;
            _clearHadError      = true;
        }
        finally { _submitting = false; }
    }

    private void CancelClear()
    {
        _showClearConfirm   = false;
        _clearResultMessage = null;
    }

    // ADR-027 D8 / #54 — close a released (LOCKED) period (LOCKED → CLOSED), ending its
    // correction window. Inline per-row confirm in the Status column.
    private Guid?   _pendingClosePeriodId;
    private string? _closeMessage;
    private bool    _closeHadError;

    private void BeginClosePeriod(PayrollPeriod p)
    {
        _pendingClosePeriodId = p.PeriodId;
        _closeMessage         = null;
        _closeHadError        = false;
    }

    private void CancelClosePeriod()
    {
        _pendingClosePeriodId = null;
        _closeMessage         = null;
        _closeHadError        = false;
    }

    private async Task ConfirmClosePeriodAsync(PayrollPeriod p)
    {
        _closeMessage  = null;
        _closeHadError = false;
        try
        {
            var reason = await ContextRepo.ClosePeriodAsync(p.PeriodId, _currentUserId);
            if (reason is not null)
            {
                _closeMessage  = reason;
                _closeHadError = true;
                return;
            }
            await AuditService.LogAsync(new AuditEventRecord(
                EventType:        "STATUS_CHANGE",
                EntityType:       "PayrollPeriod",
                EntityId:         p.PeriodId,
                ModuleName:       "PAYROLL",
                ChangeSummary:    $"Period {p.PeriodYear} P{p.PeriodNumber} closed (LOCKED → CLOSED) — correction window ended.",
                ParentEntityType: "PayrollContext",
                ParentEntityId:   ContextId,
                AfterJson:        System.Text.Json.JsonSerializer.Serialize(new
                {
                    period_year   = p.PeriodYear,
                    period_number = p.PeriodNumber,
                    calendar_status = "CLOSED"
                })));
            _pendingClosePeriodId = null;
            await LoadPeriodsAsync();
        }
        catch (Exception ex)
        {
            _closeMessage  = ex.Message;
            _closeHadError = true;
        }
    }

    private async Task ShowDeleteConfirmAsync()
    {
        _deleteEnrolledCount = await ProfileRepo.CountActiveByContextAsync(ContextId);
        _deleteError         = null;
        _showDeleteConfirm   = true;
    }

    private async Task DeleteContextAsync()
    {
        _submitting  = true;
        _deleteError = null;
        try
        {
            var reason = await ContextRepo.DeleteContextAsync(ContextId);
            if (reason is not null)
            {
                _deleteError = reason;
                return;
            }
            Nav.NavigateTo("/payroll/calendar");
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _submitting = false; }
    }

    private static readonly (string Code, string Label, string Hint)[] _monthlyConventions =
    [
        ("MONTH_END",       "Last day of the month",       "Most common — aligns with accounting close, employees paid for full month"),
        ("FIRST_FOLLOWING", "1st of the following month",  "Gives payroll team the full month to process; pay is slightly delayed"),
        ("MID_MONTH",       "15th of the month",           "Mid-month — simple and predictable"),
        ("FIXED_25",        "25th of the month",           "Gives employees money before month-end bills; payroll has most of month to process"),
    ];

    private static readonly (string Code, string Label, string Hint)[] _semiMonthlyConventions =
    [
        ("SM_15_AND_END", "15th and last day of month", "Most common semi-monthly"),
        ("SM_1_AND_15",   "1st and 15th of month",      "Government, education"),
        ("SM_10_AND_25",  "10th and 25th of month",     "Less common"),
    ];

    private void ToggleGenerateForm()
    {
        _showGenerateForm = !_showGenerateForm;
        _generateError    = null;
        if (_showGenerateForm && _context is not null)
        {
            var freqCode = _frequencies.FirstOrDefault(f => f.Id == _context.PayFrequencyId)?.Code ?? "";
            _genForm = new GenerateForm
            {
                FirstPeriodStart    = new DateOnly(_selectedYear, 1, 1),
                Convention          = _context.PayDateConvention ?? DefaultConvention(_context.PayFrequencyId),
                PayDateOffsetDays   = _context.PayDateOffsetDays,
                CutoffOffsetDays    = _context.CutoffOffsetDays,
                CalculationLeadDays = DefaultLeadDays(freqCode)
            };
        }
    }

    private static int DefaultLeadDays(string freqCode) => freqCode switch
    {
        "WEEKLY"       => 3,
        "BIWEEKLY"     => 4,
        "SEMI_MONTHLY" => 5,
        "MONTHLY"      => 6,
        _              => 3
    };

    private string DefaultConvention(int freqId)
    {
        var code = _frequencies.FirstOrDefault(f => f.Id == freqId)?.Code ?? "";
        return code switch
        {
            "MONTHLY"      => "MONTH_END",
            "SEMI_MONTHLY" => "SM_15_AND_END",
            _              => ""
        };
    }

    private async Task GenerateCalendarAsync()
    {
        if (_context is null) return;

        var freqCode = _frequencies.FirstOrDefault(f => f.Id == _context.PayFrequencyId)?.Code ?? "";

        if ((freqCode is "WEEKLY" or "BIWEEKLY") && _genForm.FirstPeriodStart.Year != _selectedYear)
        {
            _generateError = $"First period start date must be in {_selectedYear}.";
            return;
        }

        if (freqCode is "MONTHLY" or "SEMI_MONTHLY" && string.IsNullOrEmpty(_genForm.Convention))
        {
            _generateError = "Select a pay date convention before generating.";
            return;
        }

        var usesOffsetModel = freqCode is not ("MONTHLY" or "SEMI_MONTHLY");
        if (_genForm.CutoffOffsetDays < 1 ||
            (usesOffsetModel && _genForm.CutoffOffsetDays >= _genForm.PayDateOffsetDays))
        {
            _generateError = usesOffsetModel
                ? "Cutoff offset must be at least 1 and less than the pay date offset."
                : "Cutoff offset must be at least 1.";
            return;
        }

        _submitting    = true;
        _generateError = null;
        try
        {
            var spans    = ComputePeriodSpans(_genForm.FirstPeriodStart, _selectedYear, freqCode);
            var existing = _yearPeriods.Select(p => p.PeriodNumber).ToHashSet();
            var now      = TemporalContext.GetOperativeNow();
            var today    = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());

            for (int i = 0; i < spans.Count; i++)
            {
                int periodNumber = i + 1;
                if (existing.Contains(periodNumber)) continue;

                var (start, end) = spans[i];
                var payDate      = PayDateComputer.Compute(
                    end, freqCode, _genForm.Convention, _genForm.PayDateOffsetDays);

                var transmission = PayDateComputer.SubtractBankingDays(payDate, 2);
                var rawRunDate   = PayDateComputer.SubtractBankingDays(payDate, _genForm.CalculationLeadDays);
                var afterClose   = PayDateComputer.ShiftForwardToBusinessDay(end.AddDays(1));

                DateOnly cutoff, runDate;
                if (afterClose < rawRunDate)
                {
                    // Normal: the pay date lags the period close enough to place the
                    // input cutoff after the period ends and still calculate beforehand.
                    var rawCutoff  = payDate.AddDays(-_genForm.CutoffOffsetDays);
                    cutoff         = rawCutoff <= end
                        ? afterClose
                        : PayDateComputer.ShiftToBusinessDay(rawCutoff);
                    var minRunDate = PayDateComputer.ShiftForwardToBusinessDay(cutoff.AddDays(1));
                    runDate        = rawRunDate < minRunDate ? minRunDate : rawRunDate;
                }
                else
                {
                    // No-lag period (e.g. semi-monthly / monthly paid on the period-close
                    // date): there is no room after the close, so anchor backward from the
                    // pay date. The calc/run date is the configured banking-day lead before
                    // pay; the cutoff is the configured calendar offset before pay, never
                    // later than the calc date. This keeps the ordering
                    // cutoff <= calc <= transmission <= pay date — the dates never run past
                    // the pay date the way the forward-from-close rule could.
                    runDate = rawRunDate;
                    cutoff  = PayDateComputer.ShiftToBusinessDay(payDate.AddDays(-_genForm.CutoffOffsetDays));
                    if (cutoff > runDate) cutoff = runDate;
                }

                var status       = end < today ? "CLOSED" : "OPEN";

                await ContextRepo.InsertPeriodAsync(new PayrollPeriod
                {
                    PeriodId                  = Guid.NewGuid(),
                    PayrollContextId          = ContextId,
                    PeriodYear                = _selectedYear,
                    PeriodNumber              = periodNumber,
                    PeriodStartDate           = start,
                    PeriodEndDate             = end,
                    PayDate                   = payDate,
                    InputCutoffDate           = cutoff,
                    CalculationDate           = runDate,
                    CorrectionWindowCloseDate = null,
                    FinalizationDate          = null,
                    TransmissionDate          = transmission,
                    CalendarStatus            = status,
                    ParentCalendarEntryId     = null,
                    RootCalendarEntryId       = null,
                    CalendarVersionNumber     = 1,
                    CalendarChangeReasonCode  = null,
                    CreatedBy                 = _currentUserId,
                    CreationTimestamp         = now,
                    LastUpdatedBy             = _currentUserId,
                    LastUpdateTimestamp       = now
                });
            }

            await LoadPeriodsAsync();

            var generated = spans.Count - (int)spans
                .Select((_, i) => i + 1)
                .Count(n => existing.Contains(n));
            await AuditService.LogAsync(new AuditEventRecord(
                EventType:       "CREATE",
                EntityType:      "PayrollPeriod",
                EntityId:        null,
                ModuleName:      "PAYROLL",
                ChangeSummary:   $"Generated {generated} payroll periods for year {_selectedYear} in context {ContextId}",
                ParentEntityType: "PayrollContext",
                ParentEntityId:  ContextId,
                AfterJson:       System.Text.Json.JsonSerializer.Serialize(new
                {
                    year = _selectedYear,
                    periods_generated = generated
                })
            ));

            _showGenerateForm = false;
        }
        catch (Exception ex) { _generateError = ex.Message; }
        finally { _submitting = false; }
    }

    private static string ExtraPeriodPolicyLabel(string policy) => policy switch
    {
        "ADJUST_ALL"    => "Adjust all checks (÷ 27)",
        "EXTRA_SPECIAL" => "Treat 27th as special case",
        "PER_EMPLOYEE"  => "HR decides per employee",
        _               => policy
    };

    private static List<(DateOnly start, DateOnly end)> ComputePeriodSpans(
        DateOnly firstStart, int year, string freqCode)
    {
        var result = new List<(DateOnly, DateOnly)>();
        switch (freqCode)
        {
            case "WEEKLY":
                for (var s = firstStart; s.Year == year; s = s.AddDays(7))
                    result.Add((s, s.AddDays(6)));
                break;
            case "BIWEEKLY":
                for (var s = firstStart; s.Year == year; s = s.AddDays(14))
                    result.Add((s, s.AddDays(13)));
                break;
            case "SEMI_MONTHLY":
                for (int m = 1; m <= 12; m++)
                {
                    result.Add((new DateOnly(year, m, 1), new DateOnly(year, m, 15)));
                    result.Add((new DateOnly(year, m, 16),
                                new DateOnly(year, m, DateTime.DaysInMonth(year, m))));
                }
                break;
            case "MONTHLY":
                for (int m = 1; m <= 12; m++)
                    result.Add((new DateOnly(year, m, 1),
                                new DateOnly(year, m, DateTime.DaysInMonth(year, m))));
                break;
            case "QUARTERLY":
                result.Add((new DateOnly(year, 1,  1), new DateOnly(year, 3,  31)));
                result.Add((new DateOnly(year, 4,  1), new DateOnly(year, 6,  30)));
                result.Add((new DateOnly(year, 7,  1), new DateOnly(year, 9,  30)));
                result.Add((new DateOnly(year, 10, 1), new DateOnly(year, 12, 31)));
                break;
            case "ANNUAL":
                result.Add((new DateOnly(year, 1, 1), new DateOnly(year, 12, 31)));
                break;
        }
        return result;
    }

