    {
        public DateOnly FirstPeriodStart    { get; set; }
        public string   Convention          { get; set; } = "";
        public int      PayDateOffsetDays   { get; set; } = 5;
        public int      CutoffOffsetDays    { get; set; } = 3;
        public int      CalculationLeadDays { get; set; } = 3;
    }
