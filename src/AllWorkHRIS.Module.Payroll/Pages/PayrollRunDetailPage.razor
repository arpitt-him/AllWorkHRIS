@page "/payroll/runs/{RunId:guid}"
@layout PayrollShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PayrollOperator,PayrollAdmin")]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Syncfusion.Blazor.Grids
@using AllWorkHRIS.Core.Lookups
@using AllWorkHRIS.Core.Temporal
@inject IWallClock                      WallClock
@inject IPayrollRunService              RunService
@inject IPayrollContextRepository       ContextRepo
@inject IEmployeePayrollResultRepository ResultRepo
@inject IPersonNameLookup               PersonService
@inject IRunProgressNotifier            ProgressNotifier
@inject NavigationManager               Nav
@inject AuthenticationStateProvider     AuthState
@inject ILookupCache                    LookupCache

<PageTitle>Payroll Run Detail — AllWork HRIS</PageTitle>

<div class="page-container">

    @if (_loading)
    {
        <p class="loading-state">Loading…</p>
    }
    else if (_run is null)
    {
        <div class="alert-error" style="margin-bottom:1rem;">Run not found.</div>
        <a href="/payroll/runs" class="btn-link">← Back to Runs</a>
    }
    else
    {
        <div class="page-header">
            <div>
                <a href="/payroll/runs" class="btn-link" style="font-size:var(--font-size-sm)">← Payroll Runs</a>
                <h2 class="page-title" style="margin-top:var(--space-1)">
                    @(_run.RunDescription ?? $"Run {_run.RunId.ToString()[..8].ToUpper()}")
                </h2>
            </div>
            <span class="badge @GetStatusBadgeClass(_run.RunStatusId)" style="font-size:var(--font-size-base);">
                @GetStatusLabel(_run.RunStatusId)
            </span>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="alert-error" style="margin-bottom:1rem;">@_errorMessage</div>
        }

        @* Tab bar *@
        <div class="tab-bar">
            <button class="tab-item @(_activeTab == "summary"  ? "active" : "")" @onclick='() => _activeTab = "summary"'>Summary</button>
            <button class="tab-item @(_activeTab == "register" ? "active" : "")" @onclick="SwitchToRegisterAsync">Detail</button>
        </div>

        @* ── Summary tab ─────────────────────────────────────────────── *@
        @if (_activeTab == "summary")
        {
            <div class="panel-card" style="margin-bottom:1.5rem;">
                <h3 class="panel-title">Run Details</h3>
                <div class="detail-grid">
                    <div class="detail-field">
                        <span class="detail-label">Run ID</span>
                        <span class="detail-value" style="font-family:monospace;font-size:var(--font-size-sm)">@_run.RunId.ToString()[..8].ToUpper()</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Payroll Context</span>
                        <span class="detail-value">@(_context?.PayrollContextName ?? _run.PayrollContextId.ToString()[..8])</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Period</span>
                        <span class="detail-value">@GetPeriodLabel()</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Pay Date</span>
                        <span class="detail-value">@_run.PayDate.ToString("yyyy-MM-dd")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Run Type</span>
                        <span class="detail-value">
                            @GetRunTypeLabel(_run.RunTypeId)
                            @if (_runScope is not null)
                            {
                                <span class="badge badge-info" style="margin-left:.4rem" title="@_runScope.TriggerReason">Scoped: @_runScope.PopulationCount EE@(_runScope.PopulationCount == 1 ? "" : "s")</span>
                            }
                        </span>
                    </div>
                    @if (_runScope is not null)
                    {
                        <div class="detail-field">
                            <span class="detail-label">Scope Reason</span>
                            <span class="detail-value">@_runScope.TriggerReason</span>
                        </div>
                    }
                    <div class="detail-field">
                        <span class="detail-label">Started</span>
                        <span class="detail-value">@(_run.RunStartTimestamp?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Completed</span>
                        <span class="detail-value">@(_run.RunEndTimestamp?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                    </div>
                </div>
            </div>

            @* Progress panel — visible while a background job is running (CALCULATING or APPROVING) *@
            @if (IsInBackgroundJob(_run.RunStatusId))
            {
                var progress = ProgressNotifier.GetProgress(_run.RunId);
                var progressTitle = _run.RunStatusId == _approvingStatus
                    ? "Approval Progress"
                    : "Calculation Progress";
                <div class="panel-card" style="margin-bottom:1.5rem;">
                    <h3 class="panel-title">@progressTitle</h3>
                    @if (progress is not null)
                    {
                        <div style="margin-bottom:var(--space-3)">
                            <div class="progress-bar-track" style="height:8px;">
                                <div class="progress-bar-fill" style="width:@progress.PercentComplete%"></div>
                            </div>
                        </div>
                        <div style="display:flex;gap:var(--space-6);font-size:var(--font-size-sm);color:#6B7280;">
                            <span>@progress.Processed processed</span>
                            <span>@progress.Failed failed</span>
                            <span>@progress.Total total</span>
                            <span>@progress.PercentComplete%</span>
                        </div>
                        <p style="margin:var(--space-2) 0 0;font-size:var(--font-size-sm);color:#6B7280;">@progress.StatusMessage</p>
                    }
                    else
                    {
                        <p style="font-size:var(--font-size-sm);color:#6B7280;">Waiting for progress data…</p>
                    }
                </div>
            }

            @* Totals summary — only when calculated or later *@
            @if (HasResultsToShow(_run.RunStatusId) && _results.Count > 0)
            {
                <div class="panel-card" style="margin-bottom:1.5rem;">
                    <h3 class="panel-title">Run Totals</h3>
                    @if (_run.RunStatusId == _reversedStatus)
                    {
                        <div style="font-size:var(--font-size-sm);color:#B45309;margin:-4px 0 var(--space-3);">
                            ↩ <strong>Reversed</strong> — these amounts were contra-posted; net effect on YTD is zero.
                            Shown as the historical record of what was reversed.
                        </div>
                    }
                    <div class="detail-grid" style="@(_run.RunStatusId == _reversedStatus ? "opacity:0.55;" : "")">
                        <div class="detail-field">
                            <span class="detail-label">Employees</span>
                            <span class="detail-value">@_results.Count</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Gross Pay</span>
                            <span class="detail-value">@_results.Sum(r => r.GrossPayAmount).ToString("N2")</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Total Deductions</span>
                            <span class="detail-value">@_results.Sum(r => r.TotalDeductionsAmount).ToString("N2")</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Employee Tax</span>
                            <span class="detail-value">@_results.Sum(r => r.TotalEmployeeTaxAmount).ToString("N2")</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Employer Contribution</span>
                            <span class="detail-value">@_results.Sum(r => r.TotalEmployerContributionAmount).ToString("N2")</span>
                        </div>
                        <div class="detail-field">
                            <span class="detail-label">Net Pay</span>
                            <span class="detail-value">@_results.Sum(r => r.NetPayAmount).ToString("N2")</span>
                        </div>
                    </div>
                </div>
            }

            @* Actions *@
            <AuthorizeView Roles="PayrollAdmin">
                <Authorized>
                    <div class="panel-card">
                        <h3 class="panel-title">Actions</h3>
                        @if (_finalizeBlock is not null
                             && (_run.RunStatusId == _calculatedStatus || _run.RunStatusId == _approvedStatus))
                        {
                            <div class="alert-warning" style="margin-bottom:var(--space-3);">@_finalizeBlock</div>
                        }
                        <div class="form-actions">
                            @if (_run.RunStatusId == _calculatedStatus)
                            {
                                <button class="btn-primary" @onclick="ApproveAsync" disabled="@(_submitting || _finalizeBlock is not null)">
                                    @(_submitting ? "Working…" : "Approve")
                                </button>
                            }
                            @if (_run.RunStatusId == _approvedStatus)
                            {
                                <button class="btn-primary" @onclick="ReleaseAsync" disabled="@(_submitting || _finalizeBlock is not null)">
                                    @(_submitting ? "Working…" : "Release")
                                </button>
                                <button class="btn-danger" style="border:1px solid var(--color-danger);border-radius:var(--radius-md);padding:var(--space-2) var(--space-4);"
                                        @onclick="() => { _showReverseConfirm = true; _showReverseEmployees = false; }" disabled="@_submitting">
                                    Reverse Run
                                </button>
                                <button class="btn-secondary" @onclick="BeginReverseEmployees" disabled="@_submitting">
                                    Reverse Employees…
                                </button>
                            }
                            @if (_run.RunStatusId == _draftStatus || _run.RunStatusId == _calculatedStatus)
                            {
                                <button class="btn-danger" style="border:1px solid var(--color-danger);border-radius:var(--radius-md);padding:var(--space-2) var(--space-4);"
                                        @onclick="CancelAsync" disabled="@_submitting">
                                    Cancel Run
                                </button>
                            }
                            @* Recovery affordance: a run parked in an idempotent transient state
                               (APPROVING / RELEASING) can be re-enqueued on demand — the in-UI twin
                               of host-startup recovery, so an operator isn't stuck waiting for a restart. *@
                            @if (IsResumable(_run.RunStatusId))
                            {
                                var processing = IsActivelyProcessing();
                                <button class="btn-primary" @onclick="ResumeAsync" disabled="@(_submitting || processing)">
                                    @(_submitting ? "Working…" : "Resume")
                                </button>
                                <span style="font-size:var(--font-size-sm);color:#6B7280;align-self:center;">
                                    @(processing
                                        ? "Processing… Resume becomes available only if the run stalls."
                                        : "Re-runs the background job for a run stuck in this state.")
                                </span>
                            }
                            @if (_run.RunStatusId != _draftStatus
                                 && _run.RunStatusId != _calculatedStatus
                                 && _run.RunStatusId != _approvedStatus
                                 && !IsResumable(_run.RunStatusId))
                            {
                                <span style="font-size:var(--font-size-sm);color:#6B7280;">No actions available for this status.</span>
                            }
                        </div>

                        @* ADR-027 — reverse an approved run (inline confirm + required reason) *@
                        @if (_showReverseConfirm)
                        {
                            <div style="margin-top:var(--space-3);border-top:1px solid #e5e7eb;padding-top:var(--space-3)">
                                <div style="font-weight:var(--font-weight-medium);margin-bottom:var(--space-2)">Reverse this approved run?</div>
                                <div style="font-size:var(--font-size-sm);color:#6B7280;max-width:640px;margin-bottom:var(--space-2)">
                                    Contra-posts every employee result's accumulator impacts (YTD restored to pre-run) and
                                    marks the run <strong>Reversed</strong>; the period reopens for a fresh Regular run.
                                    Originals are kept, not deleted. Use this for an approved-but-not-yet-released run.
                                </div>
                                <textarea @bind="_reverseReason" rows="2" placeholder="Reason (required)"
                                          style="width:100%;max-width:640px;margin-bottom:var(--space-2)"></textarea>
                                <div class="form-actions">
                                    <button class="btn-danger" style="border:1px solid var(--color-danger);border-radius:var(--radius-md);padding:var(--space-2) var(--space-4);"
                                            @onclick="ReverseAsync" disabled="@(_submitting || string.IsNullOrWhiteSpace(_reverseReason))">
                                        @(_submitting ? "Reversing…" : "Confirm Reverse")
                                    </button>
                                    <button class="btn-secondary" @onclick="@(() => { _showReverseConfirm = false; _reverseReason = string.Empty; })">Cancel</button>
                                </div>
                            </div>
                        }

                        @* ADR-027 2a.3 — reverse selected employees (per-EE; the run stays approved for the rest) *@
                        @if (_showReverseEmployees)
                        {
                            <div style="margin-top:var(--space-3);border-top:1px solid #e5e7eb;padding-top:var(--space-3)">
                                <div style="font-weight:var(--font-weight-medium);margin-bottom:var(--space-2)">Reverse selected employees</div>
                                <div style="font-size:var(--font-size-sm);color:#6B7280;max-width:640px;margin-bottom:var(--space-2)">
                                    Contra-posts only the selected employees' results (YTD restored to pre-run), marks them
                                    <strong>Reversed</strong>, and returns their hours to the pool. The run stays
                                    <strong>Approved</strong> for everyone else.
                                </div>
                                <div style="max-height:240px;overflow:auto;border:1px solid #E5E7EB;border-radius:4px;padding:var(--space-2);margin-bottom:var(--space-2);max-width:480px">
                                    @foreach (var r in _results.Where(r => r.ResultStatusId == _approvedResultStatus))
                                    {
                                        <label style="display:flex;align-items:center;gap:8px;padding:2px 0;font-size:var(--font-size-sm)">
                                            <input type="checkbox" checked="@_selectedReverseEmps.Contains(r.EmploymentId)"
                                                   @onchange="e => ToggleReverseEmp(r.EmploymentId, (bool)e.Value!)" />
                                            @GetEmployeeName(r.EmploymentId)
                                        </label>
                                    }
                                    @if (!_results.Any(r => r.ResultStatusId == _approvedResultStatus))
                                    {
                                        <span style="font-size:var(--font-size-sm);color:#6B7280">No standing (approved) employee results to reverse.</span>
                                    }
                                </div>
                                <textarea @bind="_reverseReason" rows="2" placeholder="Reason (required)"
                                          style="width:100%;max-width:640px;margin-bottom:var(--space-2)"></textarea>
                                <div class="form-actions">
                                    <button class="btn-danger" style="border:1px solid var(--color-danger);border-radius:var(--radius-md);padding:var(--space-2) var(--space-4);"
                                            @onclick="ReverseEmployeesAsync"
                                            disabled="@(_submitting || _selectedReverseEmps.Count == 0 || string.IsNullOrWhiteSpace(_reverseReason))">
                                        @(_submitting ? "Reversing…" : $"Reverse {_selectedReverseEmps.Count} Employee(s)")
                                    </button>
                                    <button class="btn-secondary" @onclick="CancelReverseEmployees">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>
        }

        @* ── Pay Register tab ─────────────────────────────────────────── *@
        @if (_activeTab == "register")
        {
            @if (_registerLoading)
            {
                <p class="loading-state">Loading pay register…</p>
            }
            else if (_results.Count == 0)
            {
                <p class="empty-state">No employee results available yet.</p>
            }
            else
            {
                <SfGrid DataSource="@_results" AllowSorting="true" AllowPaging="true" CssClass="e-gridhover">
                    <GridPageSettings PageSize="25" />
                    <GridColumns>
                        <GridColumn Field="EmploymentId" HeaderText="Employee" Width="180">
                            <Template>
                                @{ var r = (EmployeePayrollResult)context; }
                                @GetEmployeeName(r.EmploymentId)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="PayPeriodStartDate" HeaderText="Pay Period" Width="130">
                            <Template>
                                @{ var r = (EmployeePayrollResult)context; }
                                @r.PayPeriodStartDate.ToString("MM/dd")–@r.PayPeriodEndDate.ToString("MM/dd")
                            </Template>
                        </GridColumn>
                        <GridColumn Field="GrossPayAmount" HeaderText="Gross Pay" Width="110"
                                    TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="TotalDeductionsAmount" HeaderText="Deductions" Width="110"
                                    TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="TotalEmployeeTaxAmount" HeaderText="Emp Tax" Width="100"
                                    TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="TotalEmployerContributionAmount" HeaderText="Er Contrib" Width="110"
                                    TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="NetPayAmount" HeaderText="Net Pay" Width="110"
                                    TextAlign="TextAlign.Right" Format="N2" />
                        <GridColumn Field="ResultStatusId" HeaderText="Status" Width="120"
                                    TextAlign="TextAlign.Center" HeaderTextAlign="TextAlign.Center">
                            <Template>
                                @{ var r = (EmployeePayrollResult)context; }
                                <span class="badge @GetResultStatusClass(r.ResultStatusId)">@GetResultStatusLabel(r.ResultStatusId)</span>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                    <GridAggregates>
                        <GridAggregate>
                            <GridAggregateColumns>
                                <GridAggregateColumn Field="EmploymentId" Type="AggregateType.Count">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">Totals (@agg.Count employees)</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                                <GridAggregateColumn Field="GrossPayAmount" Type="AggregateType.Sum" Format="N2">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">@agg.Sum</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                                <GridAggregateColumn Field="TotalDeductionsAmount" Type="AggregateType.Sum" Format="N2">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">@agg.Sum</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                                <GridAggregateColumn Field="TotalEmployeeTaxAmount" Type="AggregateType.Sum" Format="N2">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">@agg.Sum</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                                <GridAggregateColumn Field="TotalEmployerContributionAmount" Type="AggregateType.Sum" Format="N2">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">@agg.Sum</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                                <GridAggregateColumn Field="NetPayAmount" Type="AggregateType.Sum" Format="N2">
                                    <FooterTemplate>
                                        @{ var agg = (AggregateTemplateContext)context; }
                                        <span style="font-weight:600">@agg.Sum</span>
                                    </FooterTemplate>
                                </GridAggregateColumn>
                            </GridAggregateColumns>
                        </GridAggregate>
                    </GridAggregates>
                </SfGrid>
            }
        }
    }

</div>

@code {
    [Parameter] public Guid RunId { get; set; }

    private PayrollRun?            _run;
    private RunScope?             _runScope;   // Phase 12.6 — present for a scoped/targeted run
    private PayrollContext?        _context;
    private PayrollPeriod?         _period;
    private List<EmployeePayrollResult> _results = [];
    private Dictionary<Guid, string>   _names   = new();

    private bool    _loading        = true;
    private bool    _registerLoading;
    private bool    _submitting;
    private string? _errorMessage;
    private string? _finalizeBlock;   // ADR-027 D8: ordered-commit block reason (null = free to proceed)
    private string  _activeTab      = "summary";
    private Guid    _currentUserId;

    private PeriodicTimer?           _pollTimer;
    private CancellationTokenSource? _pollCts;

    // Run-status ids resolved once via ILookupCache (ADR-017 / Phase 12.5.3).
    // Codes are the stable contract; the auto-incremented ids are an internal
    // detail of the seed and must not be hard-coded in conditionals.
    private int _draftStatus, _calculatingStatus, _calculatedStatus,
                _approvingStatus, _approvedStatus, _releasingStatus, _reversedStatus;

    // Label/badge resolution by id, code-keyed so it survives seed reordering
    // (ADR-017 / Phase 12.5.3). ids are an auto-incremented internal detail.
    private Dictionary<int, LookupEntry> _statusById       = new();
    private Dictionary<int, LookupEntry> _resultStatusById = new();

    // Drives the progress panel — only CALCULATING and APPROVING emit progress
    // frames worth charting. RELEASING is a fast status flip with no frames.
    private bool IsInBackgroundJob(int? statusId)
        => statusId == _calculatingStatus || statusId == _approvingStatus;

    // Drives auto-refresh polling: any transient state the background job will
    // move off of. RELEASING is included here (but not above) so the page
    // self-advances to RELEASED instead of stalling on a stale "Releasing"
    // frame the way it did before Phase 12.5.x.
    private bool IsTransient(int? statusId)
        => statusId == _calculatingStatus
           || statusId == _approvingStatus
           || statusId == _releasingStatus;

    // A run parked in an idempotent transient state can be re-enqueued from the
    // UI (Phase 12.5.x). CALCULATING is excluded — it is not idempotent and a
    // re-run would orphan a partial result set (matches recovery's fail-it rule).
    private bool IsResumable(int? statusId)
        => statusId == _approvingStatus || statusId == _releasingStatus;

    // The background job is genuinely mid-flight when its progress is fresh and not yet complete.
    // Resume is a recovery affordance for a *stalled* run, so it stays disabled while work is
    // actively streaming — and re-enables only once progress goes stale (job died) or hits 100%
    // without the status flipping (the classic stuck-at-the-finish case).
    private bool IsActivelyProcessing()
    {
        if (_run is null) return false;
        var pr = ProgressNotifier.GetProgress(_run.RunId);
        if (pr is null || pr.PercentComplete >= 100) return false;
        return (WallClock.UtcNow - pr.UpdatedAt) < TimeSpan.FromSeconds(15);
    }

    // Results exist (and are viewable) once the run has moved past CALCULATING.
    private bool HasResultsToShow(int? statusId)
        => statusId is not null
           && statusId != _draftStatus
           && statusId != _calculatingStatus;

    protected override async Task OnInitializedAsync()
    {
        int Status(string code) => LookupCache.GetId(LookupTables.RunStatus, code);
        _draftStatus       = Status("DRAFT");
        _calculatingStatus = Status("CALCULATING");
        _calculatedStatus  = Status("CALCULATED");
        _approvingStatus   = Status("APPROVING");
        _approvedStatus    = Status("APPROVED");
        _releasingStatus   = Status("RELEASING");
        _reversedStatus    = Status("REVERSED");
        _statusById        = LookupCache.GetAll(LookupTables.RunStatus).ToDictionary(e => e.Id);
        _resultStatusById  = LookupCache.GetAll(LookupTables.EmployeeResultStatus).ToDictionary(e => e.Id);
        _approvedResultStatus = LookupCache.GetId(LookupTables.EmployeeResultStatus, "APPROVED");

        var auth = await AuthState.GetAuthenticationStateAsync();
        var sub  = auth.User.FindFirst("sub")?.Value;
        _currentUserId = Guid.TryParse(sub, out var g) ? g : Guid.Empty;

        await LoadRunAsync();
    }

    private async Task LoadRunAsync()
    {
        _loading = true;
        _run = await RunService.GetRunByIdAsync(RunId);
        if (_run is not null)
        {
            _context = await ContextRepo.GetByIdAsync(_run.PayrollContextId);
            _period  = await ContextRepo.GetPeriodByIdAsync(_run.PeriodId);

            _runScope = _run.RunScopeId is Guid sid ? await RunService.GetRunScopeAsync(sid) : null;

            // ADR-027 D8: is this run blocked from its next finalize step by an earlier-pay-date run?
            _finalizeBlock = await RunService.GetOrderedCommitBlockAsync(RunId);

            if (HasResultsToShow(_run.RunStatusId))
                await LoadResultsAsync();

            if (IsTransient(_run.RunStatusId))
                StartPolling();
        }
        _loading = false;
    }

    private async Task LoadResultsAsync()
    {
        var results = await ResultRepo.GetByRunIdAsync(RunId);
        _results = [.. results];

        if (_results.Count > 0)
        {
            var ids = _results.Select(r => r.EmploymentId).Distinct();
            _names  = await PersonService.GetNamesByEmploymentIdsAsync(ids);
        }
    }

    private async Task SwitchToRegisterAsync()
    {
        _activeTab = "register";
        if (_results.Count == 0 && HasResultsToShow(_run?.RunStatusId))
        {
            _registerLoading = true;
            await LoadResultsAsync();
            _registerLoading = false;
        }
    }

    private async Task ApproveAsync()
    {
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.ApproveRunAsync(new ApprovePayrollRunCommand
                { RunId = RunId, ApprovedBy = _currentUserId });
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task ReleaseAsync()
    {
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.ReleaseRunAsync(new ReleasePayrollRunCommand
                { RunId = RunId, ReleasedBy = _currentUserId });
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task ResumeAsync()
    {
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.ResumeRunAsync(new ResumePayrollRunCommand
                { RunId = RunId, ResumedBy = _currentUserId });
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task CancelAsync()
    {
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.CancelRunAsync(new CancelPayrollRunCommand
                { RunId = RunId, CancelledBy = _currentUserId, Reason = "Cancelled via detail page" });
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    // ADR-027 — reverse an approved run (delegates to the correction service via the run service).
    private bool   _showReverseConfirm;
    private string _reverseReason = string.Empty;

    // ADR-027 2a.3 — reverse selected employees (per-EE).
    private bool          _showReverseEmployees;
    private HashSet<Guid> _selectedReverseEmps = [];
    private int           _approvedResultStatus;

    private void BeginReverseEmployees()
    {
        _selectedReverseEmps  = [];
        _reverseReason        = string.Empty;
        _showReverseConfirm   = false;   // mutually exclusive with the whole-run confirm
        _showReverseEmployees = true;
    }

    private void CancelReverseEmployees()
    {
        _showReverseEmployees = false;
        _selectedReverseEmps  = [];
        _reverseReason        = string.Empty;
    }

    private void ToggleReverseEmp(Guid employmentId, bool selected)
    {
        if (selected) _selectedReverseEmps.Add(employmentId);
        else          _selectedReverseEmps.Remove(employmentId);
    }

    private async Task ReverseEmployeesAsync()
    {
        if (_selectedReverseEmps.Count == 0 || string.IsNullOrWhiteSpace(_reverseReason)) return;
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.ReverseEmploymentResultsAsync(new ReverseEmploymentResultsCommand
                { RunId = RunId, EmploymentIds = _selectedReverseEmps.ToList(), ReversedBy = _currentUserId, Reason = _reverseReason.Trim() });
            _showReverseEmployees = false;
            _selectedReverseEmps  = [];
            _reverseReason        = string.Empty;
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task ReverseAsync()
    {
        if (string.IsNullOrWhiteSpace(_reverseReason)) return;
        _submitting   = true;
        _errorMessage = null;
        try
        {
            await RunService.ReverseRunAsync(new ReversePayrollRunCommand
                { RunId = RunId, ReversedBy = _currentUserId, Reason = _reverseReason.Trim() });
            _showReverseConfirm = false;
            _reverseReason      = string.Empty;
            await LoadRunAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
        finally { _submitting = false; }
    }

    private void StartPolling()
    {
        if (_pollCts is not null) return;
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _pollTimer.WaitForNextTickAsync(ct))
            {
                _run = await RunService.GetRunByIdAsync(RunId);
                await InvokeAsync(StateHasChanged);
                if (!IsTransient(_run?.RunStatusId))
                {
                    if (HasResultsToShow(_run?.RunStatusId))
                        await LoadResultsAsync();
                    _pollCts?.Cancel();
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally { _pollTimer?.Dispose(); _pollTimer = null; }
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
    }

    private string GetEmployeeName(Guid employmentId)
        => _names.TryGetValue(employmentId, out var n) ? n : employmentId.ToString()[..8];

    private string GetPeriodLabel() =>
        _period is null
            ? _run!.PeriodId.ToString()[..8]
            : $"{_period.PeriodYear} P{_period.PeriodNumber} ({_period.PeriodStartDate:MM/dd}–{_period.PeriodEndDate:MM/dd})";

    private static string GetRunTypeLabel(int id) => id switch
    {
        1 => "Regular",    2 => "Supplemental", 3 => "Adjustment",
        4 => "Correction", 5 => "Reprocessing",  6 => "Simulation",
        _ => id.ToString()
    };

    private string GetStatusLabel(int id)
        => _statusById.TryGetValue(id, out var e) ? e.Label : id.ToString();

    private string GetStatusBadgeClass(int id)
    {
        if (!_statusById.TryGetValue(id, out var e)) return "badge-neutral";
        return e.Code switch
        {
            "CALCULATING" or "RELEASING" or "APPROVING" => "badge-info",
            "CALCULATED" or "APPROVED"                  => "badge-teal",
            "RELEASED"                                  => "badge-success",
            "UNDER_REVIEW"                              => "badge-warning",
            "REVERSED"                                  => "badge-warning",
            "FAILED"                                    => "badge-error",
            _                                           => "badge-neutral"
        };
    }

    private string GetResultStatusLabel(int id)
        => _resultStatusById.TryGetValue(id, out var e) ? e.Label : id.ToString();

    private string GetResultStatusClass(int id)
    {
        if (!_resultStatusById.TryGetValue(id, out var e)) return "badge-neutral";
        return e.Code switch
        {
            "IN_PROGRESS" => "badge-info",
            "FAILED"      => "badge-error",
            _             => "badge-neutral"
        };
    }
}
