    private string FamilyItemClass(AccumulatorFamilyListItem f) =>
        _selectedFamily?.FamilyId == f.FamilyId ? "family-item family-item--active" : "family-item";

    // Category chip per family. Tax families are flagged generically (is_tax_related);
    // others get a per-family label so the meaning is honest (Retirement reads
    // "RETIREMENT", not its raw DEDUCTION result class). New capped-deduction families
    // (e.g. HSA / FSA — see ToDo) should add their own case here.
    private static (string Label, string Css) FamilyBadge(AccumulatorFamilyListItem fam)
    {
        if (fam.IsTaxRelated) return ("TAX", "badge-tax");
        return fam.Code switch
        {
            "GROSS_WAGES" => ("EARNINGS",   "badge-earning"),
            "RETIREMENT"  => ("RETIREMENT", "badge-retirement"),
            _             => ("", "")
        };
    }

    private string YearTabClass(AccumulatorYearTab t) =>
        _selectedYear == t.Year ? "year-tab year-tab--active" : "year-tab";

    private Guid EntityId => SessionState.SelectedLegalEntityId!.Value;

    private static string Fmt(decimal v) =>
        v < 0 ? $"({Math.Abs(v):N2})" : v.ToString("N2");

    // ── CSV exports ─────────────────────────────────────────────────────────────

    private async Task ExportFamilyBalancesCsvAsync()
    {
        if (_selectedFamily is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Employee #,Employee,YTD Balance,Cap,Amount Left to Cap,Last Updated");
        foreach (var r in _employeeBalances)
        {
            var capStr = r.CapAmount.HasValue ? r.CapAmount.Value.ToString("F2") : "";
            var remStr = r.CapAmount.HasValue ? (r.CapAmount.Value - r.YtdBalance).ToString("F2") : "";
            sb.AppendLine(string.Join(",",
                Csv(r.EmployeeNumber),
                Csv(r.EmployeeName),
                r.YtdBalance.ToString("F2"),
                capStr,
                remStr,
                r.LastUpdated.ToString("yyyy-MM-dd")));
        }
        await DownloadCsvAsync($"accumulators-family-{_selectedFamily.Code}-{_selectedYear}.csv", sb.ToString());
    }

    private async Task ExportPeriodClosingBalancesCsvAsync()
    {
        if (_selectedFamily is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Period,Reset Date,Closing Balance,Opened By,Notes");
        foreach (var h in _resetHistory)
            sb.AppendLine($"{h.BoundaryYear},{h.ResetDate:yyyy-MM-dd},{h.ClosingBalance:F2},{h.OpenedBy},{(h.Notes ?? "").Replace(',', ';')}");
        await DownloadCsvAsync($"accumulators-reset-history-{_selectedFamily.Code}.csv", sb.ToString());
    }

    private async Task ExportEmployeeSummaryCsvAsync()
    {
        if (_selectedEmployee is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Family,Period Type,Current Period,YTD Balance,Cap,Amount Left to Cap");
        foreach (var r in _employeeSummary)
        {
            var capStr = r.CapAmount.HasValue ? r.CapAmount.Value.ToString("F2") : "";
            var remStr = r.CapAmount.HasValue ? (r.CapAmount.Value - r.YtdBalance).ToString("F2") : "";
            sb.AppendLine(string.Join(",",
                Csv(r.FamilyLabel),
                Csv(r.ResetType),
                r.CurrentYear,
                r.YtdBalance.ToString("F2"),
                capStr,
                remStr));
        }
        await DownloadCsvAsync($"accumulators-employee-{_selectedEmployee.EmployeeNumber}-{_employeeYear}.csv", sb.ToString());
    }

    private async Task ExportEmployeeImpactTrailCsvAsync()
    {
        if (_selectedEmployee is null || _drillFamily is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Run Date,Run,Component,Impact Type,Delta,Running Balance,Retroactive,Reversal,Correction,Notes");
        foreach (var r in _drillImpacts)
        {
            sb.AppendLine(string.Join(",",
                r.RunDate.ToString("yyyy-MM-dd"),
                Csv(r.RunLabel),
                Csv(r.ComponentName),
                Csv(r.ImpactType),
                r.DeltaAmount.ToString("F2"),
                r.RunningBalance.ToString("F2"),
                r.IsRetroactive ? "Y" : "",
                r.IsReversal    ? "Y" : "",
                r.IsCorrection  ? "Y" : "",
                Csv(r.Notes ?? "")));
        }
        await DownloadCsvAsync(
            $"accumulators-impact-trail-{_selectedEmployee.EmployeeNumber}-{_drillFamily.FamilyLabel.Replace(' ', '-')}-{_employeeYear}.csv",
            sb.ToString());
    }

