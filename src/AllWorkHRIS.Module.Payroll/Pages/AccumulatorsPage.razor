        var sb = new StringBuilder();
        sb.AppendLine("Run Date\tRun\tComponent\tImpact Type\tDelta\tRunning Balance\tRetroactive\tReversal\tCorrection\tNotes");
        foreach (var r in _drillImpacts)
        {
            sb.AppendLine(string.Join('\t',
                r.RunDate.ToString("yyyy-MM-dd"),
                Tsv(r.RunLabel),
                Tsv(r.ComponentName),
                Tsv(r.ImpactType),
                r.DeltaAmount.ToString("F2"),
                r.RunningBalance.ToString("F2"),
                r.IsRetroactive ? "Y" : "",
                r.IsReversal    ? "Y" : "",
                r.IsCorrection  ? "Y" : "",
                Tsv(r.Notes ?? "")));
        }
        await JS.InvokeVoidAsync("allworkClipboard.copy", sb.ToString());
        _impactTrailCopiedRecent = true;
        StateHasChanged();
        await Task.Delay(1800);
        _impactTrailCopiedRecent = false;
    }

    // TSV-safe: neutralise tabs/newlines inside string fields so Excel doesn't
    // mis-parse them as cell/row delimiters on paste.
    private static string Tsv(string? s) =>
        (s ?? "").Replace('\t', ' ').Replace('\r', ' ').Replace('\n', ' ');

    // CSV-safe quote: wraps in double quotes if the value contains a comma,
    // quote, or newline; escapes embedded quotes by doubling them.
    private static string Csv(string s)
    {
        if (string.IsNullOrEmpty(s)) return string.Empty;
        if (s.IndexOfAny([',', '"', '\n', '\r']) < 0) return s;
        return "\"" + s.Replace("\"", "\"\"") + "\"";
    }

    private async Task DownloadCsvAsync(string filename, string content)
    {
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("allworkFiles.downloadBase64", filename, "text/csv", base64);
    }
