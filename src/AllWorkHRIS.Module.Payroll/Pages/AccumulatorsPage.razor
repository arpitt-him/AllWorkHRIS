<style>
    /* ── KI-1 ghost-scrollbar fix (paging + inline DetailTemplate) ──────────────
       Fixed-px column widths flip Syncfusion into strict table-layout and reserve an
       inert vertical scrollbar gutter. Suppress it here; a real horizontal scrollbar
       still works on overflow. MUST be inline (page body) so these rules win Syncfusion's
       source-order cascade — do not move to app.css. Scoped to the .aw-paged-detail-grid
       wrapper (the by-family balance grid's panel-card). See memory
       project-accumulators-grid-scrollbar-issue. */
    .aw-paged-detail-grid .e-gridcontent,
    .aw-paged-detail-grid .e-content {
        overflow-x: visible !important;
        overflow-y: hidden !important;
    }
    .aw-paged-detail-grid .e-gridheader {
        padding-right: 0 !important;
    }
    .aw-paged-detail-grid .e-detailrow,
    .aw-paged-detail-grid .e-detailcell {
        overflow: visible !important;
    }
    .aw-paged-detail-grid .e-grid {
        overflow-x: auto !important;
    }

    /* ── Page wrapper (fixed to viewport, no browser scroll) ────── */
    .accum-page {
        display: flex;
        flex-direction: column;
        /* Natural flow inside the scrolling .payroll-shell__body; the tab strip is a
           fixed sibling above, so there's no sticky gap / scroll-through. The page's
