@page "/payroll/runs"
@layout PayrollShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PayrollOperator,PayrollAdmin")]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using AllWorkHRIS.Core.Lookups
@inject IPayrollRunService          RunService
@inject IPayrollContextRepository   ContextRepo
@inject IHrisSessionState           SessionState
@inject ITemporalContext            TemporalContext
@inject IRunProgressNotifier        ProgressNotifier
@inject NavigationManager           Nav
@inject AuthenticationStateProvider AuthState
@inject ILookupCache                LookupCache

<PageTitle>Payroll Runs — AllWork HRIS</PageTitle>

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">Payroll Runs</h2>
        <AuthorizeView Roles="PayrollAdmin">
            <Authorized>
                <button class="btn-primary" @onclick="ToggleNewRunForm">+ New Run</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @* Stat Cards *@
    <div class="stat-cards">
        <div class="stat-card stat-card--open-runs">
            <span class="stat-label">Open Runs</span>
            <span class="stat-value">@_openRunCount</span>
        </div>
        <div class="stat-card stat-card--pending">
            <span class="stat-label">Pending Approval</span>
            <span class="stat-value">@_pendingApprovalCount</span>
        </div>
        <div class="stat-card stat-card--last-pay">
            <span class="stat-label">Last Pay Date</span>
            <span class="stat-value">@(_lastReleasedDate?.ToString("yyyy-MM-dd") ?? "—")</span>
        </div>
        <div class="stat-card stat-card--next-pay">
            <span class="stat-label">Next Open Pay Date</span>
            <span class="stat-value">@(_nextPayDate?.ToString("yyyy-MM-dd") ?? "—")</span>
        </div>
    </div>

    <div class="filter-row">
        @if (_contexts.Count > 1)
        {
            <label class="filter-label">Payroll Context</label>
            <SfDropDownList TValue="Guid" TItem="PayrollContext"
                            DataSource="@_contexts"
                            @bind-Value="_selectedContextId"
                            Width="270px">
                <DropDownListFieldSettings Value="PayrollContextId" Text="PayrollContextName" />
                <DropDownListEvents TValue="Guid" TItem="PayrollContext"
                                    ValueChange="OnContextChangedAsync" />
            </SfDropDownList>
        }
        <label class="filter-label">Status</label>
        <SfDropDownList TValue="string" TItem="FilterOption"
                        DataSource="@_statusOptions"
                        @bind-Value="_statusFilter"
                        Width="160px">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </div>

    @* New Run Form *@
    @if (_showNewRunForm)
    {
        <div class="panel-card" style="margin-bottom:1.5rem;">
            <h3 class="panel-title">Initiate Payroll Run</h3>
            <div class="form-grid form-grid-4">
                <div class="form-field">
                    <label class="form-label">Payroll Context</label>
                    <SfDropDownList TValue="Guid" TItem="PayrollContext"
                                    DataSource="@_contexts"
                                    @bind-Value="_newRun.ContextId"
                                    Width="100%">
                        <DropDownListFieldSettings Value="PayrollContextId" Text="PayrollContextName" />
                        <DropDownListEvents TValue="Guid" TItem="PayrollContext"
                                            ValueChange="OnNewRunContextChangedAsync" />
                    </SfDropDownList>
                </div>
                <div class="form-field">
                    <label class="form-label">Pay Period</label>
                    <SfDropDownList TValue="Guid" TItem="PeriodOption"
                                    DataSource="@PeriodOptions"
                                    @bind-Value="_newRun.PeriodId"
                                    Width="100%"
                                    Placeholder="— select —">
                        <DropDownListFieldSettings Value="PeriodId" Text="PeriodLabel" />
                        <DropDownListEvents TValue="Guid" TItem="PeriodOption"
                                            ValueChange="OnNewRunPeriodChangedAsync" />
                    </SfDropDownList>
                </div>
                <div class="form-field">
                    <label class="form-label">Run Type</label>
                    <SfDropDownList TValue="int" TItem="IntOption"
                                    DataSource="@_runTypeOptions"
                                    @bind-Value="_newRun.RunTypeId"
                                    Width="100%">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                        <DropDownListEvents TValue="int" TItem="IntOption"
                                            ValueChange="OnRunTypeChangedAsync" />
                    </SfDropDownList>
                </div>
                <div class="form-field">
                    <label class="form-label">Description (optional)</label>
                    <SfTextBox @bind-Value="_newRun.Description"
                               Placeholder="e.g. April Biweekly" />
                </div>
            </div>

            @* Phase 12.6 — targeted population for non-Regular runs. A Regular run always pays the
               full context (no picker); Supplemental/Adjustment/Correction runs target a subset. *@
            @if (!IsRegularType && _newRun.PeriodId != Guid.Empty)
            {
                <div class="scoped-run-section" style="margin-top:1rem; border-top:1px solid var(--color-border, #e5e7eb); padding-top:1rem;">
                    <div class="form-field" style="max-width:520px;">
                        <label class="form-label">Trigger reason <span style="color:var(--color-danger,#dc2626)">*</span></label>
                        <SfTextBox @bind-Value="_newRun.TriggerReason"
                                   Placeholder="Why this targeted run? e.g. catch up 2 EEs missed in the Regular run"
                                   Width="100%" />
                    </div>
                    <div style="display:flex; align-items:center; gap:1rem; margin:0.75rem 0 0.5rem;">
                        <span class="form-label" style="margin:0;">Target employees <span style="color:var(--color-danger,#dc2626)">*</span></span>
                        <button class="btn-secondary" type="button" @onclick="CarryOverExceptionsAsync" disabled="@(_carryoverCount == 0)">
                            Carry over this period's exceptions@(_carryoverCount > 0 ? $" ({_carryoverCount})" : "")
                        </button>
                        <span class="text-muted text-sm">@_targetableEmployees.Count active employee(s) in this context</span>
                    </div>
                    <SfGrid @ref="_targetGrid" TValue="RunTargetEmployee" DataSource="@_targetableEmployees"
                            AllowPaging="true" AllowSorting="true" Height="260" CssClass="e-gridhover">
                        <GridPageSettings PageSize="10" />
                        <GridSelectionSettings Type="SelectionType.Multiple" CheckboxOnly="true" PersistSelection="true" />
                        <GridColumns>
                            <GridColumn Type="ColumnType.CheckBox" Width="50" />
                            <GridColumn Field="@nameof(RunTargetEmployee.EmploymentId)" IsPrimaryKey="true" Visible="false" />
                            <GridColumn Field="@nameof(RunTargetEmployee.EmployeeNumber)" HeaderText="EE #" Width="120" />
                            <GridColumn Field="@nameof(RunTargetEmployee.Name)" HeaderText="Employee">
                                <Template>
                                    @{ var emp = (RunTargetEmployee)context; }
                                    @emp.Name
                                    @if (_alreadyPaidIds.Contains(emp.EmploymentId))
                                    {
                                        <span class="already-paid-badge" title="Already has approved pay for this period — re-paying would double-count. Use a correction instead.">Already paid</span>
                                    }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                    @if (_alreadyPaidIds.Count > 0)
                    {
                        <p class="text-muted text-sm" style="margin:.4rem 0 0;">
                            Employees marked <span class="already-paid-badge">Already paid</span> already have approved pay for this period.
                            A scoped run is additive, so selecting them would pay them again — deselect them (re-paying needs a correction).
                        </p>
                    }
                </div>
            }

            @if (_newRunError is not null)
            {
                <div class="alert-error">@_newRunError</div>
            }
            @if (_confirmEarlyRun)
            {
                <div class="early-run-confirm">
                    <p class="early-run-confirm__msg">
                        The pay date for this period is <strong>@_selectedPeriod!.PayDate.ToString("yyyy-MM-dd")</strong>,
                        which has not yet been reached. Payroll runs are sometimes initiated early to allow
                        time for ACH processing, but please confirm this is intentional before proceeding.
                    </p>
                    <div class="early-run-confirm__actions">
                        <button class="btn-primary" @onclick="ConfirmEarlyRunAsync" disabled="@_submitting">
                            @(_submitting ? "Initiating…" : "Yes, initiate early")
                        </button>
                        <button class="btn-secondary" @onclick="CancelEarlyRun">Go back</button>
                    </div>
                </div>
            }
            else
            {
                <div class="form-actions">
                    <button class="btn-primary" @onclick="InitiateRunAsync" disabled="@_submitting">
                        @(_submitting ? "Initiating…" : "Initiate Run")
                    </button>
                    <button class="btn-secondary" @onclick="ToggleNewRunForm">Cancel</button>
                </div>
            }
        </div>
    }

    @if (_errorMessage is not null)
    {
        <div class="alert-error" style="margin-bottom:1rem;">@_errorMessage</div>
    }

    @* Run list *@
    @if (_loading)
    {
        <p class="loading-state">Loading…</p>
    }
    else if (_filteredRuns.Count == 0)
    {
        <p class="empty-state">No payroll runs match the selected filter.</p>
    }
    else
    {
        <SfGrid DataSource="@_filteredRuns.OrderByDescending(r => r.CreationTimestamp).ToList()"
                AllowSorting="true" AllowPaging="true" CssClass="e-gridhover">
            <GridPageSettings PageSize="25" />
            <GridColumns>
                <GridColumn Field="RunDescription" HeaderText="Description" Width="220">
                    <Template>
                        @{ var run = (PayrollRun)context; }
                        <a href="/payroll/runs/@run.RunId" class="table-link">
                            @(run.RunDescription ?? $"Run {run.RunId.ToString()[..8].ToUpper()}")
                        </a>
                    </Template>
                </GridColumn>
                <GridColumn Field="PeriodId" HeaderText="Period" Width="180">
                    <Template>
                        @{ var run = (PayrollRun)context; }
                        @GetPeriodLabel(run.PeriodId)
                    </Template>
                </GridColumn>
                <GridColumn Field="PayDate" HeaderText="Pay Date" Width="120" Format="MM/dd/yyyy" />
                <GridColumn Field="RunTypeId" HeaderText="Type" Width="170">
                    <Template>
                        @{ var run = (PayrollRun)context; }
                        <span class="badge badge-neutral">@GetRunTypeLabel(run.RunTypeId)</span>
                        @if (run.RunScopeId is not null)
                        {
                            <span class="badge badge-info" title="Targeted run — pays a selected subset of employees">Scoped</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="RunStatusId" HeaderText="Status" Width="180">
                    <Template>
                        @{
                            var run = (PayrollRun)context;
                            var progress = ProgressNotifier.GetProgress(run.RunId);
                        }
                        <span class="badge @GetStatusBadgeClass(run.RunStatusId)">
                            @GetStatusLabel(run.RunStatusId)
                        </span>
                        @if ((run.RunStatusId == _calculatingStatus || run.RunStatusId == _approvingStatus) && progress is not null)
                        {
                            <div class="progress-mini">
                                <div class="progress-bar-track">
                                    <div class="progress-bar-fill" style="width:@progress.PercentComplete%"></div>
                                </div>
                                <span class="progress-text">@progress.Processed/@progress.Total</span>
                            </div>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="160" TextAlign="TextAlign.Right">
                    <Template>
                        @{ var run = (PayrollRun)context; }
                        <div class="action-cell">
                            <a href="/payroll/runs/@run.RunId" class="btn-link">View</a>
                            @if (run.RunStatusId == _calculatedStatus)
                            {
                                <AuthorizeView Roles="PayrollAdmin" Context="auth">
                                    <Authorized>
                                        <button class="btn-link" @onclick="() => ApproveRunAsync(run.RunId)">Approve</button>
                                    </Authorized>
                                </AuthorizeView>
                            }
                            @if (run.RunStatusId == _draftStatus || run.RunStatusId == _calculatedStatus)
                            {
                                <AuthorizeView Roles="PayrollAdmin" Context="auth">
                                    <Authorized>
                                        <button class="btn-link btn-danger" @onclick="() => CancelRunAsync(run.RunId)">Cancel</button>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }

</div>

<style>
    .stat-card--open-runs { border-top: 4px solid var(--module-payroll); }
    .stat-card--pending   { border-top: 4px solid var(--color-warning); }
    .stat-card--last-pay  { border-top: 4px solid var(--color-success); }
    .stat-card--next-pay  { border-top: 4px solid var(--aw-teal); }
    .already-paid-badge {
        display: inline-block; margin-left: .4rem; padding: 1px 7px;
        border-radius: 999px; font-size: .7rem; font-weight: 600;
        background: #fee2e2; color: #991b1b; border: 1px solid #fecaca;
        vertical-align: middle;
    }
</style>

@code {
    private List<PayrollContext>             _allContexts   = [];
    private List<PayrollContext>             _contexts      = [];
    private Guid                             _selectedContextId;
    private List<PayrollRun>                 _runs          = [];
    private Dictionary<Guid, PayrollPeriod>  _periods       = new();
    private List<PayrollPeriod>              _openPeriods   = [];
    private bool                             _loading       = true;
    private bool                             _showNewRunForm;
    private bool                             _confirmEarlyRun;
    private PayrollPeriod?                   _selectedPeriod;
    private bool                             _submitting;
    private string?                          _newRunError;
    private string?                          _errorMessage;
    private NewRunFormModel                  _newRun        = new();
    private PeriodicTimer?                   _pollTimer;
    private CancellationTokenSource?         _pollCts;
    private Guid                             _currentUserId;
    private string                           _statusFilter  = "ACTIVE";

    private record FilterOption(string Value, string Label);
    private static readonly List<FilterOption> _statusOptions =
    [
        new("ACTIVE",    "Active"),
        new("ALL",       "All"),
        new("RELEASED",  "Released"),
        new("CANCELLED", "Cancelled"),
        new("FAILED",    "Failed"),
    ];

    private record IntOption(int Value, string Label);
    // Lookup-driven (ADR-017 A3 — never hard-code lookup ids): the initiation-eligible run types.
    private List<IntOption> _runTypeOptions = [];
    private int             _regularRunTypeId;

    // Phase 12.6 — scoped-run targeting state.
    private List<RunTargetEmployee>     _targetableEmployees = [];
    private SfGrid<RunTargetEmployee>?  _targetGrid;
    private int                         _carryoverCount;
    private bool                        _carryoverUsed;
    private IReadOnlyList<Guid>?        _pendingTargets;
    private HashSet<Guid>               _alreadyPaidIds = [];   // ToDo #43 — paid this period; badged + blocked in the picker
    private bool IsRegularType => _newRun.RunTypeId == _regularRunTypeId;

    private record PeriodOption(Guid PeriodId, string PeriodLabel);
    private List<PeriodOption> PeriodOptions => _openPeriods
        .Select(p => new PeriodOption(p.PeriodId,
            $"{p.PeriodYear} P{p.PeriodNumber} ({p.PeriodStartDate:MM/dd}–{p.PeriodEndDate:MM/dd}, pay {p.PayDate:MM/dd/yyyy})"))
        .ToList();

    // Run-status ids resolved via ILookupCache (ADR-017 / Phase 12.5.3). Codes
    // are the stable contract; ids are an auto-incremented internal detail.
    private int _draftStatus, _calculatingStatus, _calculatedStatus,
                _approvingStatus, _approvedStatus,
                _releasingStatus, _releasedStatus,
                _failedStatus, _cancelledStatus;
    private HashSet<int> _terminalStatuses = new();
    private HashSet<int> _openStatuses     = new();
    private Dictionary<int, LookupEntry> _statusById = new();

    private void ResolveStatusIds()
    {
        int S(string code) => LookupCache.GetId(LookupTables.RunStatus, code);
        _draftStatus       = S("DRAFT");
        _calculatingStatus = S("CALCULATING");
        _calculatedStatus  = S("CALCULATED");
        _approvingStatus   = S("APPROVING");
        _approvedStatus    = S("APPROVED");
        _releasingStatus   = S("RELEASING");
        _releasedStatus    = S("RELEASED");
        _failedStatus      = S("FAILED");
        _cancelledStatus   = S("CANCELLED");
        // ADR-017 §4a: RELEASED is terminal at the run level (no run-level CLOSED).
        _terminalStatuses  = [_releasedStatus, _failedStatus, _cancelledStatus];
        // "Open" = anything from Draft through Approved (i.e., everything pre-Releasing)
        _openStatuses      = [_draftStatus,     S("OPEN"),         _calculatingStatus,
                              _calculatedStatus, S("UNDER_REVIEW"), _approvingStatus,
                              _approvedStatus];
        _statusById = LookupCache.GetAll(LookupTables.RunStatus).ToDictionary(e => e.Id);

        _regularRunTypeId = LookupCache.GetId(LookupTables.RunType, "REGULAR");
        _runTypeOptions = LookupCache.GetAll(LookupTables.RunType)
            .Where(e => e.Code is "REGULAR" or "SUPPLEMENTAL" or "ADJUSTMENT" or "CORRECTION")
            .Select(e => new IntOption(e.Id, e.Label))
            .ToList();
    }

    private List<PayrollRun> _filteredRuns => _statusFilter switch
    {
        "ACTIVE"    => _runs.Where(r => !_terminalStatuses.Contains(r.RunStatusId)).ToList(),
        "RELEASED"  => _runs.Where(r => r.RunStatusId == _releasedStatus).ToList(),
        "CANCELLED" => _runs.Where(r => r.RunStatusId == _cancelledStatus).ToList(),
        "FAILED"    => _runs.Where(r => r.RunStatusId == _failedStatus).ToList(),
        _           => _runs
    };

    private int       _openRunCount         => _runs.Count(r => _openStatuses.Contains(r.RunStatusId));
    private int       _pendingApprovalCount => _runs.Count(r => r.RunStatusId == _calculatedStatus);
    private DateOnly? _lastReleasedDate     => _runs.Where(r => r.RunStatusId == _releasedStatus)
                                                    .Select(r => (DateOnly?)r.PayDate)
                                                    .DefaultIfEmpty(null).Max();
    private DateOnly? _nextPayDate          => _openPeriods.Select(p => (DateOnly?)p.PayDate)
                                                           .DefaultIfEmpty(null).Min();

    protected override async Task OnInitializedAsync()
    {
        ResolveStatusIds();

        var auth = await AuthState.GetAuthenticationStateAsync();
        _currentUserId = Guid.TryParse(auth.User.FindFirst("sub")?.Value, out var g) ? g : Guid.Empty;

        SessionState.OnChanged += HandleEntityChanged;
        _allContexts = (await ContextRepo.GetAllActiveAsync()).ToList();
        await LoadForEntityAsync();
    }

    private void HandleEntityChanged()
        => InvokeAsync(async () => { await LoadForEntityAsync(); StateHasChanged(); });

    private async Task LoadForEntityAsync()
    {
        if (!SessionState.HasEntity) return;

        _contexts          = _allContexts.Where(c => c.LegalEntityId == SessionState.SelectedLegalEntityId).ToList();
        _selectedContextId = _contexts.FirstOrDefault()?.PayrollContextId ?? Guid.Empty;

        await LoadRunsAsync();

        if (_selectedContextId != Guid.Empty)
            _openPeriods = (await ContextRepo.GetOpenPeriodsAsync(_selectedContextId)).ToList();

        // Poll while any run is in a background-job state (calc or approval post).
        if (_runs.Any(r => r.RunStatusId == _calculatingStatus || r.RunStatusId == _approvingStatus))
            StartPolling();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRunsAsync()
    {
        if (_selectedContextId == Guid.Empty) { _loading = false; return; }
        _loading = true;

        var runs = await RunService.GetRunsByContextAsync(_selectedContextId);
        _runs = [.. runs];

        var operativeYear    = TemporalContext.GetOperativeDate().Year;
        var yearPeriods      = await ContextRepo.GetPeriodsByContextAsync(_selectedContextId, operativeYear);
        var prevYearPeriods  = await ContextRepo.GetPeriodsByContextAsync(_selectedContextId, operativeYear - 1);
        _periods = yearPeriods.Concat(prevYearPeriods).ToDictionary(p => p.PeriodId);

        _loading = false;
    }

    private async Task OnContextChangedAsync(ChangeEventArgs<Guid, PayrollContext> args)
    {
        _selectedContextId = args.Value;
        await LoadRunsAsync();
        _openPeriods = (await ContextRepo.GetOpenPeriodsAsync(_selectedContextId)).ToList();
    }

    private async Task OnNewRunContextChangedAsync(ChangeEventArgs<Guid, PayrollContext> args)
    {
        _newRun.ContextId = args.Value;
        _newRun.PeriodId  = Guid.Empty;
        _openPeriods = (await ContextRepo.GetOpenPeriodsAsync(args.Value)).ToList();
        await LoadTargetingDataAsync();
    }

    private void ToggleNewRunForm()
    {
        _showNewRunForm  = !_showNewRunForm;
        _newRunError     = null;
        _confirmEarlyRun = false;
        _selectedPeriod  = null;
        if (_showNewRunForm)
        {
            _newRun = new NewRunFormModel { ContextId = _selectedContextId, RunTypeId = _regularRunTypeId };
            ResetTargeting();
        }
    }

    // Phase 12.6 — targeting picker state.
    private void ResetTargeting()
    {
        _targetableEmployees = [];
        _carryoverCount      = 0;
        _carryoverUsed       = false;
        _pendingTargets      = null;
        _alreadyPaidIds      = [];
    }

    private async Task LoadTargetingDataAsync()
    {
        if (IsRegularType || _newRun.ContextId == Guid.Empty)
        {
            ResetTargeting();
            return;
        }
        _targetableEmployees = [.. await RunService.GetTargetableEmployeesAsync(_newRun.ContextId)];
        _carryoverCount      = _newRun.PeriodId == Guid.Empty
            ? 0
            : (await RunService.GetCarryoverEmploymentIdsAsync(_newRun.PeriodId)).Count;
        _alreadyPaidIds      = _newRun.PeriodId == Guid.Empty
            ? []
            : (await RunService.GetAlreadyPaidEmploymentIdsAsync(_newRun.PeriodId)).ToHashSet();
        _carryoverUsed       = false;
    }

    private async Task OnRunTypeChangedAsync(ChangeEventArgs<int, IntOption> args)
    {
        _newRun.RunTypeId = args.Value;
        await LoadTargetingDataAsync();
    }

    private async Task OnNewRunPeriodChangedAsync(ChangeEventArgs<Guid, PeriodOption> args)
    {
        _newRun.PeriodId = args.Value;
        if (!IsRegularType)
        {
            _carryoverCount = (await RunService.GetCarryoverEmploymentIdsAsync(_newRun.PeriodId)).Count;
            // ToDo #43 — already-paid targets for this period: badge them and block selecting them.
            _alreadyPaidIds = (await RunService.GetAlreadyPaidEmploymentIdsAsync(_newRun.PeriodId)).ToHashSet();
        }
    }

    private async Task CarryOverExceptionsAsync()
    {
        if (_targetGrid is null || _newRun.PeriodId == Guid.Empty) return;
        var ids = (await RunService.GetCarryoverEmploymentIdsAsync(_newRun.PeriodId)).ToHashSet();
        if (ids.Count == 0) return;
        // ToDo #43 — never carry over an already-paid employee (would re-pay).
        var indices = _targetableEmployees
            .Select((e, i) => (e, i))
            .Where(t => ids.Contains(t.e.EmploymentId) && !_alreadyPaidIds.Contains(t.e.EmploymentId))
            .Select(t => t.i)
            .ToArray();
        await _targetGrid.SelectRowsAsync(indices);
        _carryoverUsed = true;
    }

    private async Task InitiateRunAsync()
    {
        if (_newRun.ContextId == Guid.Empty || _newRun.PeriodId == Guid.Empty)
        {
            _newRunError = "Payroll context and period are required.";
            return;
        }

        // Phase 12.6 — a non-Regular run targets a selected subset; gather + validate now so the
        // error surfaces before the early-run confirm. Selection is read from the grid (persisted
        // across paging); the service + job both re-validate context membership.
        _pendingTargets = null;
        if (!IsRegularType)
        {
            var selected = _targetGrid is null
                ? new List<RunTargetEmployee>()
                : await _targetGrid.GetSelectedRecordsAsync();
            var targetIds = selected.Select(s => s.EmploymentId).Distinct().ToList();
            if (targetIds.Count == 0)
            {
                _newRunError = "Select at least one employee to target — or choose a Regular run to pay the whole context.";
                return;
            }
            if (string.IsNullOrWhiteSpace(_newRun.TriggerReason))
            {
                _newRunError = "A trigger reason is required for a targeted run.";
                return;
            }
            // ToDo #43 — block already-paid targets here, named, before the run is created. The
            // service + engine resolver enforce the same invariant as safety nets.
            var paidSelected = targetIds.Where(_alreadyPaidIds.Contains).ToList();
            if (paidSelected.Count > 0)
            {
                var named = _targetableEmployees
                    .Where(e => paidSelected.Contains(e.EmploymentId))
                    .Select(e => $"{e.EmployeeNumber} ({e.Name})");
                _newRunError =
                    "These selected employees already have approved pay for this period and would be paid again — "
                    + "deselect them (re-paying requires a correction, not yet available): "
                    + string.Join(", ", named) + ".";
                return;
            }
            _pendingTargets = targetIds;
        }

        _selectedPeriod = _openPeriods.FirstOrDefault(p => p.PeriodId == _newRun.PeriodId);
        if (_selectedPeriod is not null)
        {
            var today         = DateOnly.FromDateTime(TemporalContext.GetOperativeDate());
            // "Early" means we haven't yet reached the normal earliest run point (the
            // calculation date). The pay date is always the ceiling: once the operative
            // date reaches the pay date you are never "early", even if a quirky calendar
            // pushed the calculation date past the pay date.
            var calcDate      = _selectedPeriod.CalculationDate ?? _selectedPeriod.PayDate;
            var runThreshold  = calcDate < _selectedPeriod.PayDate ? calcDate : _selectedPeriod.PayDate;
            if (today < runThreshold)
            {
                _confirmEarlyRun = true;
                _newRunError     = null;
                return;
            }
        }

        await SubmitRunAsync();
    }

    private async Task ConfirmEarlyRunAsync()
    {
        _confirmEarlyRun = false;
        await SubmitRunAsync();
    }

    private void CancelEarlyRun()
    {
        _confirmEarlyRun = false;
        _selectedPeriod  = null;
    }

    private async Task SubmitRunAsync()
    {
        _submitting  = true;
        _newRunError = null;
        try
        {
            await RunService.InitiateRunAsync(new InitiatePayrollRunCommand
            {
                PayrollContextId    = _newRun.ContextId,
                PeriodId            = _newRun.PeriodId,
                RunTypeId           = _newRun.RunTypeId,
                RunDescription      = string.IsNullOrWhiteSpace(_newRun.Description) ? null : _newRun.Description,
                InitiatedBy         = _currentUserId,
                ParentRunId         = null,
                TargetEmploymentIds = _pendingTargets,
                TriggerReason       = string.IsNullOrWhiteSpace(_newRun.TriggerReason) ? null : _newRun.TriggerReason!.Trim(),
                ExceptionDerived    = _carryoverUsed
            });
            _pendingTargets = null;
            _showNewRunForm = false;
            await LoadRunsAsync();
            StartPolling();
        }
        catch (InvalidOperationException ex) { _newRunError = ex.Message; }
        finally { _submitting = false; }
    }

    private async Task ApproveRunAsync(Guid runId)
    {
        _errorMessage = null;
        try
        {
            await RunService.ApproveRunAsync(new ApprovePayrollRunCommand
                { RunId = runId, ApprovedBy = _currentUserId });
            await LoadRunsAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
    }

    private async Task CancelRunAsync(Guid runId)
    {
        _errorMessage = null;
        try
        {
            await RunService.CancelRunAsync(new CancelPayrollRunCommand
                { RunId = runId, CancelledBy = _currentUserId, Reason = "Cancelled by operator" });
            await LoadRunsAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
    }

    private void StartPolling()
    {
        if (_pollCts is not null) return;
        _pollCts = new CancellationTokenSource();
        _ = PollAsync(_pollCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        _pollTimer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await _pollTimer.WaitForNextTickAsync(ct))
            {
                await LoadRunsAsync();
                await InvokeAsync(StateHasChanged);
                if (!_runs.Any(r => r.RunStatusId == _calculatingStatus || r.RunStatusId == _approvingStatus))
                {
                    _pollCts?.Cancel();
                    break;
                }
            }
        }
        catch (OperationCanceledException) { }
        finally { _pollTimer?.Dispose(); _pollTimer = null; }
    }

    public void Dispose()
    {
        SessionState.OnChanged -= HandleEntityChanged;
        _pollCts?.Cancel();
        _pollTimer?.Dispose();
    }

    private string GetPeriodLabel(Guid periodId) =>
        _periods.TryGetValue(periodId, out var p)
            ? $"{p.PeriodYear} P{p.PeriodNumber} ({p.PeriodStartDate:MM/dd}–{p.PeriodEndDate:MM/dd})"
            : periodId.ToString()[..8];

    private static string GetRunTypeLabel(int id) => id switch
    {
        1 => "Regular",   2 => "Supplemental", 3 => "Adjustment",
        4 => "Correction", 5 => "Reprocessing", 6 => "Simulation",
        _ => id.ToString()
    };

    private string GetStatusLabel(int id)
        => _statusById.TryGetValue(id, out var e) ? e.Label : id.ToString();

    private string GetStatusBadgeClass(int id)
    {
        if (!_statusById.TryGetValue(id, out var e)) return "badge-neutral";
        return e.Code switch
        {
            "CALCULATING" or "RELEASING" or "APPROVING" => "badge-info",
            "CALCULATED" or "APPROVED"                  => "badge-teal",
            "RELEASED"                                  => "badge-success",
            "UNDER_REVIEW"                              => "badge-warning",
            "FAILED"                                    => "badge-error",
            _                                           => "badge-neutral"
        };
    }

    private sealed class NewRunFormModel
    {
        public Guid    ContextId     { get; set; }
        public Guid    PeriodId      { get; set; }
        public int     RunTypeId     { get; set; }
        public string  Description   { get; set; } = "";
        public string? TriggerReason { get; set; }   // Phase 12.6 — required for a scoped run
    }
}
