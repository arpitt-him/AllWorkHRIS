@page "/payroll/register"
@layout PayrollShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "PayrollOperator,PayrollAdmin,HrisAdmin,BenefitsAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using AllWorkHRIS.Module.Payroll.Queries
@using System.Text
@using Microsoft.JSInterop
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Grids
@inject IHrisSessionState       SessionState
@inject PayRegisterQueryService QueryService
@inject IJSRuntime              JS
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Pay Register — AllWork HRIS</PageTitle>

<div class="register-layout">

    @* ── Left nav: year / month / run tree ─────────────────────────────── *@
    <div class="register-nav">
        <div class="register-nav__header">Runs</div>
        @if (_loading)
        {
            <p class="nav-hint">Loading…</p>
        }
        else if (!_runs.Any())
        {
            <p class="nav-hint">No completed runs.</p>
        }
        else
        {
            @foreach (var year in _runs.Select(r => r.Year).Distinct().OrderByDescending(y => y))
            {
                var yearExpanded = _expandedYears.Contains(year);
                <div class="nav-year">
                    <button class="nav-year__btn" @onclick="() => ToggleYear(year)">
                        <span class="nav-year__arrow">@(yearExpanded ? "▾" : "▸")</span>
                        @year
                    </button>
                    @if (yearExpanded)
                    {
                        @foreach (var month in _runs.Where(r => r.Year == year)
                                                    .Select(r => r.Month)
                                                    .Distinct()
                                                    .OrderByDescending(m => m))
                        {
                            var monthRuns = _runs.Where(r => r.Year == year && r.Month == month).ToList();
                            <div class="nav-month">
                                <span class="nav-month__label">@(new DateTime(year, month, 1).ToString("MMMM"))</span>
                                @foreach (var run in monthRuns)
                                {
                                    <button class="nav-run @(_selectedRunId == run.RunId ? "nav-run--active" : "")"
                                            @onclick="() => SelectRunAsync(run.RunId)">
                                        @run.Label
                                        <span class="nav-run__status">@run.StatusLabel</span>
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>

    @* ── Right content ──────────────────────────────────────────────────── *@
    <div class="register-content">

        @if (_runHeader is null)
        {
            <div class="empty-state">
                <p>Select a payroll run from the list on the left.</p>
            </div>
        }
        else
        {
            @* Run header *@
            <div class="run-header">
                <div class="run-header__main">
                    <span class="run-header__title">@(_runHeader.RunDescription ?? $"P{_runHeader.PeriodNumber}")</span>
                    <span class="run-header__period">
                        @_runHeader.PeriodYear P@_runHeader.PeriodNumber &nbsp;·&nbsp;
                        @_runHeader.PeriodStartDate.ToString("MMM d") – @_runHeader.PeriodEndDate.ToString("MMM d, yyyy")
                    </span>
                </div>
                <div class="run-header__meta">
                    Pay Date: <strong>@_runHeader.PayDate.ToString("MMM d, yyyy")</strong>
                </div>
            </div>

            @* Tab bar — full access roles only *@
            <AuthorizeView Roles="PayrollOperator,PayrollAdmin,HrisAdmin">
                <Authorized>
                    <div class="tab-bar">
                        <button class="tab @(_activeTab == "summary" ? "tab--active" : "")"
                                @onclick='() => SwitchTab("summary")'>Company Summary</button>
                        <button class="tab @(_activeTab == "org"     ? "tab--active" : "")"
                                @onclick='() => SwitchTab("org")'>Org Rollup</button>
                        <button class="tab @(_activeTab == "detail"  ? "tab--active" : "")"
                                @onclick='() => SwitchTab("detail")'>Employee Detail</button>
                    </div>
                </Authorized>
            </AuthorizeView>

            @* ── Company Summary ────────────────────────────────────────── *@
            @if (_activeTab == "summary" || _isBenefitsAdmin)
            {
                @if (_summaryLoading)
                {
                    <div class="tab-loading">Loading…</div>
                }
                else if (_summary is not null)
                {
                    <div class="tab-content">

                        @* Payroll Cost Summary — hidden from BenefitsAdmin *@
                        <AuthorizeView Roles="PayrollOperator,PayrollAdmin,HrisAdmin">
                            <Authorized>
                                <div class="summary-section">
                                    <h3 class="summary-section__title">Payroll Cost Summary</h3>
                                    <div class="summary-rows">
                                        <div class="summary-row"><span>Total Gross Payroll</span><span class="amount">@Fmt(_summary.TotalGrossPayroll)</span></div>
                                        <div class="summary-row"><span>Total Employer Taxes</span><span class="amount">@Fmt(_summary.TotalEmployerTaxes)</span></div>
                                        <div class="summary-row"><span>Total Employer Benefit Contributions</span><span class="amount">@Fmt(_summary.TotalEmployerBenefitContrib)</span></div>
                                        <div class="summary-row summary-row--subtotal"><span><strong>Total Employer Cost</strong></span><span class="amount"><strong>@Fmt(_summary.TotalEmployerCost)</strong></span></div>
                                        <div class="summary-row"><span>Total Employee Tax Withholdings</span><span class="amount">@Fmt(_summary.TotalEmployeeTaxWithholdings)</span></div>
                                        <div class="summary-row"><span>Total Employee Benefit Deductions</span><span class="amount">@Fmt(_summary.TotalEmployeeBenefitDeducts)</span></div>
                                        <div class="summary-row summary-row--subtotal"><span><strong>Total Net Pay</strong></span><span class="amount"><strong>@Fmt(_summary.TotalNetPay)</strong></span></div>
                                        <div class="summary-row summary-row--highlight"><span><strong>Total Cash Required (ACH)</strong></span><span class="amount"><strong>@Fmt(_summary.TotalCashRequired)</strong></span></div>
                                    </div>
                                </div>

                                <div class="summary-section">
                                    <h3 class="summary-section__title">Tax Liability Summary</h3>
                                    <div class="summary-rows">
                                        <div class="summary-row"><span>Federal Income Tax Withheld</span><span class="amount">@Fmt(_summary.FederalIncomeTax)</span></div>
                                        <div class="summary-row"><span>Social Security — Employee</span><span class="amount">@Fmt(_summary.SocialSecurityEe)</span></div>
                                        <div class="summary-row"><span>Social Security — Employer</span><span class="amount">@Fmt(_summary.SocialSecurityEr)</span></div>
                                        <div class="summary-row"><span>Medicare — Employee</span><span class="amount">@Fmt(_summary.MedicareEe)</span></div>
                                        <div class="summary-row"><span>Medicare — Employer</span><span class="amount">@Fmt(_summary.MedicareEr)</span></div>
                                        @foreach (var row in _summary.StateAndLocalTax)
                                        {
                                            <div class="summary-row"><span>@row.Label</span><span class="amount">@Fmt(row.Amount)</span></div>
                                        }
                                        @if (_summary.Futa != 0)
                                        {
                                            <div class="summary-row"><span>FUTA</span><span class="amount">@Fmt(_summary.Futa)</span></div>
                                        }
                                        @foreach (var row in _summary.SutaByState)
                                        {
                                            <div class="summary-row"><span>@row.Label</span><span class="amount">@Fmt(row.Amount)</span></div>
                                        }
                                    </div>
                                </div>
                            </Authorized>
                        </AuthorizeView>

                        @* Benefit Summary — visible to all authorized roles *@
                        <div class="summary-section">
                            <h3 class="summary-section__title">Benefit Summary</h3>
                            <div class="summary-rows">
                                <div class="summary-row"><span>Total Employee Deductions</span><span class="amount">@Fmt(_summary.TotalEmployeeDeductions)</span></div>
                                <div class="summary-row"><span>Total Employer Contributions</span><span class="amount">@Fmt(_summary.TotalEmployerContributions)</span></div>
                                <div class="summary-row"><span>Total Retirement Deductions (EE)</span><span class="amount">@Fmt(_summary.TotalRetirementDeductions)</span></div>
                            </div>
                        </div>

                        @* Headcount — hidden from BenefitsAdmin *@
                        <AuthorizeView Roles="PayrollOperator,PayrollAdmin,HrisAdmin">
                            <Authorized>
                                <div class="summary-section">
                                    <h3 class="summary-section__title">Headcount</h3>
                                    <div class="summary-rows">
                                        <div class="summary-row"><span>Employees Included</span><span class="amount">@_summary.EmployeesIncluded</span></div>
                                        <div class="summary-row"><span>Employees with Supplemental Pay</span><span class="amount">@_summary.EmployeesWithSupplementalPay</span></div>
                                    </div>
                                </div>
                                <div class="export-row">
                                    <button class="btn-link" @onclick="ExportSummaryCsvAsync">Download CSV</button>
                                </div>
                            </Authorized>
                        </AuthorizeView>

                    </div>
                }
            }

            @* ── Org Rollup ─────────────────────────────────────────────── *@
            <AuthorizeView Roles="PayrollOperator,PayrollAdmin,HrisAdmin">
                <Authorized Context="authCtx">
                    @if (_activeTab == "org")
                    {
                        <div class="tab-content">
                            <div class="sub-tab-bar">
                                @foreach (var dim in _availableDimensions)
                                {
                                    <button class="sub-tab @(_orgDimension == dim.Code ? "sub-tab--active" : "")"
                                            @onclick="() => SwitchOrgDimensionAsync(dim.Code)">
                                        By @dim.Label
                                    </button>
                                }
                                <button class="sub-tab @(_orgDimension == "LOCATION" ? "sub-tab--active" : "")"
                                        @onclick='() => SwitchOrgDimensionAsync("LOCATION")'>By Location</button>
                                <button class="sub-tab @(_orgDimension == "JOB" ? "sub-tab--active" : "")"
                                        @onclick='() => SwitchOrgDimensionAsync("JOB")'>By Job</button>
                            </div>

                            @if (_orgLoading)
                            {
                                <div class="tab-loading">Loading…</div>
                            }
                            else
                            {
                                <SfGrid TValue="PayRegisterOrgRow" DataSource="@_orgRows.ToList()" AllowSorting="true" CssClass="e-gridhover">
                                    <GridEvents TValue="PayRegisterOrgRow" DetailsExpanded="OnOrgRowExpandingAsync" />
                                    <GridColumns>
                                        <GridColumn HeaderText="@OrgGroupLabel" Field="GroupName" />
                                        <GridColumn HeaderText="Headcount" Field="Headcount" TextAlign="TextAlign.Right" Width="100" />
                                        <GridColumn HeaderText="Gross Wages" Field="GrossWages" TextAlign="TextAlign.Right" Width="110">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.GrossWages)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="EE Tax Withheld" Field="EmployeeTaxWithheld" TextAlign="TextAlign.Right" Width="120">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.EmployeeTaxWithheld)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="ER Tax Cost" Field="EmployerTaxCost" TextAlign="TextAlign.Right" Width="100">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.EmployerTaxCost)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="ER Benefit Cost" Field="EmployerBenefitCost" TextAlign="TextAlign.Right" Width="120">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.EmployerBenefitCost)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Net Pay" Field="NetPay" TextAlign="TextAlign.Right" Width="100">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.NetPay)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Total ER Cost" Field="TotalEmployerCost" TextAlign="TextAlign.Right" Width="110">
                                            <Template>@{ var r = (PayRegisterOrgRow)context; }@Fmt(r.TotalEmployerCost)</Template>
                                        </GridColumn>
                                    </GridColumns>
                                    <GridAggregates>
                                        <GridAggregate>
                                            <GridAggregateColumns>
                                                <GridAggregateColumn Field="Headcount" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Convert.ToInt64(a.Sum)</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="GrossWages" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="EmployeeTaxWithheld" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="EmployerTaxCost" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="EmployerBenefitCost" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="NetPay" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                                <GridAggregateColumn Field="TotalEmployerCost" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Fmt(Convert.ToDecimal(a.Sum))</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                            </GridAggregateColumns>
                                        </GridAggregate>
                                    </GridAggregates>
                                    <GridTemplates><DetailTemplate Context="orgCtx">
                                        @{ var orgRow = (PayRegisterOrgRow)orgCtx; }
                                        @if (_orgGroupEmployees.TryGetValue(orgRow.GroupId, out var subEmps))
                                        {
                                            <SfGrid TValue="PayRegisterEmployeeRow" DataSource="@subEmps.ToList()" CssClass="e-gridhover">
                                                <GridColumns>
                                                    <GridColumn HeaderText="#" Field="EmployeeNumber" Width="60" />
                                                    <GridColumn HeaderText="Employee" Field="EmployeeName" />
                                                    <GridColumn HeaderText="Dept" Field="DepartmentName" Width="100" />
                                                    <GridColumn HeaderText="Gross" TextAlign="TextAlign.Right" Width="80">
                                                        <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.Gross)</Template>
                                                    </GridColumn>
                                                    <GridColumn HeaderText="Fed Tax" TextAlign="TextAlign.Right" Width="70">
                                                        <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.FederalTax)</Template>
                                                    </GridColumn>
                                                    <GridColumn HeaderText="SS (EE)" TextAlign="TextAlign.Right" Width="70">
                                                        <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.SsEe)</Template>
                                                    </GridColumn>
                                                    <GridColumn HeaderText="Med (EE)" TextAlign="TextAlign.Right" Width="70">
                                                        <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.MedicareEe)</Template>
                                                    </GridColumn>
                                                    <GridColumn HeaderText="Net Pay" TextAlign="TextAlign.Right" Width="80">
                                                        <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.NetPay)</Template>
                                                    </GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        }
                                        else
                                        {
                                            <span class="tab-loading">Loading…</span>
                                        }
                                    </DetailTemplate></GridTemplates>
                                </SfGrid>
                                <div class="export-row">
                                    <button class="btn-link" @onclick="ExportOrgCsvAsync">Download CSV</button>
                                </div>
                            }
                        </div>
                    }

                    @* ── Employee Detail ─────────────────────────────────── *@
                    @if (_activeTab == "detail")
                    {
                        <div class="tab-content">
                            <div class="detail-toolbar">
                                <SfTextBox @bind-Value="_empFilter" Input="OnEmpFilterInput"
                                           Placeholder="Filter by name or number…" Width="240px" />
                                <span class="detail-count">@FilteredCount employees</span>
                            </div>

                            @if (_empLoading)
                            {
                                <div class="tab-loading">Loading…</div>
                            }
                            else
                            {
                                <SfGrid TValue="PayRegisterEmployeeRow" DataSource="@FilteredEmployeeRows.ToList()"
                                        AllowSorting="true" AllowPaging="true" CssClass="e-gridhover">
                                    <GridEvents TValue="PayRegisterEmployeeRow" DetailsExpanded="OnEmpRowExpandingAsync" />
                                    <GridPageSettings PageSize="20" />
                                    <GridColumns>
                                        <GridColumn HeaderText="#" Field="EmployeeNumber" Width="60" />
                                        <GridColumn HeaderText="Employee" Field="EmployeeName" />
                                        <GridColumn HeaderText="Dept" Field="DepartmentName" Width="90" />
                                        <GridColumn HeaderText="Gross" Field="Gross" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.Gross)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelFederalTax" Field="FederalTax" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.FederalTax)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelPensionEe" Field="SsEe" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.SsEe)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelInsuranceEe" Field="MedicareEe" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.MedicareEe)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelStateTax" Field="StateTax" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.StateTax)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@(_columnLabels.LabelLocalTax ?? "Local Tax")" Field="LocalTax"
                                                    Visible="@(_columnLabels.LabelLocalTax is not null)" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.LocalTax)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Benefits" Field="BenefitDeductions" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.BenefitDeductions)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Retire" Field="RetirementDeductions" TextAlign="TextAlign.Right" Width="65">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.RetirementDeductions)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Garnish" Field="Garnishments" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.Garnishments)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Net Pay" Field="NetPay" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }<strong>@Fmt(e.NetPay)</strong></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelErPension" Field="EmployerSs" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.EmployerSs)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="@_columnLabels.LabelErInsurance" Field="EmployerMedicare" TextAlign="TextAlign.Right" Width="70">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.EmployerMedicare)</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="ER Benefit" Field="EmployerBenefit" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var e = (PayRegisterEmployeeRow)context; }@Fmt(e.EmployerBenefit)</Template>
                                        </GridColumn>
                                    </GridColumns>
                                    <GridTemplates><DetailTemplate Context="empCtx">
                                        @{ var emp = (PayRegisterEmployeeRow)empCtx; }
                                        @if (_lineDetailCache.TryGetValue(emp.EmployeePayrollResultId, out var lines))
                                        {
                                            <SfGrid TValue="PayRegisterLineItem" DataSource="@lines.ToList()" CssClass="e-gridhover">
                                                <GridColumns>
                                                    <GridColumn HeaderText="Category" Field="Category" Width="120" />
                                                    <GridColumn HeaderText="Code" Field="Code" Width="80" />
                                                    <GridColumn HeaderText="Description" Field="Description" />
                                                    <GridColumn HeaderText="Amount" Field="Amount" TextAlign="TextAlign.Right" Width="90">
                                                        <Template>
                                                            @{ var li = (PayRegisterLineItem)context; }
                                                            <span class="@(li.Amount < 0 ? "amount-negative" : "")">@Fmt(li.Amount)</span>
                                                        </Template>
                                                    </GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        }
                                        else
                                        {
                                            <span class="tab-loading">Loading…</span>
                                        }
                                    </DetailTemplate></GridTemplates>
                                </SfGrid>

                                @* Totals bar — aggregates all filtered employees, not just the current page *@
                                @if (!_empLoading && FilteredEmployeeRows.Any())
                                {
                                    <div class="emp-totals-bar">
                                        <span><strong>Total (@FilteredCount)</strong></span>
                                        <span>Gross: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.Gross))</strong></span>
                                        <span>Fed Tax: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.FederalTax))</strong></span>
                                        <span>SS EE: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.SsEe))</strong></span>
                                        <span>Med EE: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.MedicareEe))</strong></span>
                                        <span>State Tax: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.StateTax))</strong></span>
                                        @if (_columnLabels.LabelLocalTax is not null)
                                        {
                                            <span>Local Tax: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.LocalTax))</strong></span>
                                        }
                                        <span>Benefits: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.BenefitDeductions))</strong></span>
                                        <span>Retire: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.RetirementDeductions))</strong></span>
                                        <span>Garnish: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.Garnishments))</strong></span>
                                        <span>Net Pay: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.NetPay))</strong></span>
                                        <span>ER SS: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.EmployerSs))</strong></span>
                                        <span>ER Med: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.EmployerMedicare))</strong></span>
                                        <span>ER Benefit: <strong>@Fmt(FilteredEmployeeRows.Sum(r => r.EmployerBenefit))</strong></span>
                                    </div>
                                }

                                <div class="export-row">
                                    <button class="btn-link" @onclick="ExportEmployeeCsvAsync">Download CSV</button>
                                    <button class="btn-link" @onclick="ExportLineDetailCsvAsync">Export with Line Detail</button>
                                </div>
                            }
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        }
    </div>
</div>

@code {
    private IReadOnlyList<PayRegisterRunOption> _runs        = [];
    private bool                                _loading     = true;
    private bool                                _isBenefitsAdmin;

    // Navigator
    private readonly HashSet<int> _expandedYears = [];

    // Selected run
    private Guid?                  _selectedRunId;
    private PayRegisterRunHeader?  _runHeader;

    // Tab state
    private string _activeTab = "summary";

    // Company Summary
    private PayRegisterCompanySummary? _summary;
    private bool                       _summaryLoading;

    // Org Rollup
    private IReadOnlyList<OrgDimension>                         _availableDimensions = [];
    private string                                              _orgDimension = "DEPARTMENT";
    private IReadOnlyList<PayRegisterOrgRow>                    _orgRows      = [];
    private bool                                                _orgLoading;
    private readonly Dictionary<Guid, IReadOnlyList<PayRegisterEmployeeRow>> _orgGroupEmployees = new();

    // Column labels (country-driven)
    private PayRegisterColumnLabels _columnLabels = PayRegisterColumnLabels.Default;

    // Employee Detail
    private IReadOnlyList<PayRegisterEmployeeRow> _allEmployeeRows = [];
    private bool                                  _empLoading;
    private string                                _empFilter  = "";
    private readonly Dictionary<Guid, IReadOnlyList<PayRegisterLineItem>> _lineDetailCache = new();

    // ── Computed ──────────────────────────────────────────────────────────────

    private IEnumerable<PayRegisterEmployeeRow> FilteredEmployeeRows =>
        string.IsNullOrWhiteSpace(_empFilter)
            ? _allEmployeeRows
            : _allEmployeeRows.Where(r =>
                r.EmployeeNumber.Contains(_empFilter, StringComparison.OrdinalIgnoreCase) ||
                r.EmployeeName.Contains(_empFilter, StringComparison.OrdinalIgnoreCase));

    private int FilteredCount => FilteredEmployeeRows.Count();

    private string OrgGroupLabel =>
        _orgDimension switch
        {
            "LOCATION" => "Location",
            "JOB"      => "Job",
            _ => _availableDimensions.FirstOrDefault(d => d.Code == _orgDimension)?.Label ?? _orgDimension
        };

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var auth  = await AuthStateProvider.GetAuthenticationStateAsync();
        _isBenefitsAdmin = auth.User.IsInRole("BenefitsAdmin") &&
                           !auth.User.IsInRole("PayrollOperator") &&
                           !auth.User.IsInRole("PayrollAdmin") &&
                           !auth.User.IsInRole("HrisAdmin");

        var entityId = SessionState.SelectedLegalEntityId;
        if (entityId.HasValue)
        {
            _runs = await QueryService.GetRunNavigatorAsync(entityId.Value);
            if (_runs.Any())
            {
                var current = _runs[0];
                _expandedYears.Add(current.Year);
                await SelectRunAsync(current.RunId);
            }
        }
        _loading = false;
    }

    // ── Navigator ─────────────────────────────────────────────────────────────

    private void ToggleYear(int year)
    {
        if (!_expandedYears.Remove(year))
            _expandedYears.Add(year);
    }

    private async Task SelectRunAsync(Guid runId)
    {
        _selectedRunId = runId;
        _runHeader     = null;
        _summary       = null;
        _allEmployeeRows = [];
        _orgRows         = [];
        _orgGroupEmployees.Clear();
        _lineDetailCache.Clear();
        _empFilter  = "";

        var dimensionsTask   = QueryService.GetAvailableOrgDimensionsAsync(runId);
        var columnLabelsTask = QueryService.GetColumnLabelsAsync(runId);
        var runHeaderTask    = QueryService.GetRunHeaderAsync(runId);
        await Task.WhenAll(dimensionsTask, columnLabelsTask, runHeaderTask);

        _availableDimensions = dimensionsTask.Result;
        _columnLabels        = columnLabelsTask.Result;
        _runHeader           = runHeaderTask.Result;

        // Reset dimension if it's no longer present in this run (org hierarchy dimensions only)
        if (_orgDimension != "LOCATION" && _orgDimension != "JOB" &&
            !_availableDimensions.Any(d => d.Code == _orgDimension))
        {
            _orgDimension = _availableDimensions.FirstOrDefault()?.Code ?? "DEPARTMENT";
        }

        // Re-load whichever tab the user is currently viewing
        if (_activeTab == "org")          await LoadOrgAsync();
        else if (_activeTab == "detail")  await LoadEmployeeDetailAsync();
        else                              await LoadSummaryAsync();
    }

    // ── Tab switching ─────────────────────────────────────────────────────────

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        if (tab == "summary" && _summary is null)       await LoadSummaryAsync();
        if (tab == "org"     && !_orgRows.Any())        await LoadOrgAsync();
        if (tab == "detail"  && !_allEmployeeRows.Any()) await LoadEmployeeDetailAsync();
    }

    private async Task SwitchOrgDimensionAsync(string dimension)
    {
        _orgDimension = dimension;
        _orgGroupEmployees.Clear();
        await LoadOrgAsync();
    }

    // ── Data loaders ─────────────────────────────────────────────────────────

    private async Task LoadSummaryAsync()
    {
        if (_selectedRunId is null) return;
        _summaryLoading = true;
        StateHasChanged();
        _summary = await QueryService.GetCompanySummaryAsync(_selectedRunId.Value);
        _summaryLoading = false;
    }

    private async Task LoadOrgAsync()
    {
        if (_selectedRunId is null) return;
        _orgLoading = true;
        StateHasChanged();
        _orgRows = await QueryService.GetOrgRollupAsync(_selectedRunId.Value, _orgDimension);
        _orgLoading = false;
    }

    private async Task LoadEmployeeDetailAsync()
    {
        if (_selectedRunId is null) return;
        _empLoading = true;
        StateHasChanged();
        _allEmployeeRows = await QueryService.GetEmployeeDetailAsync(_selectedRunId.Value);
        _empLoading = false;
    }

    // ── Row expansion (SfGrid RowExpanding events) ────────────────────────────

    private async Task OnOrgRowExpandingAsync(DetailsExpandedEventArgs<PayRegisterOrgRow> args)
    {
        if (args.Data is null) return;
        var groupId = args.Data.GroupId;
        if (_orgGroupEmployees.ContainsKey(groupId) || !_selectedRunId.HasValue) return;

        if (!_allEmployeeRows.Any())
            _allEmployeeRows = await QueryService.GetEmployeeDetailAsync(_selectedRunId.Value);

        IReadOnlyList<Guid> ids = _orgDimension switch
        {
            "JOB"      => await QueryService.GetEmploymentIdsForJobAsync(_selectedRunId.Value, groupId),
            "LOCATION" => await QueryService.GetEmploymentIdsForLocationAsync(_selectedRunId.Value, groupId),
            _          => await QueryService.GetEmploymentIdsForOrgUnitAsync(_selectedRunId.Value, groupId)
        };

        var idSet = ids.ToHashSet();
        _orgGroupEmployees[groupId] = _allEmployeeRows.Where(e => idSet.Contains(e.EmploymentId)).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnEmpRowExpandingAsync(DetailsExpandedEventArgs<PayRegisterEmployeeRow> args)
    {
        if (args.Data is null) return;
        var resultId = args.Data.EmployeePayrollResultId;
        if (_lineDetailCache.ContainsKey(resultId)) return;
        _lineDetailCache[resultId] = await QueryService.GetLineDetailAsync(resultId);
        await InvokeAsync(StateHasChanged);
    }

    // ── Filter ────────────────────────────────────────────────────────────────

    private void OnEmpFilterInput(InputEventArgs args)
    {
        _empFilter = args.Value;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string Fmt(decimal v) =>
        v < 0 ? $"({-v:N2})" : v.ToString("N2");

    // ── CSV export ────────────────────────────────────────────────────────────

    private async Task ExportSummaryCsvAsync()
    {
        if (_summary is null || _runHeader is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Line,Amount");
        sb.AppendLine($"Total Gross Payroll,{_summary.TotalGrossPayroll:F2}");
        sb.AppendLine($"Total Employer Taxes,{_summary.TotalEmployerTaxes:F2}");
        sb.AppendLine($"Total Employer Benefit Contributions,{_summary.TotalEmployerBenefitContrib:F2}");
        sb.AppendLine($"Total Employer Cost,{_summary.TotalEmployerCost:F2}");
        sb.AppendLine($"Total Employee Tax Withholdings,{_summary.TotalEmployeeTaxWithholdings:F2}");
        sb.AppendLine($"Total Employee Benefit Deductions,{_summary.TotalEmployeeBenefitDeducts:F2}");
        sb.AppendLine($"Total Net Pay,{_summary.TotalNetPay:F2}");
        sb.AppendLine($"Total Cash Required,{_summary.TotalCashRequired:F2}");
        await DownloadCsvAsync($"pay-register-summary-{_runHeader.PayDate:yyyy-MM-dd}.csv", sb.ToString());
    }

    private async Task ExportOrgCsvAsync()
    {
        if (_runHeader is null) return;
        var sb = new StringBuilder();
        sb.AppendLine($"{OrgGroupLabel},Headcount,Gross Wages,EE Tax Withheld,ER Tax Cost,ER Benefit Cost,Net Pay,Total ER Cost");
        foreach (var r in _orgRows)
            sb.AppendLine($"\"{r.GroupName}\",{r.Headcount},{r.GrossWages:F2},{r.EmployeeTaxWithheld:F2},{r.EmployerTaxCost:F2},{r.EmployerBenefitCost:F2},{r.NetPay:F2},{r.TotalEmployerCost:F2}");
        await DownloadCsvAsync($"pay-register-org-{_orgDimension}-{_runHeader.PayDate:yyyy-MM-dd}.csv", sb.ToString());
    }

    private async Task ExportEmployeeCsvAsync()
    {
        if (_runHeader is null) return;
        var sb = new StringBuilder();
        sb.AppendLine("Employee #,Name,Department,Gross,Fed Tax,SS (EE),Medicare (EE),State Tax,Local Tax,Benefits,Retire (EE),Garnish,Net Pay,ER SS,ER Medicare,ER Benefit");
        foreach (var r in FilteredEmployeeRows.OrderBy(r => r.EmployeeNumber))
            sb.AppendLine($"{r.EmployeeNumber},\"{r.EmployeeName}\",\"{r.DepartmentName}\",{r.Gross:F2},{r.FederalTax:F2},{r.SsEe:F2},{r.MedicareEe:F2},{r.StateTax:F2},{r.LocalTax:F2},{r.BenefitDeductions:F2},{r.RetirementDeductions:F2},{r.Garnishments:F2},{r.NetPay:F2},{r.EmployerSs:F2},{r.EmployerMedicare:F2},{r.EmployerBenefit:F2}");
        await DownloadCsvAsync($"pay-register-employees-{_runHeader.PayDate:yyyy-MM-dd}.csv", sb.ToString());
    }

    private async Task ExportLineDetailCsvAsync()
    {
        if (_selectedRunId is null || _runHeader is null) return;
        if (!_allEmployeeRows.Any())
            _allEmployeeRows = await QueryService.GetEmployeeDetailAsync(_selectedRunId.Value);

        var sb = new StringBuilder();
        sb.AppendLine("Employee #,Name,Category,Code,Description,Amount");
        foreach (var emp in _allEmployeeRows.OrderBy(r => r.EmployeeNumber))
        {
            if (!_lineDetailCache.TryGetValue(emp.EmployeePayrollResultId, out var lines))
                lines = await QueryService.GetLineDetailAsync(emp.EmployeePayrollResultId);
            foreach (var line in lines)
                sb.AppendLine($"{emp.EmployeeNumber},\"{emp.EmployeeName}\",\"{line.Category}\",{line.Code},\"{line.Description}\",{line.Amount:F2}");
        }
        await DownloadCsvAsync($"pay-register-line-detail-{_runHeader.PayDate:yyyy-MM-dd}.csv", sb.ToString());
    }

    private async Task DownloadCsvAsync(string filename, string content)
    {
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(content));
        await JS.InvokeVoidAsync("allworkFiles.downloadBase64", filename, "text/csv", base64);
    }
}

