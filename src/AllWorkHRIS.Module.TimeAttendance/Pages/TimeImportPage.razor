@page "/ta/import"
@layout TimeAttendanceShell
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize(Roles = "TimeAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text
@using AllWorkHRIS.Core.Temporal
@using AllWorkHRIS.Core.Security
@using AllWorkHRIS.Module.TimeAttendance.Domain
@inject ITimeImportService        ImportService
@inject IHrisSessionState         SessionState
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime                JS
@inject ITemporalContext          TemporalContext
@using Syncfusion.Blazor.Grids

<PageTitle>Import Time Entries — AllWork HRIS</PageTitle>

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">Import Time Entries</h2>
    </div>

    @* ── Format guide ────────────────────────────────────────────────── *@
    <div class="import-instructions" style="margin-bottom:1.5rem;">
        <h4 style="margin-bottom:.5rem;">CSV Format</h4>
        <p style="margin-bottom:.5rem;">One entry per row. Header row required. Columns may appear in any order:</p>
        <pre class="code-block" style="font-size:.8rem;overflow-x:auto;">employee_number, work_date, time_category, duration, start_time, end_time, payroll_period_id, project_code, task_code, notes</pre>

        <div class="csv-ref" style="margin-top:.875rem;">
            <div class="csv-ref-header">
                <span style="width:22%">Column</span>
                <span style="width:15%">Required</span>
                <span>Notes</span>
            </div>
            <div class="csv-ref-row"><span><code>employee_number</code></span><span>Yes</span><span>Must match an active employment record.</span></div>
            <div class="csv-ref-row csv-ref-row--alt"><span><code>work_date</code></span><span>Yes</span><span>Format: YYYY-MM-DD.</span></div>
            <div class="csv-ref-row"><span><code>time_category</code></span><span>Yes</span><span><code>REGULAR</code>, <code>OVERTIME</code>, <code>PTO</code>, <code>SICK</code>, <code>HOLIDAY</code>, <code>BEREAVEMENT</code>, <code>JURY_DUTY</code>, <code>UNPAID</code>.</span></div>
            <div class="csv-ref-row csv-ref-row--alt"><span><code>duration</code></span><span>Yes</span><span>Positive decimal hours (e.g. <strong>8.00</strong> or <strong>7.5</strong>).</span></div>
            <div class="csv-ref-row"><span><code>start_time</code></span><span>No</span><span>Format: HH:mm (24-hour). Omit for leave/absence entries.</span></div>
            <div class="csv-ref-row csv-ref-row--alt"><span><code>end_time</code></span><span>No</span><span>Format: HH:mm (24-hour). Must be after <code>start_time</code> when both supplied.</span></div>
            <div class="csv-ref-row"><span><code>payroll_period_id</code></span><span>Yes</span><span>UUID of the target payroll period. Period must not be CLOSED.</span></div>
            <div class="csv-ref-row csv-ref-row--alt"><span><code>project_code</code></span><span>No</span><span>Free-form billing code; passed through as-is.</span></div>
            <div class="csv-ref-row"><span><code>task_code</code></span><span>No</span><span>Free-form task code; passed through as-is.</span></div>
            <div class="csv-ref-row csv-ref-row--alt"><span><code>notes</code></span><span>No</span><span>Free-form notes attached to the entry.</span></div>
        </div>
    </div>

    @* ── Upload ──────────────────────────────────────────────────────── *@
    @if (_step == Step.Upload)
    {
        <div class="form-panel">
            <h3 class="form-panel__title">Upload CSV</h3>

            <div class="form-group">
                <label class="form-label">CSV File <span class="required">*</span></label>
                <input type="file" id="ta-import-file" accept=".csv" class="form-input"
                       @key="_fileInputKey" @onchange="OnFileInputChange" />
            </div>

            @if (_fileError is not null)
            {
                <p class="form-error">@_fileError</p>
            }

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="RunImportAsync"
                        disabled="@(!_fileSelected || _importing)">
                    @(_importing ? "Importing…" : "Import")
                </button>
            </div>
        </div>
    }

    @* ── Results ─────────────────────────────────────────────────────── *@
    @if (_step == Step.Done && _result is not null)
    {
        <div class="import-provenance">
            <span class="import-provenance__file">@_fileName</span>
            @if (_importedAt.HasValue)
            {
                <span class="import-provenance__sep">—</span>
                <span class="import-provenance__time">Imported @_importedAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
            }
        </div>

        <div style="display:flex;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
            <div class="stat-card stat-card--imported">
                <div class="stat-value">@_result.Imported</div>
                <div class="stat-label">Imported</div>
            </div>
            <div class="stat-card @(_result.Failed > 0 ? "stat-card--failed" : "stat-card--imported")">
                <div class="stat-value">@_result.Failed</div>
                <div class="stat-label">Failed</div>
            </div>
        </div>

        @if (_result.Errors.Count > 0)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem;">
                <h4>Exception Queue — @_result.Errors.Count row@(_result.Errors.Count == 1 ? "" : "s") failed</h4>
                <button class="btn btn-ghost btn-sm" @onclick="DownloadErrorsAsync">
                    Download Errors as CSV
                </button>
            </div>
            <SfGrid DataSource="@_result.Errors" AllowSorting="true" CssClass="e-gridhover">
                <GridColumns>
                    <GridColumn HeaderText="Row #" Width="90">
                        <Template>@{ var err = (TimeImportError)context; }@err.RowNumber</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Employee Number" Width="200">
                        <Template>@{ var err = (TimeImportError)context; }<code>@err.EmployeeNumber</code></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Reason">
                        <Template>@{ var err = (TimeImportError)context; }@err.Reason</Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }

        <div class="form-actions" style="margin-top:1.25rem;">
            <button class="btn btn-ghost" @onclick="Reset">Import More</button>
        </div>
    }

    @* ── Import history ───────────────────────────────────────────────── *@
    @if (_history.Count > 0)
    {
        <div class="import-history" style="margin-top:2rem;">
            <h3 class="form-panel__title">Import History</h3>
            <SfGrid DataSource="@_history" AllowSorting="true" AllowPaging="true" CssClass="e-gridhover">
                <GridPageSettings PageSize="10" />
                <GridColumns>
                    <GridColumn HeaderText="File" Field="FileName" />
                    <GridColumn HeaderText="Imported" Width="190">
                        <Template>@{ var h = (TimeImportHistoryRow)context; }@h.ImportedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="By" Field="ImportedBy" Width="170" />
                    <GridColumn HeaderText="Pay Period" Width="200">
                        <Template>
                            @{ var h = (TimeImportHistoryRow)context; }
                            <span style="@(h.PeriodYear is null ? "color:#9ca3af;" : "")">@h.PeriodLabel</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Rows" Field="TotalRows" TextAlign="TextAlign.Right" Width="80" />
                    <GridColumn HeaderText="Imported" Field="AcceptedCount" TextAlign="TextAlign.Right" Width="100" />
                    <GridColumn HeaderText="Failed" Field="RejectedCount" TextAlign="TextAlign.Right" Width="90" />
                    <GridColumn HeaderText="Status" Width="110">
                        <Template>
                            @{ var h = (TimeImportHistoryRow)context; }
                            <span style="color:@(h.Status == "SUCCESS" ? "#16a34a" : "#92400e");font-weight:600;">@h.Status</span>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    }

</div>

@code {

    private enum Step { Upload, Done }

    private Step              _step         = Step.Upload;
    private int               _fileInputKey;
    private bool              _fileSelected;
    private string?           _fileError;
    private bool              _importing;
    private TimeImportResult? _result;
    private string?           _fileName;
    private DateTimeOffset?   _importedAt;
    private IReadOnlyList<TimeImportHistoryRow> _history = [];

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    private async Task LoadHistoryAsync()
    {
        if (SessionState.SelectedLegalEntityId is { } entityId)
            _history = await ImportService.GetImportHistoryAsync(entityId);
    }

    private void OnFileInputChange(ChangeEventArgs e)
    {
        var raw       = e.Value?.ToString();
        _fileSelected = !string.IsNullOrEmpty(raw);
        _fileName     = _fileSelected ? Path.GetFileName(raw) : null;
        _fileError    = null;
        _result       = null;
        _step         = Step.Upload;
    }

    private async Task RunImportAsync()
    {
        _importing = true; _fileError = null;
        try
        {
            var base64 = await JS.InvokeAsync<string?>("allworkFiles.readBase64", "ta-import-file");
            if (string.IsNullOrEmpty(base64))
            { _fileError = "Could not read file. Please re-select and try again."; return; }

            var bytes = Convert.FromBase64String(base64);

            var auth = await AuthState.GetAuthenticationStateAsync();
            var empIdStr = auth.User.FindFirstValue("employment_id")
                        ?? auth.User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
            Guid.TryParse(empIdStr, out var importedBy);
            var importedByName = auth.User.GetDisplayName();

            using var ms = new MemoryStream(bytes);
            _result     = await ImportService.ImportAsync(
                ms, importedBy, importedByName, _fileName ?? "(unknown).csv", SessionState.SelectedLegalEntityId);
            _importedAt = TemporalContext.GetOperativeNow();
            _step       = Step.Done;
            await LoadHistoryAsync();
        }
        catch (Exception ex) { _fileError = ex.Message; }
        finally { _importing = false; }
    }

    private async Task DownloadErrorsAsync()
    {
        if (_result is null || _result.Errors.Count == 0) return;

        var sb = new StringBuilder();
        sb.AppendLine("row_number,employee_number,reason");
        foreach (var e in _result.Errors)
        {
            var escapedReason = e.Reason.Replace("\"", "\"\"");
            sb.AppendLine($"{e.RowNumber},{e.EmployeeNumber},\"{escapedReason}\"");
        }

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        await JS.InvokeVoidAsync("allworkFiles.downloadBase64", "ta-import-errors.csv", "text/csv", base64);
    }

    private void Reset()
    {
        _step         = Step.Upload;
        _fileInputKey++;
        _fileSelected = false;
        _result       = null;
        _fileError    = null;
        _fileName     = null;
        _importedAt   = null;
    }
}

<style>
    .stat-card--imported { border-top: 3px solid #16a34a; }
    .stat-card--failed   { border-top: 3px solid #dc2626; }

    .import-provenance {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1.25rem;
        padding: .5rem .875rem;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        font-size: .8125rem;
        color: #4b5563;
    }

    .import-provenance__file {
        font-weight: 600;
        color: #111827;
        font-family: monospace;
    }

    .import-provenance__sep {
        color: #9ca3af;
    }

    .import-provenance__time {
        color: #6b7280;
    }

    .csv-ref {
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        overflow: hidden;
        font-size: .8125rem;
    }

    .csv-ref-header {
        display: flex;
        gap: .5rem;
        padding: .4rem .75rem;
        background: #f3f4f6;
        font-weight: 600;
        border-bottom: 1px solid #e5e7eb;
        color: #374151;
    }

    .csv-ref-row {
        display: flex;
        gap: .5rem;
        padding: .4rem .75rem;
        border-bottom: 1px solid #f3f4f6;
    }

    .csv-ref-row:last-child { border-bottom: none; }

    .csv-ref-row--alt { background: #f9fafb; }

    .csv-ref-row span:first-child  { width: 22%; }
    .csv-ref-row span:nth-child(2) { width: 15%; }
    .csv-ref-header span:first-child  { width: 22%; }
    .csv-ref-header span:nth-child(2) { width: 15%; }
</style>
