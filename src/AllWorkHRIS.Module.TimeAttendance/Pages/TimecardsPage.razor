@page "/ta/timecards"
@layout TimeAttendanceShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "TimeViewer,TimeAdmin,Manager")]
@using Microsoft.AspNetCore.Authorization
@using AllWorkHRIS.Module.TimeAttendance.Commands
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@inject IHrisSessionState           SessionState
@inject TimeAttendanceQueryService  QueryService
@inject ITimeEntryService           TimeEntryService

<PageTitle>Timecards — AllWork HRIS</PageTitle>

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">Timecards</h2>
    </div>

    @* ── View toggle + Period selector ───────────────────────────────── *@
    <div class="filter-row" style="margin-bottom:var(--space-5,1.25rem);">
        <div class="segmented-toggle">
            <button class="seg-btn @(_viewMode == "ACTIVE" ? "seg-btn--active" : "")"
                    @onclick='() => OnViewModeChanged("ACTIVE")'>Active</button>
            <button class="seg-btn @(_viewMode == "HISTORICAL" ? "seg-btn--active" : "")"
                    @onclick='() => OnViewModeChanged("HISTORICAL")'>Historical</button>
        </div>
        <label class="filter-label" style="margin-left:1rem;">Period</label>
        <SfDropDownList TValue="Guid" TItem="TaPeriodOption" DataSource="@_periods"
                        Value="@_selectedPeriodId" Placeholder="— select period —"
                        Width="320px">
            <DropDownListFieldSettings Value="PeriodId" Text="Label" />
            <DropDownListEvents TValue="Guid" TItem="TaPeriodOption"
                                ValueChange="OnPeriodChangedSf" />
        </SfDropDownList>
        @if (_viewMode == "HISTORICAL" && _periods.Count == 0 && !_loadingPeriods)
        {
            <span style="font-size:.85rem;color:#6b7280;margin-left:.75rem;">No closed periods yet.</span>
        }
    </div>

    @if (_selectedPeriodId == Guid.Empty)
    {
        <div class="empty-state">Select a period to view timecards.</div>
    }
    else if (_loading)
    {
        <div class="empty-state">Loading…</div>
    }
    else
    {
        @* ── Stat cards ───────────────────────────────────────────────── *@
        <div class="stat-cards" style="margin-bottom:var(--space-5,1.25rem);">
            <div class="stat-card stat-card--ta">
                <span class="stat-label">Pending Approval</span>
                <span class="stat-value">@_pendingApproval</span>
            </div>
            <div class="stat-card stat-card--warn">
                <span class="stat-label">Overtime Alerts</span>
                <span class="stat-value @(_overtimeAlerts > 0 ? "stat-value--warn" : "")">@_overtimeAlerts</span>
            </div>
            <div class="stat-card stat-card--warn">
                <span class="stat-label">Unapproved at Cutoff Risk</span>
                <span class="stat-value @(_cutoffRisk > 0 ? "stat-value--warn" : "")">@_cutoffRisk</span>
            </div>
        </div>

        @* ── Approve by exception (Phase 12.7b) ───────────────────────── *@
        @if (_review is not null
             && (_review.CleanEntryIds.Count > 0 || _review.Anomalies.Count > 0 || _review.MissingEmployees.Count > 0))
        {
            <div class="card exception-panel" style="margin-bottom:var(--space-5,1.25rem);padding:1rem 1.25rem;">
                <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                    <strong>Approve by exception</strong>
                    <span class="badge badge--success">@_review.CleanEntryIds.Count clean</span>
                    <span class="badge badge--warning">@_review.Anomalies.Count to review</span>
                    <span class="badge badge--neutral">@_review.MissingEmployees.Count missing timecard@(_review.MissingEmployees.Count == 1 ? "" : "s")</span>
                    <button class="btn-sm btn-primary" disabled="@(_review.CleanEntryIds.Count == 0)" @onclick="ApproveCleanAsync">
                        Approve @_review.CleanEntryIds.Count clean
                    </button>
                    @if (_review.Anomalies.Count > 0 || _review.MissingEmployees.Count > 0)
                    {
                        <button class="btn-sm btn-secondary" @onclick="() => _showExceptions = !_showExceptions">
                            @(_showExceptions ? "Hide" : "Show") exceptions
                        </button>
                    }
                </div>
                <div style="margin-top:.5rem;font-size:.8rem;color:#9ca3af;">
                    @(_otThreshold.HasValue
                        ? $"Overtime is flagged for review when an employee's period OT reaches {_otThreshold.Value:0.##} hrs (the trigger)."
                        : "Overtime is not flagged on hours for this pay group (routine OT auto-approves).")
                    Set this on the pay calendar (Payroll → Pay Calendars → this context → OT Review Threshold).
                </div>

                @if (_showExceptions)
                {
                    @if (_review.Anomalies.Count > 0)
                    {
                        <div style="margin-top:.9rem;">
                            <div class="exception-subhead">Entries to review</div>
                            <table class="exception-table">
                                <thead><tr><th>Employee</th><th>Work Date</th><th>Category</th><th class="num">Hours</th><th>Why</th></tr></thead>
                                <tbody>
                                    @foreach (var a in _review.Anomalies)
                                    {
                                        <tr>
                                            <td>@a.EmployeeName <span class="exc-emp-num">#@a.EmployeeNumber</span></td>
                                            <td>@a.WorkDate.ToString("MMM d, yyyy")</td>
                                            <td><span class="badge badge--category">@a.TimeCategoryCode</span></td>
                                            <td class="num">@a.Duration.ToString("0.##")</td>
                                            <td><span class="badge badge--warning">@a.Reason</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (_review.MissingEmployees.Count > 0)
                    {
                        <div style="margin-top:.9rem;">
                            <div class="exception-subhead">Active non-exempt employees with no timecard this period</div>
                            <ul class="exception-missing">
                                @foreach (var m in _review.MissingEmployees)
                                {
                                    <li>@m.EmployeeName <span class="exc-emp-num">#@m.EmployeeNumber</span></li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        }

        @* ── Grid ─────────────────────────────────────────────────────── *@
        @if (_rows.Count == 0)
        {
            <div class="empty-state">No time entries found for this period.</div>
        }
        else
        {
            <SfGrid DataSource="@_rows" AllowSorting="true" CssClass="e-gridhover">
                <GridEvents TValue="TimecardSummaryRow"
                            DetailsExpanded="OnRowExpandedAsync"
                            DetailsCollapsed="OnRowCollapsed" />
                <GridColumns>
                    <GridColumn HeaderText="Employee">
                        <Template>
                            @{ var row = (TimecardSummaryRow)context; }
                            <div style="font-weight:500;">@row.EmployeeName</div>
                            <div style="font-size:.8rem;color:#9ca3af;">@row.EmployeeNumber</div>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Total Hrs" Width="110" CustomAttributes="@(new Dictionary<string,object>{{ "class","text-right" }})">
                        <Template>@{ var row = (TimecardSummaryRow)context; }@row.TotalHours.ToString("F2")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Regular" Width="110" CustomAttributes="@(new Dictionary<string,object>{{ "class","text-right" }})">
                        <Template>@{ var row = (TimecardSummaryRow)context; }@row.RegularHours.ToString("F2")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Overtime" Width="110" CustomAttributes="@(new Dictionary<string,object>{{ "class","text-right" }})">
                        <Template>
                            @{ var row = (TimecardSummaryRow)context; }
                            <span class="@(row.OvertimeHours > 0 ? "text-warn" : "")">@row.OvertimeHours.ToString("F2")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="160">
                        <Template>
                            @{ var row = (TimecardSummaryRow)context; }
                            <span class="status-badge status-@TimecardStatus(row).ToLower()">@TimecardStatus(row)</span>
                            @if (row.RejectedCount > 0)
                            {
                                <span class="rejected-count">@row.RejectedCount rejected</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="180" AllowSorting="false">
                        <Template>
                            @{ var row = (TimecardSummaryRow)context; }
                            @if (row.SubmittedCount > 0)
                            {
                                <button class="btn-sm btn-primary" @onclick="() => ApproveAllAsync(row)">
                                    Approve All (@row.SubmittedCount)
                                </button>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
                <GridTemplates><DetailTemplate Context="tcRow">
                    @{ var row = (TimecardSummaryRow)tcRow; }
                    <div class="detail-panel">
                        @if (_detailLoading && _detailEmploymentId == row.EmploymentId)
                        {
                            <div class="empty-state">Loading entries…</div>
                        }
                        else if (_detailCache.TryGetValue(row.EmploymentId, out var entries))
                        {
                            @if (entries.Count == 0)
                            {
                                <div class="empty-state" style="padding:1rem;">No entries.</div>
                            }
                            else
                            {
                                <SfGrid TValue="TimeEntryRow" DataSource="@entries.ToList()" CssClass="e-gridhover" AllowSorting="true">
                                    <GridColumns>
                                        <GridColumn HeaderText="Date" Width="130">
                                            <Template>@{ var entry = (TimeEntryRow)context; }@entry.WorkDate.ToString("ddd MMM d")</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Category" Width="120">
                                            <Template>@{ var entry = (TimeEntryRow)context; }<span class="cat-badge cat-@entry.TimeCategoryCode.ToLower()">@entry.TimeCategoryCode</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Hours" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var entry = (TimeEntryRow)context; }@entry.Duration.ToString("F2")</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Time" Width="130">
                                            <Template>@{ var entry = (TimeEntryRow)context; }<span style="font-size:.8rem;color:#6b7280;">@(entry.StartTime.HasValue ? $"{entry.StartTime:HH:mm}–{entry.EndTime:HH:mm}" : "—")</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Status" Width="120">
                                            <Template>@{ var entry = (TimeEntryRow)context; }<span class="status-badge status-@entry.StatusCode.ToLower()">@entry.StatusCode</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Notes">
                                            <Template>@{ var entry = (TimeEntryRow)context; }<span style="font-size:.8rem;color:#6b7280;">@(entry.RejectionReason ?? entry.Notes ?? "")</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Actions" Width="110" AllowSorting="false">
                                            <Template>
                                                @{ var entry = (TimeEntryRow)context; }
                                                @if (entry.StatusCode is "SUBMITTED" or "CORRECTED")
                                                {
                                                    <div style="display:flex;gap:.35rem;">
                                                        <button class="btn-sm btn-primary"
                                                                @onclick="() => ApproveEntryAsync(row.EmploymentId, entry.TimeEntryId)">✓</button>
                                                        <button class="btn-sm btn-danger"
                                                                @onclick="() => StartReject(entry.TimeEntryId)">✗</button>
                                                    </div>
                                                }
                                            </Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>

                                @if (_rejectEntryId is not null && entries.Any(e => e.TimeEntryId == _rejectEntryId))
                                {
                                    <div style="display:flex;gap:.5rem;align-items:center;padding:.5rem .75rem;background:#fff7ed;border:1px solid #fed7aa;border-top:none;border-radius:0 0 6px 6px;margin-top:-1px;">
                                        <SfTextBox @bind-Value="_rejectReason"
                                                   Placeholder="Rejection reason (required)"
                                                   CssClass="flex-1" />
                                        <button class="btn-sm btn-danger" @onclick="ConfirmRejectAsync"
                                                disabled="@string.IsNullOrWhiteSpace(_rejectReason)">Reject</button>
                                        <button class="btn-sm btn-ghost" @onclick="CancelReject">Cancel</button>
                                    </div>
                                }

                                @if (row.OvertimeHours > 0)
                                {
                                    <div class="ot-summary">
                                        <span>OT this period:</span>
                                        <strong>@row.OvertimeHours.ToString("F2") hrs</strong>
                                    </div>
                                }
                            }
                        }
                    </div>
                </DetailTemplate></GridTemplates>
            </SfGrid>
        }

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div class="alert-error" style="margin-top:.75rem;">@_errorMsg</div>
        }
    }
</div>

@code {
    private string                     _viewMode         = "ACTIVE";
    private bool                       _loadingPeriods;
    private Guid                       _selectedPeriodId = Guid.Empty;
    private List<TaPeriodOption>       _periods          = [];
    private List<TimecardSummaryRow>   _rows             = [];
    private bool                       _loading;
    private int                        _pendingApproval, _overtimeAlerts, _cutoffRisk;

    // Phase 12.7b — approve-by-exception.
    private ExceptionReviewResult?     _review;
    private bool                       _showExceptions;
    private decimal?                   _otThreshold;       // active OT review threshold for the period's context (read-only here; set on the pay calendar)

    private Guid?                                    _detailEmploymentId;
    private List<TimeEntryRow>                       _detailEntries    = [];
    private bool                                     _detailLoading;
    private Dictionary<Guid, List<TimeEntryRow>>     _detailCache      = new();

    private Guid?                      _rejectEntryId;
    private string                     _rejectReason     = string.Empty;
    private string                     _errorMsg         = string.Empty;

    [Inject] private AuthenticationStateProvider AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var entityId = SessionState.SelectedLegalEntityId;
        if (entityId is null) return;

        await LoadPeriodsAsync(entityId.Value);
    }

    private async Task OnViewModeChanged(string mode)
    {
        if (_viewMode == mode) return;
        _viewMode           = mode;
        _selectedPeriodId   = Guid.Empty;
        _rows               = [];
        _detailEmploymentId = null;
        _detailEntries      = [];
        var entityId = SessionState.SelectedLegalEntityId;
        if (entityId is not null)
            await LoadPeriodsAsync(entityId.Value);
    }

    private async Task LoadPeriodsAsync(Guid entityId)
    {
        _loadingPeriods = true;
        StateHasChanged();
        try
        {
            _periods = _viewMode == "HISTORICAL"
                ? (await QueryService.GetClosedPeriodsForEntityAsync(entityId)).ToList()
                : (await QueryService.GetOpenPeriodsForEntityAsync(entityId)).ToList();

            if (_periods.Count > 0)
            {
                _selectedPeriodId = _periods[0].PeriodId;
                await LoadPeriodAsync();
            }
        }
        finally { _loadingPeriods = false; }
    }

    private async Task OnPeriodChangedSf(ChangeEventArgs<Guid, TaPeriodOption> args)
    {
        _selectedPeriodId   = args.Value;
        _detailEmploymentId = null;
        _detailEntries      = [];
        await LoadPeriodAsync();
    }

    private async Task LoadPeriodAsync()
    {
        var entityId = SessionState.SelectedLegalEntityId;
        if (entityId is null || _selectedPeriodId == Guid.Empty) return;

        _loading     = true;
        _errorMsg    = string.Empty;
        _detailCache = new();
        StateHasChanged();

        try
        {
            _rows = (await QueryService.GetTimecardSummariesAsync(entityId.Value, _selectedPeriodId)).ToList();
            (_pendingApproval, _overtimeAlerts, _cutoffRisk) =
                await QueryService.GetStatCardsAsync(entityId.Value, _selectedPeriodId);
            _review      = await QueryService.GetExceptionReviewAsync(entityId.Value, _selectedPeriodId);
            _otThreshold = await QueryService.GetOtReviewThresholdAsync(_selectedPeriodId);
        }
        finally
        {
            _loading = false;
        }
    }

    // Phase 12.7b — auto-approve the clean SUBMITTED entries; anomalies + missing timecards stay
    // for manual handling.
    private async Task ApproveCleanAsync()
    {
        if (_review is null || _review.CleanEntryIds.Count == 0) return;
        var authState = await AuthState.GetAuthenticationStateAsync();
        var actorId   = GetActorId(authState);
        try { await TimeEntryService.ApproveTimeEntriesAsync(_review.CleanEntryIds, actorId); }
        catch (Exception ex) { _errorMsg = ex.Message; }
        await LoadPeriodAsync();
    }

    private async Task OnRowExpandedAsync(DetailsExpandedEventArgs<TimecardSummaryRow> args)
    {
        if (args.Data is null) return;
        var empId = args.Data.EmploymentId;
        _detailEmploymentId = empId;
        _rejectEntryId      = null;
        if (!_detailCache.ContainsKey(empId))
        {
            _detailLoading = true;
            StateHasChanged();
            try
            {
                _detailCache[empId] = (await QueryService.GetEntriesForEmploymentAsync(
                    empId, _selectedPeriodId)).ToList();
            }
            finally { _detailLoading = false; }
        }
    }

    private void OnRowCollapsed(DetailsCollapsedEventArgs<TimecardSummaryRow> args)
    {
        if (args.Data is not null && _detailEmploymentId == args.Data.EmploymentId)
            _detailEmploymentId = null;
    }

    private async Task ApproveEntryAsync(Guid employmentId, Guid timeEntryId)
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var actorId   = GetActorId(authState);

        try
        {
            await TimeEntryService.ApproveTimeEntryAsync(
                new ApproveTimeEntryCommand { TimeEntryId = timeEntryId, ApprovedBy = actorId });
            await RefreshDetailAsync(employmentId);
            await LoadPeriodAsync();
        }
        catch (Exception ex) { _errorMsg = ex.Message; }
    }

    private async Task ApproveAllAsync(TimecardSummaryRow row)
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var actorId   = GetActorId(authState);

        var entries = await QueryService.GetEntriesForEmploymentAsync(row.EmploymentId, _selectedPeriodId);
        var ids = entries.Where(e => e.StatusCode is "SUBMITTED" or "CORRECTED")
                         .Select(e => e.TimeEntryId).ToList();
        try
        {
            // Phase 12.7b — one batch transaction instead of a per-entry approval loop.
            await TimeEntryService.ApproveTimeEntriesAsync(ids, actorId);
        }
        catch (Exception ex) { _errorMsg = ex.Message; }

        await RefreshDetailAsync(row.EmploymentId);
        await LoadPeriodAsync();
    }

    private void StartReject(Guid entryId)
    {
        _rejectEntryId = entryId;
        _rejectReason  = string.Empty;
    }

    private void CancelReject() { _rejectEntryId = null; _rejectReason = string.Empty; }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectEntryId is null || string.IsNullOrWhiteSpace(_rejectReason)) return;

        var authState = await AuthState.GetAuthenticationStateAsync();
        var actorId   = GetActorId(authState);

        try
        {
            await TimeEntryService.RejectTimeEntryAsync(new RejectTimeEntryCommand
            {
                TimeEntryId = _rejectEntryId.Value,
                RejectedBy  = actorId,
                Reason      = _rejectReason
            });
            _rejectEntryId = null;
            _rejectReason  = string.Empty;
            if (_detailEmploymentId.HasValue)
                await RefreshDetailAsync(_detailEmploymentId.Value);
            await LoadPeriodAsync();
        }
        catch (Exception ex) { _errorMsg = ex.Message; }
    }

    private async Task RefreshDetailAsync(Guid employmentId)
    {
        var entries = (await QueryService.GetEntriesForEmploymentAsync(
            employmentId, _selectedPeriodId)).ToList();
        _detailEntries          = entries;
        _detailCache[employmentId] = entries;
    }

    private static string TimecardStatus(TimecardSummaryRow row)
    {
        if (row.SubmittedCount > 0) return "PENDING";
        if (row.LockedCount > 0) return "LOCKED";   // handed off to payroll (run released)
        if (row.ApprovedCount > 0 && row.RejectedCount == 0) return "APPROVED";
        if (row.RejectedCount > 0) return "REJECTED";
        return "DRAFT";
    }

    private static Guid GetActorId(Microsoft.AspNetCore.Components.Authorization.AuthenticationState state)
    {
        var sub = state.User.FindFirst("sub")?.Value
               ?? state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(sub, out var g) ? g : Guid.Empty;
    }
}

<style>
    .detail-panel { padding: .75rem 1rem; border-top: 1px solid #e5e7eb; }
    .row-selected > td { background: #f5f3ff; }
    .text-right  { text-align: right; }
    .text-warn   { color: #d97706; font-weight: 600; }
    .stat-value--warn { color: #d97706; }

    .status-badge { padding:2px 8px;border-radius:999px;font-size:.75rem;font-weight:600; }
    .status-pending  { background:#fef9c3;color:#713f12; }
    .status-approved { background:#dcfce7;color:#14532d; }
    .status-rejected { background:#fee2e2;color:#7f1d1d; }
    .status-draft    { background:#f3f4f6;color:#6b7280; }
    .status-submitted { background:#dbeafe;color:#1e3a8a; }
    .status-locked   { background:#e0e7ff;color:#3730a3; }

    .cat-badge { padding:1px 6px;border-radius:4px;font-size:.75rem;font-weight:500;background:#f3f4f6;color:#374151; }
    .cat-overtime { background:#fef3c7;color:#92400e; }

    .ot-summary { display:flex;gap:.5rem;align-items:center;padding:.5rem 1rem;font-size:.85rem;color:#92400e;background:#fef3c7;border-radius:6px;margin-top:.5rem; }

.btn-sm { padding:2px 10px;font-size:.8rem;border-radius:4px;cursor:pointer;border:1px solid transparent; }
    .btn-primary { background:var(--aw-blue,#2563eb);color:#fff;border-color:var(--aw-blue,#2563eb); }
    .btn-danger  { background:#ef4444;color:#fff;border-color:#ef4444; }
    .btn-ghost   { background:#f3f4f6;color:#374151;border-color:#e5e7eb; }
    .btn-link    { background:none;border:none;color:var(--aw-blue,#2563eb);cursor:pointer;font-size:.85rem;padding:0; }

    .alert-error { background:#fee2e2;color:#7f1d1d;padding:.75rem 1rem;border-radius:6px;font-size:.875rem; }

    .rejected-count { display:inline-block;margin-left:.35rem;padding:1px 6px;border-radius:999px;font-size:.7rem;font-weight:600;background:#fee2e2;color:#991b1b; }

    .segmented-toggle { display:inline-flex;border:1px solid #e5e7eb;border-radius:6px;overflow:hidden; }
    .seg-btn { padding:.3rem .9rem;font-size:.85rem;font-weight:500;border:none;background:#fff;color:#374151;cursor:pointer;transition:background .1s,color .1s; }
    .seg-btn:not(:last-child) { border-right:1px solid #e5e7eb; }
    .seg-btn--active { background:#2563eb;color:#fff; }
    .seg-btn:not(.seg-btn--active):hover { background:#f3f4f6; }

    /* Phase 12.7b — approve-by-exception panel */
    .exception-panel .badge { font-size:.72rem;padding:.12rem .45rem;border-radius:4px; }
    .badge--success  { background:#d1fae5;color:#065f46;border:1px solid #6ee7b7; }
    .badge--warning  { background:#fef3c7;color:#92400e;border:1px solid #fde68a; }
    .badge--neutral  { background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb; }
    .badge--category { background:#f3f4f6;color:#374151;border:1px solid #e5e7eb;font-weight:500; }
    .exception-subhead { font-size:.8rem;font-weight:600;color:#6b7280;margin-bottom:.35rem;text-transform:uppercase;letter-spacing:.03em; }
    .exception-table { width:100%;border-collapse:collapse;font-size:.8125rem; }
    .exception-table th { text-align:left;padding:.35rem .6rem;border-bottom:1px solid #e5e7eb;color:#6b7280;font-weight:600; }
    .exception-table td { padding:.35rem .6rem;border-bottom:1px solid #f3f4f6; }
    .exception-table .num { text-align:right; }
    .exception-missing { margin:.25rem 0 0;padding-left:1.1rem;font-size:.8125rem;color:#374151;columns:2; }
    .exc-emp-num { font-size:.75rem;color:#9ca3af;margin-left:.2rem; }
</style>
