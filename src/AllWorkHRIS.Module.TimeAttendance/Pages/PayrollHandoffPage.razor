@page "/ta/handoff"
@layout TimeAttendanceShell
@rendermode InteractiveServer
@attribute [Authorize(Roles = "TimeAdmin")]
@using Microsoft.AspNetCore.Authorization
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids
@inject IHrisSessionState          SessionState
@inject TimeAttendanceQueryService QueryService
@inject IPayrollHandoffService     HandoffService

<PageTitle>Payroll Handoff — AllWork HRIS</PageTitle>

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">Payroll Handoff</h2>
    </div>

    <p style="color:#6b7280;font-size:.875rem;margin-bottom:var(--space-5,1.25rem);">
        Lock approved time entries and deliver them to the payroll pipeline.
        Once a period is handed off, its entries cannot be edited.
    </p>

    @if (_loading)
    {
        <div class="empty-state">Loading…</div>
    }
    else if (!_periods.Any())
    {
        <div class="empty-state">No periods available for handoff.</div>
    }
    else
    {
        @* ── Handoff results (shown outside grid so always visible) ── *@
        @foreach (var kvp in _handoffResults)
        {
            var periodLabel = _periods.FirstOrDefault(p => p.PeriodId == kvp.Key)?.PeriodLabel ?? "Period";
            <div class="alert @(kvp.Value.IsError ? "alert--error" : "alert--success")"
                 style="margin-bottom:.5rem;">
                <strong>@periodLabel</strong> —
                @if (kvp.Value.IsError) { <span>Handoff failed: </span> } else { <span>Handoff complete — </span> }
                @kvp.Value.Message
            </div>
        }

        @* ── Context filter (only shown when there is more than one) ── *@
        @if (_contextFilterOptions.Count > 2)  @* > 2 because the list always has "(All contexts)" + at least one real entry *@
        {
            <div class="filter-row" style="margin-bottom:1rem;display:flex;align-items:center;gap:.75rem;">
                <label class="filter-label">Payroll Context</label>
                <SfDropDownList TValue="Guid" TItem="ContextFilterItem"
                                DataSource="@_contextFilterOptions"
                                @bind-Value="_filterContextId"
                                Width="270px">
                    <DropDownListFieldSettings Value="Id" Text="Name" />
                    <DropDownListEvents TValue="Guid" TItem="ContextFilterItem"
                                        ValueChange="OnFilterContextChangedAsync" />
                </SfDropDownList>
            </div>
        }

        <div class="card">
            <SfGrid DataSource="@_filteredPeriods" AllowSorting="true" CssClass="e-gridhover">
                <GridEvents TValue="HandoffPeriodRow" DetailsExpanded="OnRowExpandedAsync" />
                <GridColumns>
                    <GridColumn HeaderText="Period">
                        <Template>@{ var row = (HandoffPeriodRow)context; }<strong>@row.PeriodLabel</strong></Template>
                    </GridColumn>
                    <GridColumn HeaderText="Pay Date" Width="140">
                        <Template>@{ var row = (HandoffPeriodRow)context; }@row.PayDate.ToString("MMM d, yyyy")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Approved" Width="100" CustomAttributes="@(new Dictionary<string,object>{{"class","text-right"}})">
                        <Template>@{ var row = (HandoffPeriodRow)context; }@row.ApprovedEntries</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Locked" Width="90" CustomAttributes="@(new Dictionary<string,object>{{"class","text-right"}})">
                        <Template>@{ var row = (HandoffPeriodRow)context; }@row.LockedEntries</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Total Hours" Width="110" CustomAttributes="@(new Dictionary<string,object>{{"class","text-right"}})">
                        <Template>@{ var row = (HandoffPeriodRow)context; }@row.TotalHours.ToString("0.##")</Template>
                    </GridColumn>
                    <GridColumn HeaderText="Status" Width="200">
                        <Template>
                            @{ var row = (HandoffPeriodRow)context;
                               var isDone    = _completedPeriods.Contains(row.PeriodId);
                               var isRunning = _runningPeriodId == row.PeriodId; }
                            @if (isDone)
                            {
                                <span class="badge badge--success">Handed Off</span>
                            }
                            else if (isRunning)
                            {
                                <span class="badge badge--info">Processing…</span>
                            }
                            else if (row.LockedEntries > 0 && row.ApprovedEntries == 0)
                            {
                                <span class="badge badge--success">Complete</span>
                            }
                            else if (row.ApprovedEntries > 0)
                            {
                                <span class="badge badge--warning">Pending (@row.ApprovedEntries ready)</span>
                            }
                            else
                            {
                                <span class="badge badge--neutral">No approved entries</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="First Locked" Width="180">
                        <Template>
                            @{ var row = (HandoffPeriodRow)context; }
                            <span style="font-size:.8rem;color:#6b7280;">
                                @(row.FirstLockAt.HasValue
                                    ? row.FirstLockAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                    : "—")
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="220" AllowSorting="false">
                        <Template>
                            @{ var row = (HandoffPeriodRow)context;
                               var isDone    = _completedPeriods.Contains(row.PeriodId);
                               var isRunning = _runningPeriodId == row.PeriodId; }
                            @if (isRunning)
                            {
                                <div class="handoff-progress">
                                    <div class="handoff-progress__bar" style="width:@(_progressPct)%;"></div>
                                </div>
                            }
                            else if (!isDone && row.ApprovedEntries > 0)
                            {
                                <span style="display:flex;gap:.4rem;align-items:center;">
                                    @if (_confirmHandoffId == row.PeriodId)
                                    {
                                        <button class="btn btn--primary btn--sm"
                                                @onclick="() => RunHandoffAsync(row.PeriodId, (int)row.ApprovedEntries)">
                                            Confirm
                                        </button>
                                        <button class="btn btn--ghost btn--sm"
                                                @onclick="() => _confirmHandoffId = null">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn--secondary btn--sm"
                                                @onclick="() => _confirmHandoffId = row.PeriodId">
                                            Run Handoff
                                        </button>
                                    }
                                </span>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
                <GridTemplates><DetailTemplate Context="periodCtx">
                    @{ var row = (HandoffPeriodRow)periodCtx; }
                    @if (_previewCache.TryGetValue(row.PeriodId, out var entries))
                    {
                        @if (!entries.Any())
                        {
                            <p class="preview-empty">No approved entries found.</p>
                        }
                        else
                        {
                            <div style="max-width:720px;">
                                <SfGrid TValue="HandoffPreviewEntry" DataSource="@entries.ToList()" CssClass="e-gridhover" AllowSorting="true">
                                    <GridColumns>
                                        <GridColumn HeaderText="Employee" Width="220">
                                            <Template>
                                                @{ var e = (HandoffPreviewEntry)context; }
                                                @e.EmployeeName <span class="preview-emp-num">#@e.EmployeeNumber</span>
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Work Date" Width="130">
                                            <Template>@{ var e = (HandoffPreviewEntry)context; }@e.WorkDate.ToString("MMM d, yyyy")</Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Category" Width="120">
                                            <Template>@{ var e = (HandoffPreviewEntry)context; }<span class="badge badge--category">@e.TimeCategory</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Status" Width="110">
                                            <Template>@{ var e = (HandoffPreviewEntry)context; }<span class="badge badge--entry-status badge--entry-@e.StatusCode.ToLower()">@e.StatusCode</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Hours" Field="Duration" TextAlign="TextAlign.Right" Width="80">
                                            <Template>@{ var e = (HandoffPreviewEntry)context; }@e.Duration.ToString("0.##")</Template>
                                        </GridColumn>
                                    </GridColumns>
                                    <GridAggregates>
                                        <GridAggregate>
                                            <GridAggregateColumns>
                                                <GridAggregateColumn Field="Duration" Type="AggregateType.Sum">
                                                    <FooterTemplate>@{ var a = (AggregateTemplateContext)context; }<strong>@Convert.ToDecimal(a.Sum).ToString("0.##")</strong></FooterTemplate>
                                                </GridAggregateColumn>
                                            </GridAggregateColumns>
                                        </GridAggregate>
                                    </GridAggregates>
                                </SfGrid>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="preview-empty">Loading…</p>
                    }
                </DetailTemplate></GridTemplates>
            </SfGrid>
        </div>
    }

</div>

@code {

    private List<HandoffPeriodRow> _periods         = [];
    private List<HandoffPeriodRow> _filteredPeriods = []; // stable field — don't bind grid to a per-render .ToList()
    private bool _loading = true;

    // Context filter: Guid.Empty sentinel = "(All contexts)".
    private Guid                      _filterContextId       = Guid.Empty;
    private List<ContextFilterItem>   _contextFilterOptions  = [];

    private sealed record ContextFilterItem(Guid Id, string Name);

    private Guid? _confirmHandoffId;
    private Guid? _runningPeriodId;
    private int   _progressPct;

    private readonly HashSet<Guid>                                        _completedPeriods = [];
    private readonly Dictionary<Guid, HandoffResultMsg>                  _handoffResults   = new();
    private readonly Dictionary<Guid, IReadOnlyList<HandoffPreviewEntry>> _previewCache    = new();

    private sealed record HandoffResultMsg(bool IsError, string Message);

    protected override async Task OnInitializedAsync()
    {
        var entityId = SessionState.SelectedLegalEntityId;
        if (entityId.HasValue)
            await LoadAsync(entityId.Value);

        _loading = false;
    }

    private async Task LoadAsync(Guid entityId)
    {
        _periods = (await QueryService.GetHandoffSummariesAsync(entityId)).ToList();

        // Build the context filter options from whatever the query returned.
        _contextFilterOptions = _periods
            .Select(p => new ContextFilterItem(p.PayrollContextId, p.PayrollContextName))
            .DistinctBy(c => c.Id)
            .OrderBy(c => c.Name)
            .Prepend(new ContextFilterItem(Guid.Empty, "(All contexts)"))
            .ToList();

        // If the previously-selected context is no longer present, fall back to All.
        if (_filterContextId != Guid.Empty
            && !_contextFilterOptions.Any(c => c.Id == _filterContextId))
        {
            _filterContextId = Guid.Empty;
        }

        ApplyContextFilter();
    }

    private void ApplyContextFilter()
    {
        _filteredPeriods = _filterContextId == Guid.Empty
            ? _periods.ToList()
            : _periods.Where(p => p.PayrollContextId == _filterContextId).ToList();
    }

    private Task OnFilterContextChangedAsync(ChangeEventArgs<Guid, ContextFilterItem> args)
    {
        _filterContextId = args.Value;
        ApplyContextFilter();
        return Task.CompletedTask;
    }

    private async Task OnRowExpandedAsync(DetailsExpandedEventArgs<HandoffPeriodRow> args)
    {
        if (args.Data is null) return;
        var periodId = args.Data.PeriodId;
        if (!_previewCache.ContainsKey(periodId))
        {
            _previewCache[periodId] = await QueryService.GetEntriesForPeriodAsync(periodId);
            StateHasChanged();
        }
    }

    private async Task RunHandoffAsync(Guid periodId, int approvedCount)
    {
        _confirmHandoffId = null;
        _runningPeriodId  = periodId;
        _progressPct      = 0;
        _handoffResults.Remove(periodId);
        StateHasChanged();

        try
        {
            var progressStep = Math.Max(4, approvedCount > 0 ? 80 / approvedCount : 80);

            var progressTask = Task.Run(async () =>
            {
                while (_progressPct < 80)
                {
                    await Task.Delay(200);
                    _progressPct = Math.Min(_progressPct + progressStep, 80);
                    await InvokeAsync(StateHasChanged);
                }
            });

            var payrollRunId = Guid.NewGuid();
            var result = await HandoffService.ExecuteHandoffAsync(periodId, payrollRunId);

            await progressTask.WaitAsync(TimeSpan.FromSeconds(5));
            _progressPct = 100;
            StateHasChanged();

            await Task.Delay(600);

            _completedPeriods.Add(periodId);
            _handoffResults[periodId] = new HandoffResultMsg(
                IsError: result.Failed > 0,
                Message: result.Failed == 0
                    ? $"{result.Delivered} entries locked, {result.TotalHours:0.##} hours delivered."
                    : $"{result.Delivered} delivered, {result.Failed} failed.");
        }
        catch (Exception ex)
        {
            _handoffResults[periodId] = new HandoffResultMsg(true, ex.Message);
        }
        finally
        {
            _runningPeriodId = null;
            _progressPct     = 0;

            var entityId = SessionState.SelectedLegalEntityId;
            if (entityId.HasValue)
                await LoadAsync(entityId.Value);

            StateHasChanged();
        }
    }
}

<style>
    .handoff-progress {
        width: 100%;
        height: 8px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    .handoff-progress__bar {
        height: 100%;
        background: var(--module-ta, #7c3aed);
        border-radius: 999px;
        transition: width .2s ease;
    }

    .handoff-result-row td {
        padding: .25rem 1rem .75rem;
        border-top: none;
    }

    .badge--warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge--locked {
        background: #ede9fe;
        color: #5b21b6;
        border: 1px solid #c4b5fd;
    }

    .preview-row td {
        padding: 0;
        border-top: none;
        background: #faf5ff;
    }

    .preview-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .8125rem;
        margin: 0;
    }

    .preview-table th {
        padding: .4rem 1rem;
        background: #ede9fe;
        color: #5b21b6;
        font-weight: 600;
        text-align: left;
        border-bottom: 1px solid #c4b5fd;
    }

    .preview-table td {
        padding: .35rem 1rem;
        border-bottom: 1px solid #f3f0ff;
    }

    .preview-table tfoot td {
        border-top: 2px solid #c4b5fd;
        border-bottom: none;
        background: #ede9fe;
        padding: .4rem 1rem;
    }

    .preview-emp-num {
        font-size: .75rem;
        color: #9ca3af;
        margin-left: .25rem;
    }

    .badge--category {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #e5e7eb;
        font-size: .7rem;
        padding: .1rem .4rem;
        border-radius: 4px;
        font-weight: 500;
    }

    .badge--entry-status {
        font-size: .7rem;
        padding: .1rem .4rem;
        border-radius: 4px;
        font-weight: 500;
    }
    .badge--entry-draft     { background: #f3f4f6; color: #6b7280; border: 1px solid #e5e7eb; }
    .badge--entry-submitted { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .badge--entry-approved  { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .badge--entry-locked    { background: #ede9fe; color: #5b21b6; border: 1px solid #c4b5fd; }
    .badge--entry-rejected  { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

    .preview-empty {
        padding: .75rem 1rem;
        color: #9ca3af;
        font-size: .8125rem;
        margin: 0;
    }
</style>
