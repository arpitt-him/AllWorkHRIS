@page "/about"
@rendermode InteractiveServer
@using System.Reflection
@using AllWorkHRIS.Core.Composition
@using AllWorkHRIS.Core.Data
@using AllWorkHRIS.Core.Temporal
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject IReadOnlyList<IPlatformModule> Modules
@inject ITemporalOverrideService TemporalOverride
@inject IConnectionFactory ConnectionFactory
@inject IWebHostEnvironment Env

<PageTitle>System Settings — AllWork HRIS</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">System Settings</h1>
        <p class="page-subtitle">AllWork HRIS Platform — loaded modules and version information.</p>
    </div>
</div>

<div class="about-section">
    <h2 class="section-title">Platform</h2>
    <table class="about-table">
        <tbody>
            <tr>
                <th>Application</th>
                <td>AllWork HRIS</td>
            </tr>
            <tr>
                <th>Version</th>
                <td>@AppVersion()</td>
            </tr>
            <tr>
                <th>Runtime</th>
                <td>.NET @System.Environment.Version.ToString(3)</td>
            </tr>
            <tr>
                <th>Environment</th>
                <td>@(System.Environment.GetEnvironmentVariable("APP_ENVIRONMENT") ?? "development")</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="about-section">
    <h2 class="section-title">Loaded Modules</h2>

    @if (Modules.Count == 0)
    {
        <p class="empty-state">No plug-in modules are loaded. Check the <code>MODULES_PATH</code> environment variable.</p>
    }
    else
    {
        <table class="about-table modules-table">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>Version</th>
                    <th>Description</th>
                    <th class="module-menu-head">Menu Items</th>
                    @* Spacer absorbs the leftover width so the table is full-width (its
                       separators align with Platform/Database) while the real columns
                       stay packed left — no orphaned trailing column. *@
                    <th class="module-spacer"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var module in Modules.OrderBy(m => m.ModuleName))
                {
                    <tr>
                        <td class="module-name">@module.ModuleName</td>
                        <td class="module-version">@module.ModuleVersion</td>
                        <td class="module-description">@(module.ModuleDescription ?? "—")</td>
                        <td class="module-menu-count">@module.GetMenuContributions().Count()</td>
                        <td class="module-spacer"></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="about-section">
    <h2 class="section-title">Database</h2>
    @{ var db = GetDbInfo(); }
    <table class="about-table">
        <tbody>
            <tr>
                <th>Provider</th>
                <td>@db.Provider</td>
            </tr>
            <tr>
                <th>Server</th>
                <td>@db.Server</td>
            </tr>
            <tr>
                <th>Database</th>
                <td>@db.Database</td>
            </tr>
        </tbody>
    </table>
    @if (!Env.IsProduction())
    {
        <p class="text-muted text-sm" style="margin-top:var(--space-2)">
            Confirm you're pointed at the intended database (e.g. <code>allworkhris_dev</code>) before running payroll.
        </p>
    }
</div>

@if (TemporalOverride.IsEnabled)
{
    <div class="about-section">
        <h2 class="section-title">Testing Tools</h2>
        <TemporalOverrideBar />
    </div>
}

@code {
    // Safe DB identity (provider/server/database, no credentials). Defensive in case
    // the connection string can't be parsed.
    private DatabaseInfo GetDbInfo()
    {
        try { return ConnectionFactory.GetDatabaseInfo(); }
        catch { return new DatabaseInfo("—", "—", "—"); }
    }

    // Product version from the host assembly's informational version (SemVer + git SHA,
    // e.g. "0.6.1+abc1234"); falls back to the numeric assembly version. See ADR-018.
    private static string AppVersion()
    {
        var asm  = System.Reflection.Assembly.GetExecutingAssembly();
        var info = asm.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        return string.IsNullOrWhiteSpace(info) ? (asm.GetName().Version?.ToString(3) ?? "—") : info;
    }
}

<style>
    .about-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.75rem;
    }

    .about-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    .about-table th,
    .about-table td {
        padding: 0.5rem 0.75rem;
        text-align: left;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
    }

    .about-table thead th {
        font-weight: 600;
        color: var(--color-text-secondary, #6b7280);
        background: var(--color-surface-alt, #f9fafb);
    }

    .about-table tbody th {
        font-weight: 500;
        color: var(--color-text-secondary, #6b7280);
        width: 12rem;
    }

    /* The three sections (Platform / Loaded Modules / Database) should read as one
       continuous table: each spans full width (inherited .about-table width:100%)
       with a shared 12rem first column. Pinning Module to 12rem aligns Version under
       the Platform/Database value columns; letting Description absorb the slack means
       Menu Items follows it cleanly instead of being stranded across an empty gap. */
    .modules-table th:first-child,
    .modules-table td:first-child {
        width: 12rem;
    }

    .module-spacer { width: 100%; }   /* absorbs slack on the right; keeps columns packed left */

    /* Keep descriptions on one line so the greedy spacer can't collapse the column
       to its longest word; the column sizes to the full text, spacer takes the rest. */
    .module-description { white-space: nowrap; }

    /* Menu Items is a count: right-align header + cells to match the numeric-column
       convention used in the SfGrids (a plain HTML table cell defaults to left).
       nowrap so the header stays on one line. */
    .module-menu-head,
    .module-menu-count { text-align: right; white-space: nowrap; }

    .module-name    { font-weight: 600; }
    .module-version { font-family: monospace; color: var(--color-text-secondary, #6b7280); }

    .empty-state {
        color: var(--color-text-secondary, #6b7280);
        font-style: italic;
    }
</style>
